---
import Layout from '../layouts/Layout.astro';
const title = "Study Destinations | CloudBridge Study Abroad";
const description = "Explore study destinations with CloudBridge — compare universities, costs, and visa pathways in the UK, Malaysia, and the USA.";
---
<Layout title={title} description={description}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / Study Destination</p>
    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">Choose Your Destination</h1>
    <p class="mt-4 max-w-xl text-white/75">Every country we work with, hand-picked for strong outcomes for Bangladeshi students.</p>
  </div>
</section>
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <a href="/dest-uk" class="nav-link group relative h-72 rounded-2xl overflow-hidden flex flex-col justify-end card-photo" style="background-image:linear-gradient(160deg,#2e4a7a,#4d70a8)">
      <div class="absolute inset-0 bg-gradient-to-t from-bridge-950/85 via-bridge-950/10 to-transparent"></div>
      <div class="relative p-5 text-white"><h3 class="font-display text-xl font-bold">United Kingdom</h3><p class="mt-1 text-sm text-white/75">Globally respected degrees and diverse study opportunities.</p></div>
    </a>
    <a href="/dest-malaysia" class="nav-link group relative h-72 rounded-2xl overflow-hidden flex flex-col justify-end card-photo" style="background-image:linear-gradient(160deg,#1e786e,#22a396)">
      <div class="absolute inset-0 bg-gradient-to-t from-bridge-950/85 via-bridge-950/10 to-transparent"></div>
      <div class="relative p-5 text-white"><h3 class="font-display text-xl font-bold">Malaysia</h3><p class="mt-1 text-sm text-white/75">English-medium education with affordable living costs.</p></div>
    </a>
    <a href="/dest-usa" class="nav-link group relative h-72 rounded-2xl overflow-hidden flex flex-col justify-end card-photo" style="background-image:linear-gradient(160deg,#963c3c,#c25a5a)">
      <div class="absolute inset-0 bg-gradient-to-t from-bridge-950/85 via-bridge-950/10 to-transparent"></div>
      <div class="relative p-5 text-white"><h3 class="font-display text-xl font-bold">USA</h3><p class="mt-1 text-sm text-white/75">Small classes, academic freedom, strong mentorship.</p></div>
    </a>
  </div>
</section>

</Layout>
