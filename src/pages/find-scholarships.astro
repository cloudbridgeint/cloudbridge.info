---
/* This article used to live here as well as at /blogs/find-scholarships, with
   both URLs self-canonicalising — so search engines saw two copies of the
   same page and had to split the ranking between them. The blog URL is now
   the single address; this one redirects permanently so any existing link,
   bookmark or search result still lands on the article and passes its
   standing over. */
export const prerender = false;
return Astro.redirect('/blogs/find-scholarships', 301);
---
