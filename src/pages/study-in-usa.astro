---
import BlogPost from "../layouts/BlogPost.astro";
import Layout from "../layouts/Layout.astro";
import { getBlogPostBySlug } from "../lib/content";
export const prerender = false;
const db = (Astro.locals as any).runtime.env.DB;
const post = await getBlogPostBySlug(db, "study-in-usa");
---
{post ? <BlogPost post={post} /> : (
  <Layout title="Article not found | CloudBridge" description="This article is no longer available.">
    <div class="max-w-container mx-auto px-4 md:px-8 py-24 text-center">
      <h1 class="text-2xl font-bold text-bridge-950">Article not found</h1>
      <p class="mt-2 text-ink/60">This article may have been unpublished or removed.</p>
      <a href="/blogs" class="btn-primary nav-link inline-flex mt-6">Browse all articles</a>
    </div>
  </Layout>
)}
