---
import AdminLayout from '../../layouts/AdminLayout.astro';
export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const { results } = await db.prepare(
  "SELECT * FROM leads WHERE message IS NOT NULL AND message != '' ORDER BY created_at DESC LIMIT 100"
).all();
const messages = results as any[];
---
<AdminLayout title="Messages" active="messages">
  <h1 class="text-2xl font-bold text-bridge-950 mb-1">Messages</h1>
  <p class="text-slate-500 text-sm mb-6">Messages submitted through the site's contact and inquiry forms.</p>

  <div class="space-y-3">
    {messages.length === 0 ? (
      <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-8 text-center">
        <p class="text-slate-400 text-sm">No messages yet — they'll show up here once someone submits a form on the site.</p>
      </div>
    ) : messages.map((m: any) => (
      <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-5">
        <div class="flex items-center justify-between">
          <div>
            <p class="font-semibold text-bridge-950 text-sm">{m.name || 'Anonymous'}</p>
            <p class="text-xs text-slate-400">{m.email} {m.phone ? `· ${m.phone}` : ''}</p>
          </div>
          <p class="text-xs text-slate-400 whitespace-nowrap">{m.created_at}</p>
        </div>
        <p class="text-sm text-slate-600 mt-3 leading-relaxed">{m.message}</p>
        <p class="text-xs text-slate-400 mt-3">via {m.source_page || 'website form'}</p>
      </div>
    ))}
  </div>
</AdminLayout>
