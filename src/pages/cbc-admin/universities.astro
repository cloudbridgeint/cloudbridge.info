---
import AdminLayout from '../../layouts/AdminLayout.astro';
export const prerender = false;
---
<AdminLayout title="Universities" active="universities">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">Featured Universities</h1>
      <p class="text-slate-500 mt-1 text-sm">Add, edit, or remove university/partner logos shown on the homepage, grouped by country.</p>
    </div>
    <button id="addBtn" class="bg-bridge-700 hover:bg-bridge-800 text-white text-sm font-semibold rounded-lg px-4 py-2.5 transition">+ Add University</button>
  </div>

  <div id="listContainer" class="mt-8 space-y-8"></div>

  <!-- Add/Edit modal -->
  <div id="modal" class="hidden fixed inset-0 bg-black/40 z-40 flex items-center justify-center px-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6">
      <h3 id="modalTitle" class="font-bold text-lg text-slate-900 mb-4">Add University</h3>
      <input type="hidden" id="editId">
      <div class="space-y-3">
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Country</label>
          <input id="fCountry" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" placeholder="e.g. UK">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">University name</label>
          <input id="fName" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Logo</label>
          <input type="file" id="fLogoFile" accept="image/*" class="w-full text-sm">
          <input type="hidden" id="fLogoUrl">
          <img id="fLogoPreview" class="hidden mt-2 h-16 object-contain border rounded-lg p-1">
        </div>
      </div>
      <div class="flex justify-end gap-2 mt-6">
        <button id="cancelBtn" class="px-4 py-2 text-sm rounded-lg border border-slate-300 text-slate-600 hover:bg-slate-50">Cancel</button>
        <button id="saveBtn" class="px-4 py-2 text-sm rounded-lg bg-bridge-700 hover:bg-bridge-800 text-white font-semibold">Save</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  let allUnis = [];

  async function load() {
    allUnis = await apiFetch('/api/universities');
    render();
  }

  function render() {
    const byCountry = {};
    for (const u of allUnis) (byCountry[u.country] ||= []).push(u);
    const container = document.getElementById('listContainer');
    container.innerHTML = '';
    for (const [country, unis] of Object.entries(byCountry)) {
      const section = document.createElement('div');
      section.className = 'bg-white rounded-2xl ring-1 ring-black/5 shadow-sm p-5';
      section.innerHTML = `
        <h2 class="font-semibold text-slate-900 mb-4">${country} <span class="text-slate-400 font-normal text-sm">(${unis.length})</span></h2>
        <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
          ${unis.map(u => `
            <div class="border border-slate-200 rounded-xl p-3 flex flex-col items-center gap-2">
              <div class="h-16 w-full flex items-center justify-center">
                <img src="${resolveLogo(u.logo_url)}" class="max-h-14 max-w-full object-contain">
              </div>
              <p class="text-xs font-medium text-slate-700 text-center line-clamp-2">${escapeHtml(u.name)}</p>
              <div class="flex gap-2">
                <button class="text-xs text-bridge-700 hover:underline" onclick="editUni(${u.id})">Edit</button>
                <button class="text-xs text-red-600 hover:underline" onclick="deleteUni(${u.id})">Delete</button>
              </div>
            </div>
          `).join('')}
        </div>
      `;
      container.appendChild(section);
    }
    if (allUnis.length === 0) {
      container.innerHTML = '<p class="text-slate-500 text-sm">No universities yet. Click "+ Add University" to get started.</p>';
    }
  }

  function resolveLogo(url) {
    if (!url) return '/assets/logo.png';
    if (url.startsWith('media:')) return `/api/media/${url.slice(6)}`;
    return url;
  }
  function escapeHtml(s) {
    const d = document.createElement('div'); d.textContent = s; return d.innerHTML;
  }

  window.editUni = (id) => {
    const u = allUnis.find(x => x.id === id);
    if (!u) return;
    document.getElementById('modalTitle').textContent = 'Edit University';
    document.getElementById('editId').value = u.id;
    document.getElementById('fCountry').value = u.country;
    document.getElementById('fName').value = u.name;
    document.getElementById('fLogoUrl').value = u.logo_url || '';
    const preview = document.getElementById('fLogoPreview');
    preview.src = resolveLogo(u.logo_url);
    preview.classList.remove('hidden');
    document.getElementById('modal').classList.remove('hidden');
  };

  window.deleteUni = async (id) => {
    if (!confirm('Delete this university logo?')) return;
    try {
      await apiFetch(`/api/universities/${id}`, { method: 'DELETE' });
      showToast('Deleted');
      load();
    } catch (e) { showToast(e.message, 'error'); }
  };

  document.getElementById('addBtn').addEventListener('click', () => {
    document.getElementById('modalTitle').textContent = 'Add University';
    document.getElementById('editId').value = '';
    document.getElementById('fCountry').value = '';
    document.getElementById('fName').value = '';
    document.getElementById('fLogoUrl').value = '';
    document.getElementById('fLogoFile').value = '';
    document.getElementById('fLogoPreview').classList.add('hidden');
    document.getElementById('modal').classList.remove('hidden');
  });
  document.getElementById('cancelBtn').addEventListener('click', () => {
    document.getElementById('modal').classList.add('hidden');
  });

  document.getElementById('fLogoFile').addEventListener('change', async (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const fd = new FormData();
    fd.append('file', file);
    try {
      const res = await fetch('/api/media', { method: 'POST', body: fd });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      document.getElementById('fLogoUrl').value = `media:${data.id}`;
      const preview = document.getElementById('fLogoPreview');
      preview.src = data.url;
      preview.classList.remove('hidden');
    } catch (err) { showToast(err.message, 'error'); }
  });

  document.getElementById('saveBtn').addEventListener('click', async () => {
    const id = document.getElementById('editId').value;
    const country = document.getElementById('fCountry').value.trim();
    const name = document.getElementById('fName').value.trim();
    const logo_url = document.getElementById('fLogoUrl').value.trim();
    if (!country || !name) { showToast('Country and name are required', 'error'); return; }
    try {
      if (id) {
        await apiFetch(`/api/universities/${id}`, { method: 'PUT', body: JSON.stringify({ country, name, logo_url }) });
      } else {
        await apiFetch('/api/universities', { method: 'POST', body: JSON.stringify({ country, name, logo_url }) });
      }
      showToast('Saved');
      document.getElementById('modal').classList.add('hidden');
      load();
    } catch (e) { showToast(e.message, 'error'); }
  });

  load();
</script>
