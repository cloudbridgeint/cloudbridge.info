---
import logo from '../../assets/logo.png';
import sideImage from '../../assets/hero/slide1.jpg';
export const prerender = false;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Login — CloudBridge Admin</title>
  <script src="https://cdn.tailwindcss.com" is:inline></script>
  <script is:inline>
    tailwind.config = { theme: { extend: { colors: {
      bridge: { 700:'#254368', 900:'#15263f', 950:'#0f1c30' },
      sunrise: { 600:'#aa1821' },
    } } } };
  </script>
  <style is:global>
    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    .btn-red-gradient { background-image: linear-gradient(90deg, #c0201f 0%, #aa1821 100%); }
    .btn-red-gradient:hover { filter: brightness(1.1); }
  </style>
</head>
<body class="min-h-screen flex bg-white">

  <!-- Left: image panel, no text overlay -->
  <div class="hidden lg:block lg:w-1/2 relative overflow-hidden">
    <img src={sideImage.src} alt="" class="absolute inset-0 w-full h-full object-cover">
    <div class="absolute inset-0" style="background:linear-gradient(135deg, rgba(15,28,48,0.15) 0%, rgba(15,28,48,0.35) 100%)"></div>
  </div>

  <!-- Right: login form panel -->
  <div class="w-full lg:w-1/2 flex items-center justify-center px-6 py-12">
    <div class="w-full max-w-sm">
      <div class="mb-10">
        <img src={logo.src} alt="CloudBridge" class="w-16 h-16 rounded-full object-cover shadow-md">
        <p class="mt-5 text-bridge-950 font-display font-extrabold text-2xl">Welcome back</p>
        <p class="text-slate-500 text-sm mt-1">Sign in to the CloudBridge admin panel</p>
      </div>

      <form id="loginForm" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Email</label>
          <input type="email" id="email" required placeholder="you@cloudbridge.info"
            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-bridge-700 focus:border-transparent">
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Password</label>
          <input type="password" id="password" required placeholder="Enter your password"
            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-bridge-700 focus:border-transparent">
        </div>

        <label class="flex items-center gap-2 text-sm text-slate-600 cursor-pointer">
          <input type="checkbox" id="remember" class="rounded accent-sunrise-600">
          Remember me
        </label>

        <p id="errorMsg" class="hidden text-sm text-red-700 bg-red-50 border border-red-200 rounded-xl px-4 py-2.5"></p>

        <button type="submit" class="btn-red-gradient w-full text-white font-semibold rounded-xl py-3 text-sm shadow-sm transition">
          Log In
        </button>
      </form>
    </div>
  </div>

  <script is:inline>
    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value;
      const password = document.getElementById('password').value;
      const errorMsg = document.getElementById('errorMsg');
      errorMsg.classList.add('hidden');
      try {
        const res = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Login failed');
        location.href = '/cbc-admin';
      } catch (err) {
        errorMsg.textContent = err.message;
        errorMsg.classList.remove('hidden');
      }
    });
  </script>
</body>
</html>
