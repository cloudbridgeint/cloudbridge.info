---
import AdminLayout from '../../../layouts/AdminLayout.astro';
export const prerender = false;
const db = (Astro.locals as any).runtime.env.DB;
const { id } = Astro.params;
const post = await db.prepare('SELECT * FROM blog_posts WHERE id = ?').bind(id).first();

const DEDICATED_SLUGS = new Set(['study-in-uk','study-in-usa','study-in-europe','visa-interview-tips','find-scholarships','first-month-abroad']);
function postHref(slug: string) { return DEDICATED_SLUGS.has(slug) ? `/${slug}` : `/blogs/${slug}`; }
function resolveImg(url: string | null) {
  if (!url) return '';
  if (url.startsWith('media:')) return `/api/media/${url.slice(6)}`;
  return url;
}
---
<AdminLayout title="Edit Post" active="blogs">
  {!post ? (
    <div class="text-center py-24">
      <p class="text-slate-500">Post not found.</p>
      <a href="/cbc-admin/blogs" class="text-iris-700 hover:underline text-sm mt-2 inline-block">&larr; Back to Posts</a>
    </div>
  ) : (
  <>
  <div class="flex items-center justify-between gap-4 flex-wrap mb-6">
    <div class="flex items-center gap-3">
      <a href="/cbc-admin/blogs" class="w-9 h-9 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-500 transition shrink-0">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </a>
      <h1 class="text-2xl font-bold text-slate-900">Edit Post</h1>
    </div>
    <div class="flex items-center gap-2">
      <a href={postHref(post.slug)} target="_blank" class="text-sm text-slate-500 hover:underline mr-2">View live &rarr;</a>
      <button id="deleteBtn" class="text-sm font-semibold text-red-600 hover:underline mr-2">Delete</button>
      <label class="flex items-center gap-2 text-sm text-slate-600 mr-2">
        <input type="checkbox" id="fPublished" checked={!!post.published}> Publish
      </label>
      <button id="saveBtn" class="bg-bridge-700 hover:bg-bridge-800 text-white text-sm font-semibold rounded-lg px-5 py-2.5 transition">Update Post</button>
    </div>
  </div>

  <div class="grid lg:grid-cols-[1fr_320px] gap-6 items-start">
    <div class="space-y-4 min-w-0">
      <input id="fTitle" type="text" placeholder="Post title" value={post.title}
        class="w-full text-2xl font-bold text-slate-900 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-iris-200">

      <div class="bg-white rounded-xl ring-1 ring-black/5 shadow-sm overflow-hidden">
        <div id="editorToolbar"></div>
        <div id="editor" style="min-height: 420px;"></div>
      </div>
    </div>

    <div class="space-y-4">
      <div class="bg-white rounded-xl ring-1 ring-black/5 shadow-sm p-4 space-y-3">
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Slug (URL) <span class="text-slate-400 font-normal">(changing this moves the post off its current URL)</span></label>
          <input id="fSlug" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" value={post.slug}>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Category / badge</label>
          <input id="fCategory" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" value={post.category || ''}>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Short description</label>
          <textarea id="fDesc" rows="3" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">{post.description || ''}</textarea>
        </div>
      </div>

      <div class="bg-white rounded-xl ring-1 ring-black/5 shadow-sm p-4 space-y-2">
        <label class="block text-xs font-medium text-slate-600">Featured image</label>
        <img id="fImgPreview" class={`${post.hero_image ? '' : 'hidden'} w-full h-32 object-cover rounded-lg border`} src={resolveImg(post.hero_image)}>
        <input type="file" id="fImgFile" accept="image/*" class="w-full text-sm">
        <input type="hidden" id="fImgUrl" value={post.hero_image || ''}>
      </div>
    </div>
  </div>
  </>
  )}
</AdminLayout>

<script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js" is:inline></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.min.css">
<style>
  #editor { font-size: 15px; }
  .ql-editor { min-height: 420px; padding: 1.25rem; }
  .ql-editor h1 { font-size: 1.75rem; font-weight: 800; margin-top: 0.5em; }
  .ql-editor h2 { font-size: 1.4rem; font-weight: 700; margin-top: 0.75em; }
  .ql-editor h3 { font-size: 1.15rem; font-weight: 700; margin-top: 0.75em; }
  .ql-toolbar.ql-snow { border: none; border-bottom: 1px solid #eef0f5; }
  .ql-container.ql-snow { border: none; }
</style>

<script define:vars={{ postId: post?.id, initialBody: post?.body || '' }} is:inline>
  if (document.getElementById('editor')) {
    const quill = new Quill('#editor', {
      theme: 'snow',
      modules: {
        toolbar: [
          [{ header: [1, 2, 3, false] }],
          ['bold', 'italic', 'underline'],
          ['link', 'image'],
          [{ list: 'ordered' }, { list: 'bullet' }],
          ['blockquote'],
          ['clean'],
        ],
      },
      placeholder: 'Write your article…',
    });
    quill.root.innerHTML = initialBody;

    quill.getModule('toolbar').addHandler('image', () => {
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*';
      input.onchange = async () => {
        const file = input.files[0];
        if (!file) return;
        const fd = new FormData();
        fd.append('file', file);
        try {
          const res = await fetch('/api/media', { method: 'POST', body: fd });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);
          const range = quill.getSelection(true);
          quill.insertEmbed(range.index, 'image', data.url, 'user');
          quill.setSelection(range.index + 1);
        } catch (err) { showToast(err.message, 'error'); }
      };
      input.click();
    });

    document.getElementById('fImgFile').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const fd = new FormData();
      fd.append('file', file);
      try {
        const res = await fetch('/api/media', { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        document.getElementById('fImgUrl').value = `media:${data.id}`;
        const preview = document.getElementById('fImgPreview');
        preview.src = data.url;
        preview.classList.remove('hidden');
      } catch (err) { showToast(err.message, 'error'); }
    });

    document.getElementById('saveBtn').addEventListener('click', async () => {
      const title = document.getElementById('fTitle').value.trim();
      const slug = document.getElementById('fSlug').value.trim().toLowerCase().replace(/[^a-z0-9-]+/g, '-');
      const description = document.getElementById('fDesc').value.trim();
      const category = document.getElementById('fCategory').value.trim();
      const body = quill.root.innerHTML;
      const hero_image = document.getElementById('fImgUrl').value;
      const published = document.getElementById('fPublished').checked;
      if (!title || !slug) { showToast('Title and slug are required', 'error'); return; }
      try {
        await apiFetch(`/api/blog-posts/${postId}`, { method: 'PUT', body: JSON.stringify({ title, slug, description, category, body, hero_image, published }) });
        showToast('Post updated');
      } catch (e) { showToast(e.message, 'error'); }
    });

    document.getElementById('deleteBtn').addEventListener('click', async () => {
      if (!confirm('Delete this blog post? This cannot be undone.')) return;
      try {
        await apiFetch(`/api/blog-posts/${postId}`, { method: 'DELETE' });
        showToast('Deleted');
        setTimeout(() => { location.href = '/cbc-admin/blogs'; }, 500);
      } catch (e) { showToast(e.message, 'error'); }
    });
  }
</script>
