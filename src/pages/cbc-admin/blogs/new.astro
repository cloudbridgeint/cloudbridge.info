---
import AdminLayout from '../../../layouts/AdminLayout.astro';
export const prerender = false;
---
<AdminLayout title="New Post" active="blogs">
  <div class="flex items-center justify-between gap-4 flex-wrap mb-6">
    <div class="flex items-center gap-3">
      <a href="/cbc-admin/blogs" class="w-9 h-9 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-500 transition shrink-0">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </a>
      <h1 class="text-2xl font-bold text-slate-900">New Post</h1>
    </div>
    <div class="flex items-center gap-2">
      <button id="saveDraftBtn" class="bg-bridge-700 hover:bg-bridge-800 text-white text-sm font-semibold rounded-lg px-5 py-2.5 transition">Save Post</button>
      <button id="publishBtn" class="bg-bridge-700 hover:bg-bridge-800 text-white text-sm font-semibold rounded-lg px-5 py-2.5 transition">Publish</button>
    </div>
  </div>

  <div class="grid lg:grid-cols-[1fr_320px] gap-6 items-start">
    <!-- Main column: title + editor -->
    <div class="space-y-4 min-w-0">
      <input id="fTitle" type="text" placeholder="Post title"
        class="w-full text-2xl font-bold text-slate-900 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-iris-200">

      <div class="bg-white rounded-xl ring-1 ring-black/5 shadow-sm overflow-hidden">
        <div id="editorToolbar"></div>
        <div id="editor" style="min-height: 420px;"></div>
      </div>
    </div>

    <!-- Sidebar: SEO score + metadata -->
    <div class="space-y-4">

      <!-- On-Page SEO score panel -->
      <div class="bg-white rounded-xl ring-1 ring-black/5 shadow-sm p-4">
        <button type="button" id="seoToggle" class="w-full flex items-center justify-between">
          <span class="text-sm font-semibold text-slate-900">On-Page SEO</span>
          <div class="flex items-center gap-2">
            <div class="relative w-11 h-11 shrink-0">
              <svg class="w-11 h-11 -rotate-90" viewBox="0 0 80 80">
                <circle cx="40" cy="40" r="32" fill="none" stroke-width="8" class="ring-track"/>
                <circle id="seoRing" cx="40" cy="40" r="32" fill="none" stroke-width="8" stroke="#ef4444" stroke-linecap="round" stroke-dasharray="0 201.06" style="transition: stroke-dasharray 0.3s ease, stroke 0.3s ease;"/>
              </svg>
              <div class="absolute inset-0 flex items-center justify-center">
                <span id="seoScoreText" class="text-[10px] font-bold text-bridge-950">0%</span>
              </div>
            </div>
            <svg id="seoChevron" class="w-4 h-4 text-slate-400 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
          </div>
        </button>
        <div id="seoDetails" class="hidden mt-4 space-y-2.5 border-t border-slate-100 pt-3"></div>
      </div>

      <div class="bg-white rounded-xl ring-1 ring-black/5 shadow-sm p-4 space-y-3">
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Slug (URL)</label>
          <input id="fSlug" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" placeholder="e.g. my-new-post">
          <p class="text-[11px] text-slate-400 mt-1">Will be published at /blogs/&lt;slug&gt;</p>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Category / badge</label>
          <input id="fCategory" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" placeholder="e.g. Study Destinations">
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1">Short description</label>
          <textarea id="fDesc" rows="3" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" placeholder="Shown in the blog listing and search results"></textarea>
        </div>
      </div>

      <!-- Featured image dropzone -->
      <div class="bg-white rounded-xl ring-1 ring-black/5 shadow-sm p-4">
        <label class="block text-xs font-medium text-slate-600 mb-2">Featured image</label>
        <div id="heroDropzone" class="relative border-2 border-dashed border-slate-300 rounded-xl h-44 flex items-center justify-center text-center cursor-pointer hover:border-iris-400 hover:bg-iris-50/40 transition overflow-hidden">
          <img id="fImgPreview" class="hidden absolute inset-0 w-full h-full object-cover">
          <div id="heroDropzoneEmpty" class="text-slate-400 px-4 pointer-events-none">
            <svg class="w-8 h-8 mx-auto mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M4 8h.01M4 4h16a2 2 0 012 2v12a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2z"/></svg>
            <p class="text-xs font-medium">Click or drag an image here</p>
            <p class="text-[11px] text-slate-400 mt-0.5">PNG or JPG, up to ~1.4MB</p>
          </div>
          <button type="button" id="heroRemoveBtn" class="hidden absolute top-2 right-2 w-7 h-7 rounded-full bg-black/50 hover:bg-black/70 text-white flex items-center justify-center transition">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <input type="file" id="fImgFile" accept="image/*" class="hidden">
        <input type="hidden" id="fImgUrl">
      </div>
    </div>
  </div>
</AdminLayout>

<script src="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.min.js" is:inline></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/quill/1.3.7/quill.snow.min.css">
<style is:global>
  #editor { font-size: 15px; }
  .ql-editor { min-height: 420px; padding: 1.25rem; }
  .ql-editor h1 { font-size: 1.75rem; font-weight: 800; margin-top: 0.5em; }
  .ql-editor h2 { font-size: 1.4rem; font-weight: 700; margin-top: 0.75em; }
  .ql-editor h3 { font-size: 1.15rem; font-weight: 700; margin-top: 0.75em; }
  .ql-editor h4 { font-size: 1.05rem; font-weight: 700; margin-top: 0.75em; }
  .ql-editor h5 { font-size: 0.95rem; font-weight: 700; margin-top: 0.75em; }
  .ql-editor h6 { font-size: 0.85rem; font-weight: 700; margin-top: 0.75em; text-transform: uppercase; letter-spacing: 0.03em; }
  .ql-toolbar.ql-snow { border: none; border-bottom: 1px solid #eef0f5; }
  .ql-container.ql-snow { border: none; }

  /* Rename the "Normal" block option to "Paragraph", and label every heading level 1-6.
     !important is required: Quill's own snow.css targets [data-value=""] for the
     default state, which is more specific than a plain selector and otherwise wins. */
  .ql-snow .ql-picker.ql-header { width: 130px; }
  .ql-snow .ql-picker.ql-header .ql-picker-label::before,
  .ql-snow .ql-picker.ql-header .ql-picker-item::before {
    content: 'Paragraph' !important;
  }
  .ql-snow .ql-picker.ql-header .ql-picker-label[data-value="1"]::before,
  .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="1"]::before { content: 'Heading 1' !important; }
  .ql-snow .ql-picker.ql-header .ql-picker-label[data-value="2"]::before,
  .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="2"]::before { content: 'Heading 2' !important; }
  .ql-snow .ql-picker.ql-header .ql-picker-label[data-value="3"]::before,
  .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="3"]::before { content: 'Heading 3' !important; }
  .ql-snow .ql-picker.ql-header .ql-picker-label[data-value="4"]::before,
  .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="4"]::before { content: 'Heading 4' !important; }
  .ql-snow .ql-picker.ql-header .ql-picker-label[data-value="5"]::before,
  .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="5"]::before { content: 'Heading 5' !important; }
  .ql-snow .ql-picker.ql-header .ql-picker-label[data-value="6"]::before,
  .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="6"]::before { content: 'Heading 6' !important; }
  .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="1"] { font-size: 1.6em; }
  .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="2"] { font-size: 1.4em; }
  .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="3"] { font-size: 1.25em; }
  .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="4"] { font-size: 1.1em; }
  .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="5"] { font-size: 1em; }
  .ql-snow .ql-picker.ql-header .ql-picker-item[data-value="6"] { font-size: 0.9em; }

  #heroDropzone.dragover { border-color: #5b5fc7; background-color: rgba(91,95,199,0.06); }
  #editor.dragover { outline: 2px dashed #5b5fc7; outline-offset: -4px; }
</style>

<script is:inline>
  const quill = new Quill('#editor', {
    theme: 'snow',
    modules: {
      toolbar: [
        [{ header: [1, 2, 3, 4, 5, 6, false] }],
        ['bold', 'italic', 'underline'],
        ['link', 'image'],
        [{ list: 'ordered' }, { list: 'bullet' }],
        ['blockquote'],
        ['clean'],
      ],
    },
    placeholder: 'Write your article…',
  });

  async function uploadFile(file) {
    const fd = new FormData();
    fd.append('file', file);
    const res = await fetch('/api/media', { method: 'POST', body: fd });
    let data = {};
    try { data = await res.json(); } catch { /* empty/non-JSON body, fall through to generic error below */ }
    if (!res.ok) throw new Error(data.error || `Upload failed (server error ${res.status})`);
    return data;
  }

  function insertImageIntoEditor(url) {
    const range = quill.getSelection(true) || { index: quill.getLength() };
    quill.insertEmbed(range.index, 'image', url, 'user');
    quill.setSelection(range.index + 1);
  }

  // Toolbar image button
  quill.getModule('toolbar').addHandler('image', () => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.onchange = async () => {
      const file = input.files[0];
      if (!file) return;
      try { insertImageIntoEditor((await uploadFile(file)).url); }
      catch (err) { showToast(err.message, 'error'); }
    };
    input.click();
  });

  // Drag-and-drop an image straight into the article body
  const editorEl = document.getElementById('editor');
  editorEl.addEventListener('dragover', (e) => { e.preventDefault(); editorEl.classList.add('dragover'); });
  editorEl.addEventListener('dragleave', () => editorEl.classList.remove('dragover'));
  editorEl.addEventListener('drop', async (e) => {
    e.preventDefault();
    editorEl.classList.remove('dragover');
    const file = e.dataTransfer.files && e.dataTransfer.files[0];
    if (file && file.type.startsWith('image/')) {
      try { insertImageIntoEditor((await uploadFile(file)).url); }
      catch (err) { showToast(err.message, 'error'); }
    }
  });

  // Auto-generate slug from title while the slug field is untouched
  let slugTouched = false;
  document.getElementById('fSlug').addEventListener('input', () => { slugTouched = true; });
  document.getElementById('fTitle').addEventListener('input', (e) => {
    if (slugTouched) return;
    document.getElementById('fSlug').value = e.target.value.trim().toLowerCase()
      .replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');
  });

  // Featured image dropzone: click-to-upload + drag-and-drop
  const dropzone = document.getElementById('heroDropzone');
  const heroFileInput = document.getElementById('fImgFile');
  function showHeroPreview(url) {
    document.getElementById('fImgPreview').src = url;
    document.getElementById('fImgPreview').classList.remove('hidden');
    document.getElementById('heroDropzoneEmpty').classList.add('hidden');
    document.getElementById('heroRemoveBtn').classList.remove('hidden');
  }
  async function handleHeroFile(file) {
    if (!file) return;
    try {
      const data = await uploadFile(file);
      document.getElementById('fImgUrl').value = `media:${data.id}`;
      showHeroPreview(data.url);
      renderSeo();
    } catch (err) { showToast(err.message, 'error'); }
  }
  dropzone.addEventListener('click', (e) => {
    if (e.target.closest('#heroRemoveBtn')) return;
    heroFileInput.click();
  });
  heroFileInput.addEventListener('change', (e) => handleHeroFile(e.target.files[0]));
  dropzone.addEventListener('dragover', (e) => { e.preventDefault(); dropzone.classList.add('dragover'); });
  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('dragover');
    handleHeroFile(e.dataTransfer.files && e.dataTransfer.files[0]);
  });
  document.getElementById('heroRemoveBtn').addEventListener('click', (e) => {
    e.stopPropagation();
    document.getElementById('fImgUrl').value = '';
    heroFileInput.value = '';
    document.getElementById('fImgPreview').classList.add('hidden');
    document.getElementById('heroDropzoneEmpty').classList.remove('hidden');
    document.getElementById('heroRemoveBtn').classList.add('hidden');
    renderSeo();
  });

  async function savePost(published) {
    const title = document.getElementById('fTitle').value.trim();
    const slug = document.getElementById('fSlug').value.trim().toLowerCase().replace(/[^a-z0-9-]+/g, '-');
    const description = document.getElementById('fDesc').value.trim();
    const category = document.getElementById('fCategory').value.trim();
    const body = quill.root.innerHTML;
    const hero_image = document.getElementById('fImgUrl').value;
    if (!title || !slug) { showToast('Title and slug are required', 'error'); return; }
    try {
      await apiFetch('/api/blog-posts', { method: 'POST', body: JSON.stringify({ title, slug, description, category, body, hero_image, published }) });
      showToast(published ? 'Post published' : 'Post saved');
      setTimeout(() => { location.href = '/cbc-admin/blogs'; }, 500);
    } catch (e) { showToast(e.message, 'error'); }
  }
  document.getElementById('saveDraftBtn').addEventListener('click', () => savePost(false));
  document.getElementById('publishBtn').addEventListener('click', () => savePost(true));

  // ---------------- On-Page SEO score ----------------
  const SEO_CHECKS = [
    { key: 'title', label: 'Title added' },
    { key: 'titleLength', label: 'Title length is good (under 60 characters)' },
    { key: 'metaDesc', label: 'Meta description added' },
    { key: 'metaDescLength', label: 'Meta description length is good (50–160 characters)' },
    { key: 'slug', label: 'SEO-friendly URL slug set' },
    { key: 'featuredImage', label: 'Featured image added' },
    { key: 'h2', label: 'At least one H2 subheading used' },
    { key: 'h3', label: 'At least one H3 subheading used' },
    { key: 'internalLink', label: 'At least one internal link added' },
    { key: 'externalLink', label: 'At least one outbound link added' },
  ];

  function hasLinkType(html, wantExternal) {
    const div = document.createElement('div');
    div.innerHTML = html;
    return Array.from(div.querySelectorAll('a[href]')).some((a) => {
      const href = a.getAttribute('href') || '';
      const isExternal = /^https?:\/\//i.test(href) && !href.includes(location.hostname);
      return wantExternal ? isExternal : (href.length > 0 && !isExternal);
    });
  }

  function evaluateSeo() {
    const title = document.getElementById('fTitle').value.trim();
    const slug = document.getElementById('fSlug').value.trim();
    const desc = document.getElementById('fDesc').value.trim();
    const heroUrl = document.getElementById('fImgUrl').value.trim();
    const bodyHtml = quill.root.innerHTML;
    return {
      title: title.length > 0,
      titleLength: title.length > 0 && title.length <= 60,
      metaDesc: desc.length > 0,
      metaDescLength: desc.length >= 50 && desc.length <= 160,
      slug: slug.length > 0,
      featuredImage: heroUrl.length > 0,
      h2: /<h2[\s>]/i.test(bodyHtml),
      h3: /<h3[\s>]/i.test(bodyHtml),
      internalLink: hasLinkType(bodyHtml, false),
      externalLink: hasLinkType(bodyHtml, true),
    };
  }

  function renderSeo() {
    const results = evaluateSeo();
    const passed = SEO_CHECKS.filter((c) => results[c.key]).length;
    const pct = Math.round((passed / SEO_CHECKS.length) * 100);

    document.getElementById('seoScoreText').textContent = pct + '%';
    const circumference = 2 * Math.PI * 32;
    const dash = (pct / 100) * circumference;
    const ring = document.getElementById('seoRing');
    ring.setAttribute('stroke-dasharray', `${dash} ${circumference}`);
    ring.setAttribute('stroke', pct === 100 ? '#10b981' : pct >= 50 ? '#f59e0b' : '#ef4444');

    document.getElementById('seoDetails').innerHTML = SEO_CHECKS.map((c) => {
      const ok = results[c.key];
      return `<div class="flex items-center gap-2 text-xs">
        <span class="w-2 h-2 rounded-full shrink-0 ${ok ? 'bg-emerald-500' : 'bg-red-500'}"></span>
        <span class="${ok ? 'text-slate-600' : 'text-slate-400'}">${c.label}</span>
      </div>`;
    }).join('');
  }

  document.getElementById('seoToggle').addEventListener('click', () => {
    document.getElementById('seoDetails').classList.toggle('hidden');
    document.getElementById('seoChevron').classList.toggle('rotate-180');
  });

  ['fTitle', 'fSlug', 'fDesc'].forEach((id) => {
    document.getElementById(id).addEventListener('input', renderSeo);
  });
  quill.on('text-change', renderSeo);
  renderSeo();
</script>
