---
import AdminLayout from '../../layouts/AdminLayout.astro';
export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const { results } = await db.prepare(
  "SELECT * FROM leads WHERE source_page = 'apply-now' ORDER BY created_at DESC LIMIT 200"
).all();
const applications = results as any[];

function docLink(url: string, label: string) {
  return url ? { url, label } : null;
}
---
<AdminLayout title="Applications" active="applications">
  <h1 class="text-2xl font-bold text-bridge-950">Applications</h1>
  <p class="text-slate-500 mt-1 text-sm">Submissions from the Apply Now form.</p>

  <div class="mt-8 space-y-3">
    {applications.length === 0 ? (
      <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-8 text-center">
        <p class="text-slate-400 text-sm">No applications yet — they'll show up here once someone submits the Apply Now form.</p>
      </div>
    ) : applications.map((a: any) => (
      <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-5">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div>
            <p class="font-semibold text-bridge-950 text-sm">{a.name || 'Anonymous'}</p>
            <p class="text-xs text-slate-400 mt-0.5">{a.email} {a.phone ? `· ${a.phone}` : ''}</p>
          </div>
          <p class="text-xs text-slate-400 whitespace-nowrap">{a.created_at}</p>
        </div>

        <div class="mt-4 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-2 text-xs">
          {a.dob && <p><span class="text-slate-400">Date of birth:</span> <span class="text-slate-700 font-medium">{a.dob}</span></p>}
          {a.gender && <p><span class="text-slate-400">Gender:</span> <span class="text-slate-700 font-medium">{a.gender}</span></p>}
          {a.nationality && <p><span class="text-slate-400">Nationality:</span> <span class="text-slate-700 font-medium">{a.nationality}</span></p>}
          {a.residence_country && <p><span class="text-slate-400">Residence:</span> <span class="text-slate-700 font-medium">{a.residence_country}</span></p>}
          {a.address && <p class="sm:col-span-2 lg:col-span-3"><span class="text-slate-400">Address:</span> <span class="text-slate-700 font-medium">{a.address}</span></p>}
          {a.degree_level && <p><span class="text-slate-400">Highest qualification:</span> <span class="text-slate-700 font-medium">{a.degree_level}</span></p>}
          {a.institute_name && <p><span class="text-slate-400">Institute:</span> <span class="text-slate-700 font-medium">{a.institute_name}</span></p>}
          {a.course_studied && <p><span class="text-slate-400">Course studied:</span> <span class="text-slate-700 font-medium">{a.course_studied}</span></p>}
          {a.graduation_year && <p><span class="text-slate-400">Graduation date:</span> <span class="text-slate-700 font-medium">{a.graduation_year}</span></p>}
          {a.english_test && <p><span class="text-slate-400">English test:</span> <span class="text-slate-700 font-medium">{a.english_test}</span></p>}
          {a.preferred_study_level && <p><span class="text-slate-400">Preferred study level:</span> <span class="text-slate-700 font-medium">{a.preferred_study_level}</span></p>}
          {a.subject_interested && <p><span class="text-slate-400">Preferred subject:</span> <span class="text-slate-700 font-medium">{a.subject_interested}</span></p>}
          {(a.intake_month || a.intake_year) && <p><span class="text-slate-400">Intake:</span> <span class="text-slate-700 font-medium">{a.intake_month} {a.intake_year}</span></p>}
        </div>

        {(a.doc_academic_cert || a.doc_transcript || a.doc_english_cert || a.doc_cv || a.doc_personal_statement) && (
          <div class="mt-4 pt-3 border-t border-slate-50 flex flex-wrap gap-2">
            {a.doc_academic_cert && <a href={a.doc_academic_cert} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-xs font-semibold text-iris-700 bg-iris-50 hover:bg-iris-100 rounded-full px-3 py-1.5 transition">📄 Academic Certificate</a>}
            {a.doc_transcript && <a href={a.doc_transcript} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-xs font-semibold text-iris-700 bg-iris-50 hover:bg-iris-100 rounded-full px-3 py-1.5 transition">📄 Transcript</a>}
            {a.doc_english_cert && <a href={a.doc_english_cert} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-xs font-semibold text-iris-700 bg-iris-50 hover:bg-iris-100 rounded-full px-3 py-1.5 transition">📄 English Certificate</a>}
            {a.doc_cv && <a href={a.doc_cv} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-xs font-semibold text-iris-700 bg-iris-50 hover:bg-iris-100 rounded-full px-3 py-1.5 transition">📄 CV / Resume</a>}
            {a.doc_personal_statement && <a href={a.doc_personal_statement} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-xs font-semibold text-iris-700 bg-iris-50 hover:bg-iris-100 rounded-full px-3 py-1.5 transition">📄 Personal Statement</a>}
          </div>
        )}
      </div>
    ))}
  </div>
</AdminLayout>
