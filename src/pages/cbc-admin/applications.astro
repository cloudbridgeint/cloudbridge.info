---
import AdminLayout from '../../layouts/AdminLayout.astro';
export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const { results } = await db.prepare(
  "SELECT * FROM leads WHERE source_page = 'apply-now' ORDER BY created_at DESC LIMIT 500"
).all();
const applications = results as any[];

const AVATAR_CLASSES = ['badge-purple', 'badge-pink', 'badge-blue', 'badge-teal'];

function appId(id: number) {
  return `APP-${String(id).padStart(5, '0')}`;
}
function initials(name: string) {
  const parts = (name || '').trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return '?';
  return (parts[0][0] + (parts[1]?.[0] || '')).toUpperCase();
}
function avatarClass(id: number) {
  return AVATAR_CLASSES[id % AVATAR_CLASSES.length];
}
function dateOnly(ts: string) {
  return (ts || '').split(' ')[0] || '—';
}
function timeOnly(ts: string) {
  return (ts || '').split(' ')[1] || '—';
}
function monthKey(ts: string) {
  return dateOnly(ts).slice(0, 7); // "YYYY-MM"
}

// Rows enriched for both server render and the client-side JSON dataset used
// by the stat cards (so the month/year filter can recompute without a refetch).
const rows = applications.map((a: any) => ({
  ...a,
  app_id: appId(a.id),
  has_english: !!(a.english_test && String(a.english_test).trim()),
  month_key: monthKey(a.created_at),
  date_only: dateOnly(a.created_at),
  time_only: timeOnly(a.created_at),
}));

// Month options available in the data, newest first, for the Card 1 filter.
const monthSet = new Map<string, string>();
for (const r of rows) {
  if (!r.month_key) continue;
  if (!monthSet.has(r.month_key)) {
    const d = new Date(`${r.month_key}-01T00:00:00Z`);
    monthSet.set(r.month_key, d.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }));
  }
}
const monthOptions = Array.from(monthSet.entries()).sort((a, b) => (a[0] < b[0] ? 1 : -1));
---
<AdminLayout title="Applications" active="applications">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-2xl font-bold text-bridge-950">Applications</h1>
      <p class="text-slate-500 mt-1 text-sm">Everyone who submitted the Apply Now form, newest first.</p>
    </div>
  </div>

  <!-- Full applicant dataset — powers both the stat cards and the profile panel,
       so opening a profile or switching applicant inside the panel never needs a refetch. -->
  <script type="application/json" id="appsData" set:html={JSON.stringify(rows.map((r: any) => ({
    id: r.id, app_id: r.app_id, has_english: r.has_english, month_key: r.month_key,
    destination_country: r.destination_country || '', status: r.status || 'new', created_at: r.created_at,
    name: r.name || 'Anonymous', email: r.email || '', phone: r.phone || '',
    dob: r.dob || '', gender: r.gender || '', nationality: r.nationality || '',
    residence_country: r.residence_country || '', residence_city: r.residence_city || '', address: r.address || '',
    degree_level: r.degree_level || '', institute_name: r.institute_name || '',
    course_studied: r.course_studied || '', graduation_year: r.graduation_year || '',
    english_test: r.english_test || '', test_score: r.test_score || '',
    preferred_study_level: r.preferred_study_level || '', subject_interested: r.subject_interested || '',
    intake_month: r.intake_month || '', intake_year: r.intake_year || '',
    date_only: r.date_only, time_only: r.time_only,
    doc_academic_cert: r.doc_academic_cert || '', doc_transcript: r.doc_transcript || '',
    doc_english_cert: r.doc_english_cert || '', doc_cv: r.doc_cv || '', doc_personal_statement: r.doc_personal_statement || '',
  })))}></script>

  <!-- 4 stat cards -->
  <div class="mt-6 grid grid-cols-1 md:grid-cols-4 gap-4">

    <!-- Card 1: Total applications + destination breakdown, filterable by month -->
    <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-5 flex flex-col">
      <div class="flex items-center justify-between mb-3">
        <span class="w-9 h-9 rounded-xl bg-sunrise-50 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-sunrise-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
        </span>
        <select id="cardMonthFilter" class="text-xs font-semibold text-bridge-800 bg-bridge-50 rounded-lg pl-2.5 pr-1.5 py-1.5 border-0 focus:outline-none focus:ring-2 focus:ring-iris-200">
          <option value="">All time</option>
          {monthOptions.map(([key, label]) => <option value={key}>{label}</option>)}
        </select>
      </div>
      <p class="text-xs font-medium text-slate-400">Total applications</p>
      <p id="statTotal" class="text-3xl font-bold text-bridge-950 mt-1">{applications.length}</p>

      <div id="statCountryList" class="mt-4 pt-4 border-t border-slate-100 space-y-2.5"></div>
      <p id="statCountryEmpty" class="hidden mt-4 pt-4 border-t border-slate-100 text-xs text-slate-400">No applications in this period.</p>
    </div>

    <!-- Card 2: English proficiency -->
    <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-5 flex flex-col">
      <div class="flex items-center justify-between mb-3">
        <span class="w-9 h-9 rounded-xl bg-emerald-50 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14M5 8a2 2 0 01-2-2V4a2 2 0 012-2h8a2 2 0 012 2v2a2 2 0 01-2 2M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8M9 12l2 2 4-4"/></svg>
        </span>
      </div>
      <p class="text-xs font-medium text-slate-400">English proficiency</p>
      <p class="text-3xl font-bold text-bridge-950 mt-1"><span id="statEnglishPct">0</span>%</p>
      <p class="text-xs text-slate-400 mt-0.5">of applicants have a test on file</p>

      <div class="mt-4 pt-4 border-t border-slate-100 space-y-3">
        <div class="flex items-center gap-2.5">
          <span class="w-6 h-6 rounded-md bg-emerald-50 flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg>
          </span>
          <span class="text-xs text-slate-600 flex-1">Yes</span>
          <span id="statEnglishYes" class="text-xs font-semibold text-bridge-950">0</span>
        </div>
        <div class="flex items-center gap-2.5">
          <span class="w-6 h-6 rounded-md bg-sunrise-50 flex items-center justify-center shrink-0">
            <svg class="w-3.5 h-3.5 text-sunrise-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </span>
          <span class="text-xs text-slate-600 flex-1">No</span>
          <span id="statEnglishNo" class="text-xs font-semibold text-bridge-950">0</span>
        </div>
      </div>
    </div>

    <!-- Card 3: New this week -->
    <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-5 flex flex-col">
      <div class="flex items-center justify-between mb-3">
        <span class="w-9 h-9 rounded-xl bg-amber-50 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4 text-amber-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
        </span>
      </div>
      <p class="text-xs font-medium text-slate-400">New this week</p>
      <p id="statWeek" class="text-3xl font-bold text-bridge-950 mt-1">0</p>
      <p id="statWeekTrend" class="text-xs font-semibold mt-1.5 flex items-center gap-1"></p>
    </div>

    <!-- Card 4: Pending review (highlighted) -->
    <div class="rounded-2xl p-5 flex flex-col justify-between text-white shadow-sm" style="background: linear-gradient(150deg, #254368, #0f1c30);">
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0" style="background: rgba(255,255,255,0.12);">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
          </span>
        </div>
        <p class="text-xs font-medium" style="color:#c7cee0">Pending review</p>
        <p id="statPending" class="text-3xl font-bold mt-1">0</p>
        <p class="text-xs mt-1" style="color:#c7cee0">not yet contacted</p>
      </div>
      <button type="button" id="pendingFilterBtn" class="mt-4 w-full text-sm font-semibold rounded-xl py-2.5 bg-sunrise-600 hover:bg-sunrise-700 transition">
        View pending
      </button>
    </div>
  </div>

  <!-- Applications table -->
  <div id="appsTableCard" class="mt-6 card-soft rounded-2xl ring-1 ring-black/5 shadow-sm overflow-hidden">
    <div class="flex items-center justify-between flex-wrap gap-3 px-5 py-4 border-b border-slate-100">
      <p class="font-semibold text-bridge-950 text-sm">All Applications <span id="tableCount" class="text-slate-400 font-normal">({applications.length})</span></p>
      <div class="relative">
        <input id="appsSearch" type="text" placeholder="Search name, ID, phone, country"
          class="w-64 bg-slate-50 border border-transparent rounded-full pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-iris-200 focus:bg-white transition">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-slate-500 border-b border-slate-100 bg-slate-50/50">
            <th class="px-5 py-3 font-medium whitespace-nowrap">Application ID</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">Applicant</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">Phone</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">Interested Country</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">English</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">Received</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap"></th>
          </tr>
        </thead>
        <tbody id="appsTableBody">
          {rows.map((a: any, idx: number) => (
            <tr
              class="app-row border-b border-slate-50 hover:bg-slate-50/50 transition"
              data-search={`${a.app_id} ${a.name} ${a.phone} ${a.destination_country}`.toLowerCase()}
              data-status={a.status || 'new'}
            >
              <td class="px-5 py-3.5 font-medium text-slate-500 whitespace-nowrap">{a.app_id}</td>
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-2.5">
                  <span class={`w-8 h-8 rounded-full ${avatarClass(a.id)} flex items-center justify-center text-[11px] font-bold text-white shrink-0`}>
                    {initials(a.name)}
                  </span>
                  <span class="font-semibold text-bridge-950 whitespace-nowrap">{a.name || 'Anonymous'}</span>
                </div>
              </td>
              <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap">{a.phone || '—'}</td>
              <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap">{a.destination_country || '—'}</td>
              <td class="px-5 py-3.5">
                {a.has_english ? (
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">Yes</span>
                ) : (
                  <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-sunrise-50 text-sunrise-700">No</span>
                )}
              </td>
              <td class="px-5 py-3.5 text-slate-400 text-xs whitespace-nowrap">{a.date_only}</td>
              <td class="px-5 py-3.5 whitespace-nowrap">
                <button type="button" class="view-profile-btn text-xs font-semibold text-iris-700 bg-iris-50 hover:bg-iris-100 rounded-full px-3.5 py-1.5 transition"
                  data-index={idx}
                >View Profile</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {applications.length === 0 && (
        <p class="text-slate-400 text-sm p-8 text-center">No applications yet — they'll show up here once someone submits the Apply Now form.</p>
      )}
      <p id="appsNoMatch" class="hidden text-slate-400 text-sm p-8 text-center">No applications match your search.</p>
    </div>
  </div>

  <!-- Backdrop for the profile drawer -->
  <div id="profileBackdrop" class="hidden fixed inset-0 bg-black/40 z-40 opacity-0 transition-opacity duration-300"></div>

  <!-- Profile panel: slides in from the right, half the page width -->
  <div id="profilePanel" class="hidden fixed inset-y-0 right-0 z-50 w-full md:w-1/2 bg-white shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-out">
    <div class="flex items-center justify-between px-5 py-3.5 border-b border-slate-100 shrink-0">
      <p class="text-sm font-semibold text-bridge-950">Applicant Profile</p>
      <button type="button" id="profilePanelClose" class="w-9 h-9 rounded-full flex items-center justify-center text-slate-500 hover:bg-slate-100 transition shrink-0">
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Detail -->
    <div class="flex-1 overflow-y-auto bg-slate-50/40">
      <div class="px-6 py-6">

          <!-- Header -->
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div class="flex items-center gap-4 min-w-0">
              <span id="ppAvatar" class="w-14 h-14 rounded-full flex items-center justify-center text-lg font-bold text-white shrink-0">—</span>
              <div class="min-w-0">
                <p id="ppName" class="text-lg font-bold text-bridge-950 truncate">—</p>
                <p id="ppAppId" class="text-xs text-slate-400 mt-0.5 font-mono">—</p>
                <div class="flex items-center gap-2 mt-2 flex-wrap">
                  <span id="ppCountryTag" class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-bridge-50 text-bridge-800">—</span>
                  <span id="ppDateTag" class="inline-flex items-center gap-1 text-xs font-medium px-2.5 py-1 rounded-full bg-slate-100 text-slate-500">—</span>
                  <span id="ppEnglishTag" class="inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full">—</span>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <a id="ppCallBtn" href="#" class="w-9 h-9 rounded-full bg-white ring-1 ring-black/5 hover:bg-slate-100 flex items-center justify-center text-slate-500 transition">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              </a>
              <a id="ppEmailBtn" href="#" class="inline-flex items-center gap-2 text-sm font-semibold text-white bg-iris-600 hover:bg-iris-700 rounded-xl px-4 py-2.5 transition">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z" opacity="0"/><path d="M22 6 12 13 2 6"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg>
                Send Email
              </a>
            </div>
          </div>

          <!-- Tabs -->
          <div class="flex items-center gap-1 mt-6 border-b border-slate-200">
            <button type="button" data-tab="overview" class="pp-tab-btn px-4 py-2.5 text-sm font-semibold border-b-2 transition">Application</button>
            <button type="button" data-tab="documents" class="pp-tab-btn px-4 py-2.5 text-sm font-semibold border-b-2 transition">Documents</button>
          </div>

          <!-- Tab: Application overview -->
          <div id="ppTabOverview" class="pp-tab-panel mt-6 space-y-5">

            <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-5">
              <p class="text-sm font-semibold text-bridge-950 mb-5">Application Status</p>
              <div id="ppStages" class="flex items-start"></div>
            </div>

            <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-5">
              <div class="flex items-center justify-between">
                <p class="text-sm font-semibold text-bridge-950">Profile Completeness</p>
                <p id="ppCompletenessPct" class="text-sm font-bold text-bridge-950">0%</p>
              </div>
              <div class="mt-3 h-2 rounded-full bg-slate-100 overflow-hidden">
                <div id="ppCompletenessBar" class="h-full rounded-full bg-emerald-500 transition-all" style="width:0%"></div>
              </div>
              <p class="text-xs text-slate-400 mt-2">Share of the application form this applicant filled in.</p>
            </div>

            <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-5">
              <p class="text-sm font-semibold text-bridge-950 mb-4">Personal Information</p>
              <div class="grid grid-cols-2 gap-x-5 gap-y-3.5 text-sm">
                <div><p class="text-xs text-slate-400">Email</p><p id="ppEmail" class="font-medium text-slate-700 mt-0.5 break-all">—</p></div>
                <div><p class="text-xs text-slate-400">Phone</p><p id="ppPhone" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div><p class="text-xs text-slate-400">Gender</p><p id="ppGender" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div><p class="text-xs text-slate-400">Date of birth</p><p id="ppDob" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div><p class="text-xs text-slate-400">Country of residence</p><p id="ppResidence" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div><p class="text-xs text-slate-400">City / District</p><p id="ppResidenceCity" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div class="col-span-2"><p class="text-xs text-slate-400">Address</p><p id="ppAddress" class="font-medium text-slate-700 mt-0.5">—</p></div>
              </div>
            </div>

            <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-5">
              <p class="text-sm font-semibold text-bridge-950 mb-4">Study Plan</p>
              <div class="grid grid-cols-2 gap-x-5 gap-y-3.5 text-sm">
                <div><p class="text-xs text-slate-400">Interested country</p><p id="ppDestination" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div><p class="text-xs text-slate-400">Preferred study level</p><p id="ppPreferredLevel" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div><p class="text-xs text-slate-400">Preferred subject</p><p id="ppSubject" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div><p class="text-xs text-slate-400">Intake</p><p id="ppIntake" class="font-medium text-slate-700 mt-0.5">—</p></div>
              </div>
            </div>

            <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-5">
              <p class="text-sm font-semibold text-bridge-950 mb-4">Academic Background</p>
              <div class="grid grid-cols-2 gap-x-5 gap-y-3.5 text-sm">
                <div><p class="text-xs text-slate-400">Highest qualification</p><p id="ppDegree" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div><p class="text-xs text-slate-400">Institute</p><p id="ppInstitute" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div><p class="text-xs text-slate-400">Course studied</p><p id="ppCourse" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div><p class="text-xs text-slate-400">Graduation year</p><p id="ppGraduation" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div><p class="text-xs text-slate-400">English test</p><p id="ppEnglish" class="font-medium text-slate-700 mt-0.5">—</p></div>
                <div><p class="text-xs text-slate-400">Test score</p><p id="ppScore" class="font-medium text-slate-700 mt-0.5">—</p></div>
              </div>
            </div>
          </div>

          <!-- Tab: Documents -->
          <div id="ppTabDocuments" class="pp-tab-panel hidden mt-6">
            <div id="ppDocsList" class="grid gap-3"></div>
            <p id="ppDocsEmpty" class="hidden text-sm text-slate-400 text-center py-14">No documents uploaded with this application.</p>
          </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .pp-tab-btn { color: #94a3b8; border-color: transparent; }
  .pp-tab-btn.pp-tab-active { color: #1c3255; border-color: #aa1821; }
</style>

<script is:inline>
  const dataset = JSON.parse(document.getElementById('appsData').textContent || '[]');

  function pctOf(part, total) {
    return total > 0 ? Math.round((part / total) * 100) : 0;
  }

  function computeCards(monthKey) {
    const scoped = monthKey ? dataset.filter(d => d.month_key === monthKey) : dataset;

    // Card 1: total + destination breakdown
    document.getElementById('statTotal').textContent = scoped.length;
    const countryCounts = new Map();
    scoped.forEach(d => {
      const c = d.destination_country && d.destination_country.trim() ? d.destination_country.trim() : 'Not specified';
      countryCounts.set(c, (countryCounts.get(c) || 0) + 1);
    });
    const countryList = document.getElementById('statCountryList');
    const countryEmpty = document.getElementById('statCountryEmpty');
    countryList.innerHTML = '';
    if (scoped.length === 0) {
      countryList.classList.add('hidden');
      countryEmpty.classList.remove('hidden');
    } else {
      countryList.classList.remove('hidden');
      countryEmpty.classList.add('hidden');
      Array.from(countryCounts.entries())
        .sort((a, b) => b[1] - a[1])
        .slice(0, 5)
        .forEach(([country, count]) => {
          const p = pctOf(count, scoped.length);
          const row = document.createElement('div');
          row.className = 'flex items-center gap-2';
          row.innerHTML =
            '<span class="text-xs text-slate-600 flex-1 truncate">' + country + '</span>' +
            '<span class="w-16 h-1.5 rounded-full bg-slate-100 overflow-hidden shrink-0">' +
              '<span class="block h-full rounded-full bg-sunrise-600" style="width:' + p + '%"></span>' +
            '</span>' +
            '<span class="text-xs font-semibold text-bridge-950 w-8 text-right shrink-0">' + p + '%</span>';
          countryList.appendChild(row);
        });
    }

    // Card 2: English proficiency (scoped to same filter)
    const yes = scoped.filter(d => d.has_english).length;
    document.getElementById('statEnglishPct').textContent = pctOf(yes, scoped.length);
    document.getElementById('statEnglishYes').textContent = yes;
    document.getElementById('statEnglishNo').textContent = scoped.length - yes;
  }

  function computeWeekAndPending() {
    // These two cards always reflect "right now", independent of the Card 1 filter.
    const now = new Date();
    const startThis = new Date(now); startThis.setUTCDate(now.getUTCDate() - 7);
    const startLast = new Date(now); startLast.setUTCDate(now.getUTCDate() - 14);
    const parseDate = (s) => new Date((s || '').replace(' ', 'T') + 'Z');

    const thisWeek = dataset.filter(d => parseDate(d.created_at) >= startThis).length;
    const lastWeek = dataset.filter(d => {
      const t = parseDate(d.created_at);
      return t >= startLast && t < startThis;
    }).length;

    document.getElementById('statWeek').textContent = thisWeek;
    const trendEl = document.getElementById('statWeekTrend');
    if (lastWeek === 0) {
      trendEl.innerHTML = thisWeek > 0
        ? '<span class="text-emerald-600">New activity</span><span class="text-slate-400 font-normal">&nbsp;vs last week</span>'
        : '<span class="text-slate-400 font-normal">No applications last week either</span>';
    } else {
      const diff = Math.round(((thisWeek - lastWeek) / lastWeek) * 100);
      const up = diff >= 0;
      trendEl.innerHTML =
        '<svg class="w-3 h-3 ' + (up ? 'text-emerald-600' : 'text-sunrise-600') + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">' +
          (up ? '<path d="M7 17 17 7M7 7h10v10"/>' : '<path d="m7 7 10 10M17 7v10H7"/>') +
        '</svg>' +
        '<span class="' + (up ? 'text-emerald-600' : 'text-sunrise-600') + '">' + Math.abs(diff) + '%</span>' +
        '<span class="text-slate-400 font-normal">&nbsp;vs last week</span>';
    }

    const pending = dataset.filter(d => (d.status || 'new') === 'new').length;
    document.getElementById('statPending').textContent = pending;
  }

  document.getElementById('cardMonthFilter').addEventListener('change', (e) => computeCards(e.target.value));
  computeCards('');
  computeWeekAndPending();

  // Search
  function refreshVisibleCount() {
    const visible = document.querySelectorAll('.app-row:not([style*="display: none"])').length;
    document.getElementById('tableCount').textContent = '(' + visible + ')';
    document.getElementById('appsNoMatch').classList.toggle('hidden', visible !== 0);
  }
  document.getElementById('appsSearch').addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    document.querySelectorAll('.app-row').forEach(row => {
      row.style.display = row.dataset.search.includes(q) ? '' : 'none';
    });
    refreshVisibleCount();
  });

  // "View pending" quick filter on card 4
  document.getElementById('pendingFilterBtn').addEventListener('click', () => {
    document.getElementById('appsSearch').value = '';
    document.querySelectorAll('.app-row').forEach(row => {
      row.style.display = row.dataset.status === 'new' ? '' : 'none';
    });
    refreshVisibleCount();
    document.getElementById('appsTableCard').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  // ---------------------------------------------------------------
  // Profile panel: full-screen view opened from "View Profile"
  // ---------------------------------------------------------------
  (function () {
    const AVATAR_CLASSES = ['badge-purple', 'badge-pink', 'badge-blue', 'badge-teal'];
    const STAGES = [
      { key: 'new', label: 'Received' },
      { key: 'contacted', label: 'Contacted' },
      { key: 'reviewing', label: 'Reviewing' },
      { key: 'decision', label: 'Decision' },
    ];
    const COMPLETENESS_FIELDS = [
      'phone', 'email', 'dob', 'gender', 'residence_country', 'residence_city', 'address',
      'degree_level', 'institute_name', 'course_studied', 'graduation_year',
      'english_test', 'preferred_study_level', 'subject_interested', 'destination_country', 'intake_month',
    ];

    const panel = document.getElementById('profilePanel');
    const backdrop = document.getElementById('profileBackdrop');

    function initials(name) {
      const parts = (name || '').trim().split(/\s+/).filter(Boolean);
      if (parts.length === 0) return '?';
      return (parts[0][0] + (parts[1]?.[0] || '')).toUpperCase();
    }
    function avatarClass(id) {
      return AVATAR_CLASSES[id % AVATAR_CLASSES.length];
    }

    function renderStages(status) {
      const activeIdx = Math.max(0, STAGES.findIndex(s => s.key === (status || 'new').toLowerCase()));
      const wrap = document.getElementById('ppStages');
      wrap.innerHTML = '';
      STAGES.forEach((stage, i) => {
        const done = i <= activeIdx;
        const step = document.createElement('div');
        step.className = 'flex-1 flex flex-col items-center text-center relative';
        step.innerHTML =
          (i > 0 ? '<span class="absolute top-3.5 right-1/2 w-full h-0.5 ' + (i <= activeIdx ? 'bg-iris-500' : 'bg-slate-100') + '" style="z-index:0;"></span>' : '') +
          '<span class="relative w-7 h-7 rounded-full flex items-center justify-center text-[11px] font-bold ' +
            (done ? 'bg-iris-600 text-white' : 'bg-slate-100 text-slate-400') + '" style="z-index:1;">' +
            (done ? '✓' : (i + 1)) +
          '</span>' +
          '<span class="mt-2 text-xs font-medium ' + (done ? 'text-bridge-950' : 'text-slate-400') + '">' + stage.label + '</span>';
        wrap.appendChild(step);
      });
    }

    function renderCompleteness(app) {
      const filled = COMPLETENESS_FIELDS.filter(f => app[f] && String(app[f]).trim()).length;
      const pct = Math.round((filled / COMPLETENESS_FIELDS.length) * 100);
      document.getElementById('ppCompletenessPct').textContent = pct + '%';
      document.getElementById('ppCompletenessBar').style.width = pct + '%';
      document.getElementById('ppCompletenessBar').className =
        'h-full rounded-full transition-all ' + (pct >= 70 ? 'bg-emerald-500' : pct >= 40 ? 'bg-amber-500' : 'bg-sunrise-600');
    }

    function set(id, value) {
      document.getElementById(id).textContent = (value && String(value).trim()) ? value : '—';
    }

    function renderDocuments(app) {
      const docMap = [
        ['doc_academic_cert', 'Academic Certificate'],
        ['doc_transcript', 'Transcript'],
        ['doc_english_cert', 'English Certificate'],
        ['doc_cv', 'CV / Resume'],
        ['doc_personal_statement', 'Personal Statement'],
      ];
      const wrap = document.getElementById('ppDocsList');
      wrap.innerHTML = '';
      let any = false;
      docMap.forEach(([key, label]) => {
        const url = app[key];
        if (!url) return;
        any = true;
        const a = document.createElement('a');
        a.href = url; a.target = '_blank'; a.rel = 'noopener';
        a.className = 'card-soft ring-1 ring-black/5 rounded-2xl p-4 flex items-center gap-3 hover:bg-slate-50 transition';
        a.innerHTML =
          '<span class="w-10 h-10 rounded-xl bg-iris-50 flex items-center justify-center shrink-0 text-lg">📄</span>' +
          '<span class="min-w-0"><span class="block text-sm font-semibold text-bridge-950 truncate">' + label + '</span>' +
          '<span class="block text-xs text-iris-700 mt-0.5">View file →</span></span>';
        wrap.appendChild(a);
      });
      document.getElementById('ppDocsEmpty').classList.toggle('hidden', any);
    }

    function fillProfile(app) {
      document.getElementById('ppAvatar').textContent = initials(app.name);
      document.getElementById('ppAvatar').className = 'w-14 h-14 rounded-full flex items-center justify-center text-lg font-bold text-white shrink-0 ' + avatarClass(app.id);
      set('ppName', app.name);
      document.getElementById('ppAppId').textContent = app.app_id;

      document.getElementById('ppCountryTag').textContent = app.destination_country ? '🎓 ' + app.destination_country : 'Country not specified';
      document.getElementById('ppDateTag').textContent = 'Received ' + app.date_only;
      const englishTag = document.getElementById('ppEnglishTag');
      englishTag.textContent = app.has_english ? 'English: Yes' : 'English: No';
      englishTag.className = 'inline-flex items-center gap-1 text-xs font-semibold px-2.5 py-1 rounded-full ' +
        (app.has_english ? 'bg-emerald-50 text-emerald-700' : 'bg-sunrise-50 text-sunrise-700');

      document.getElementById('ppCallBtn').href = app.phone ? ('tel:' + app.phone) : '#';
      document.getElementById('ppEmailBtn').href = app.email ? ('mailto:' + app.email) : '#';

      renderStages(app.status);
      renderCompleteness(app);

      set('ppDestination', app.destination_country);
      set('ppPreferredLevel', app.preferred_study_level);
      set('ppSubject', app.subject_interested);
      set('ppIntake', [app.intake_month, app.intake_year].filter(Boolean).join(' '));

      set('ppDegree', app.degree_level);
      set('ppInstitute', app.institute_name);
      set('ppCourse', app.course_studied);
      set('ppGraduation', app.graduation_year);
      set('ppEnglish', app.english_test);
      set('ppScore', app.test_score);

      set('ppEmail', app.email);
      set('ppPhone', app.phone);
      set('ppGender', app.gender);
      set('ppDob', app.dob);
      set('ppResidence', app.residence_country);
      set('ppResidenceCity', app.residence_city);
      set('ppAddress', app.address);

      renderDocuments(app);

      // Always land back on the Application tab when opening a fresh profile.
      document.querySelectorAll('.pp-tab-btn').forEach(b => b.classList.remove('pp-tab-active'));
      document.querySelector('.pp-tab-btn[data-tab="overview"]')?.classList.add('pp-tab-active');
      document.getElementById('ppTabOverview').classList.remove('hidden');
      document.getElementById('ppTabDocuments').classList.add('hidden');
      panel.querySelector('.overflow-y-auto')?.scrollTo(0, 0);
    }

    function openProfile(index) {
      const app = dataset[index];
      if (!app) return;
      fillProfile(app);

      panel.classList.remove('hidden');
      backdrop.classList.remove('hidden');
      // Force layout so the transition actually runs instead of jump-cutting.
      void panel.offsetWidth;
      panel.classList.remove('translate-x-full');
      backdrop.classList.remove('opacity-0');
    }

    function closeProfile() {
      panel.classList.add('translate-x-full');
      backdrop.classList.add('opacity-0');
      setTimeout(() => {
        panel.classList.add('hidden');
        backdrop.classList.add('hidden');
      }, 300);
    }

    // Tabs
    document.querySelectorAll('.pp-tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.pp-tab-btn').forEach(b => b.classList.remove('pp-tab-active'));
        btn.classList.add('pp-tab-active');
        const target = btn.dataset.tab;
        document.getElementById('ppTabOverview').classList.toggle('hidden', target !== 'overview');
        document.getElementById('ppTabDocuments').classList.toggle('hidden', target !== 'documents');
      });
    });

    document.querySelectorAll('.view-profile-btn').forEach(btn => {
      btn.addEventListener('click', () => openProfile(Number(btn.dataset.index)));
    });
    document.getElementById('profilePanelClose').addEventListener('click', closeProfile);
    backdrop.addEventListener('click', closeProfile);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.classList.contains('hidden')) closeProfile();
    });
  })();
</script>
