---
import AdminLayout from '../../layouts/AdminLayout.astro';
export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const { results } = await db.prepare(
  "SELECT * FROM leads WHERE source_page = 'apply-now' ORDER BY created_at DESC LIMIT 200"
).all();
const applications = results as any[];
---
<AdminLayout title="Applications" active="applications">
  <h1 class="text-2xl font-bold text-bridge-950">Applications</h1>
  <p class="text-slate-500 mt-1 text-sm">Submissions from the Apply Now form.</p>

  <div class="mt-8 card-soft rounded-2xl ring-1 ring-black/5 shadow-sm overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-xs text-slate-500 border-b border-slate-100">
          <th class="px-4 py-3 font-medium">Name</th>
          <th class="px-4 py-3 font-medium">Contact</th>
          <th class="px-4 py-3 font-medium">Location</th>
          <th class="px-4 py-3 font-medium">Date</th>
        </tr>
      </thead>
      <tbody>
        {applications.map((l: any) => (
          <tr class="border-b border-slate-50 hover:bg-slate-50/50">
            <td class="px-4 py-3 font-medium text-bridge-950">{l.name || '—'}</td>
            <td class="px-4 py-3 text-slate-600">{l.email}<br/><span class="text-xs text-slate-400">{l.phone}</span></td>
            <td class="px-4 py-3 text-slate-500 text-xs">{l.city}{l.city && l.country ? ', ' : ''}{l.country}</td>
            <td class="px-4 py-3 text-slate-400 text-xs whitespace-nowrap">{l.created_at}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {applications.length === 0 && <p class="text-slate-500 text-sm p-6">No applications yet — they'll show up here once someone submits the Apply Now form.</p>}
  </div>
</AdminLayout>
