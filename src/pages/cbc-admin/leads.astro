---
import AdminLayout from '../../layouts/AdminLayout.astro';
export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const { results } = await db.prepare(
  "SELECT * FROM leads WHERE source_page = 'free-consultation' ORDER BY created_at DESC LIMIT 200"
).all();
const leads = results as any[];

// City-wise lead counts (from detected visitor location)
const cityCounts = new Map<string, number>();
for (const l of leads) {
  const city = (l.city || '').trim();
  if (!city) continue;
  cityCounts.set(city, (cityCounts.get(city) || 0) + 1);
}
const cityStats = Array.from(cityCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);

const cardColors = ['bg-iris-500', 'bg-sunrise-500', 'bg-emerald-500', 'bg-amber-500', 'bg-sky-500', 'bg-pink-500', 'bg-teal-500', 'bg-violet-500'];

function dateOnly(ts: string) {
  return (ts || '').split(' ')[0] || '—';
}
function timeOnly(ts: string) {
  return (ts || '').split(' ')[1] || '—';
}
---
<AdminLayout title="Leads" active="leads">
  <h1 class="text-2xl font-bold text-bridge-950">Leads</h1>
  <p class="text-slate-500 mt-1 text-sm">Submissions from the Free Consultation form.</p>

  <!-- City-wise lead count blocks -->
  {cityStats.length > 0 && (
    <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-8 gap-3">
      {cityStats.map(([city, count], i) => (
        <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-4">
          <div class="flex items-start justify-between">
            <p class="text-xs text-slate-400 font-medium">{city}</p>
            <span class={`w-7 h-7 rounded-lg ${cardColors[i % cardColors.length]} flex items-center justify-center shrink-0`}>
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            </span>
          </div>
          <p class="text-2xl font-bold text-bridge-950 mt-2">{count}</p>
          <p class="text-[11px] text-slate-400 mt-0.5">lead{count !== 1 ? 's' : ''}</p>
        </div>
      ))}
    </div>
  )}

  <!-- Leads table -->
  <div class="mt-6 card-soft rounded-2xl ring-1 ring-black/5 shadow-sm overflow-hidden">
    <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100">
      <p class="font-semibold text-bridge-950 text-sm">All Leads <span class="text-slate-400 font-normal">({leads.length})</span></p>
      <div class="relative">
        <input id="leadsSearch" type="text" placeholder="Search leads"
          class="w-56 bg-slate-50 border border-transparent rounded-full pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-iris-200 focus:bg-white transition">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-slate-500 border-b border-slate-100 bg-slate-50/50">
            <th class="px-5 py-3 font-medium whitespace-nowrap">#</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">Name</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">Phone</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">Email</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">Completed Degree</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">Test Score</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">English Test</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">Subject Interested</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">Destination</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap">Date</th>
            <th class="px-5 py-3 font-medium whitespace-nowrap"></th>
          </tr>
        </thead>
        <tbody id="leadsTableBody">
          {leads.map((l: any, idx: number) => (
            <tr class="lead-row border-b border-slate-50 hover:bg-slate-50/50 transition" data-search={`${l.name} ${l.email} ${l.phone}`.toLowerCase()}>
              <td class="px-5 py-3.5 text-slate-400 whitespace-nowrap">{idx + 1}</td>
              <td class="px-5 py-3.5 font-semibold text-bridge-950 whitespace-nowrap">{l.name || '—'}</td>
              <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap">{l.phone || '—'}</td>
              <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap">{l.email || '—'}</td>
              <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap">{l.degree_level || '—'}</td>
              <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap">{l.test_score || '—'}</td>
              <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap">{l.english_test || '—'}</td>
              <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap">{l.subject_interested || '—'}</td>
              <td class="px-5 py-3.5 text-slate-600 whitespace-nowrap">{l.destination_country || '—'}</td>
              <td class="px-5 py-3.5 text-slate-400 text-xs whitespace-nowrap">{dateOnly(l.created_at)}</td>
              <td class="px-5 py-3.5 whitespace-nowrap">
                <button type="button" class="advance-view-btn text-xs font-semibold text-iris-700 bg-iris-50 hover:bg-iris-100 rounded-full px-3 py-1.5 transition"
                  data-name={l.name || '—'}
                  data-phone={l.phone || '—'}
                  data-email={l.email || '—'}
                  data-degree={l.degree_level || '—'}
                  data-score={l.test_score || '—'}
                  data-english={l.english_test || '—'}
                  data-subject={l.subject_interested || '—'}
                  data-destination={l.destination_country || '—'}
                  data-residence={l.residence_country || '—'}
                  data-date={dateOnly(l.created_at)}
                  data-time={timeOnly(l.created_at)}
                  data-city={l.city || '—'}
                  data-country={l.country || '—'}
                  data-ip={l.ip || '—'}
                >View Advance</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {leads.length === 0 && <p class="text-slate-400 text-sm p-8 text-center">No leads yet — they'll show up here once someone submits the Free Consultation form.</p>}
    </div>
  </div>

  <!-- Advance View modal -->
  <div id="advanceModal" class="hidden fixed inset-0 bg-black/40 z-50 flex items-center justify-center px-4 py-8 overflow-y-auto">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg my-auto overflow-hidden">
      <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
        <p class="font-semibold text-bridge-950">Lead Details</p>
        <button type="button" id="advanceModalClose" class="w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:bg-slate-100 transition">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="p-6 grid grid-cols-2 gap-x-5 gap-y-3.5 text-sm max-h-[70vh] overflow-y-auto">
        <div><p class="text-xs text-slate-400">Name</p><p id="mName" class="font-semibold text-bridge-950 mt-0.5"></p></div>
        <div><p class="text-xs text-slate-400">Phone</p><p id="mPhone" class="font-medium text-slate-700 mt-0.5"></p></div>
        <div><p class="text-xs text-slate-400">Email</p><p id="mEmail" class="font-medium text-slate-700 mt-0.5"></p></div>
        <div><p class="text-xs text-slate-400">Residence</p><p id="mResidence" class="font-medium text-slate-700 mt-0.5"></p></div>
        <div><p class="text-xs text-slate-400">Completed Degree</p><p id="mDegree" class="font-medium text-slate-700 mt-0.5"></p></div>
        <div><p class="text-xs text-slate-400">Test Score</p><p id="mScore" class="font-medium text-slate-700 mt-0.5"></p></div>
        <div><p class="text-xs text-slate-400">English Test</p><p id="mEnglish" class="font-medium text-slate-700 mt-0.5"></p></div>
        <div><p class="text-xs text-slate-400">Subject Interested</p><p id="mSubject" class="font-medium text-slate-700 mt-0.5"></p></div>
        <div><p class="text-xs text-slate-400">Destination</p><p id="mDestination" class="font-medium text-slate-700 mt-0.5"></p></div>
        <div><p class="text-xs text-slate-400">Date</p><p id="mDate" class="font-medium text-slate-700 mt-0.5"></p></div>

        <div class="col-span-2 mt-1 pt-3 border-t border-slate-100">
          <p class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Advance Info</p>
        </div>
        <div><p class="text-xs text-slate-400">Submitted Time</p><p id="mTime" class="font-medium text-slate-700 mt-0.5"></p></div>
        <div><p class="text-xs text-slate-400">Detected Location</p><p id="mLocation" class="font-medium text-slate-700 mt-0.5"></p></div>
        <div class="col-span-2"><p class="text-xs text-slate-400">IP Address</p><p id="mIp" class="font-medium text-slate-700 mt-0.5 font-mono"></p></div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .advance-view-btn { white-space: nowrap; }
</style>

<script is:inline>
  document.getElementById('leadsSearch')?.addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase();
    document.querySelectorAll('.lead-row').forEach(row => {
      row.style.display = row.dataset.search.includes(q) ? '' : 'none';
    });
  });

  const modal = document.getElementById('advanceModal');
  document.querySelectorAll('.advance-view-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const d = btn.dataset;
      document.getElementById('mName').textContent = d.name;
      document.getElementById('mPhone').textContent = d.phone;
      document.getElementById('mEmail').textContent = d.email;
      document.getElementById('mResidence').textContent = d.residence;
      document.getElementById('mDegree').textContent = d.degree;
      document.getElementById('mScore').textContent = d.score;
      document.getElementById('mEnglish').textContent = d.english;
      document.getElementById('mSubject').textContent = d.subject;
      document.getElementById('mDestination').textContent = d.destination;
      document.getElementById('mDate').textContent = d.date;
      document.getElementById('mTime').textContent = d.time;
      document.getElementById('mLocation').textContent = [d.city, d.country].filter(v => v && v !== '—').join(', ') || '—';
      document.getElementById('mIp').textContent = d.ip;
      modal.classList.remove('hidden');
    });
  });
  document.getElementById('advanceModalClose').addEventListener('click', () => modal.classList.add('hidden'));
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });
</script>
