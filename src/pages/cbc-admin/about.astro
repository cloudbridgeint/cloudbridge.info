---
/*
 * The About page, laid out in the order a visitor meets it: banner first,
 * closing call to action last. Each section says what it controls, and a list
 * sits inside the section it belongs to rather than in a separate pile at the
 * bottom — the previous layout put the "Key Skills" heading in one place and
 * the skills themselves several screens below.
 */
import AdminLayout from '../../layouts/AdminLayout.astro';
import ContentSections from '../../components/admin/ContentSections.astro';
import type { Section } from '../../components/admin/ContentSections.astro';

import content_fieldsUrl from '../../scripts/admin-content-fields.js?url';
import list_editorUrl from '../../scripts/admin-list-editor.js?url';

export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const { results } = await db.prepare('SELECT key, value FROM content WHERE key LIKE ?').bind('about.%').all();
const cm: Record<string, string> = {};
for (const row of results as any[]) cm[row.key] = row.value;

const sections: Section[] = [
  {
    title: 'Top banner',
    description: 'The dark blue band at the very top of the page.',
    fields: [
      { key: 'about.hero.badge', label: 'Small badge above the heading', default: 'About CloudBridge' },
      { key: 'about.hero.heading', label: 'Main heading', help: 'The biggest line on the page. Google uses it too, so say what the page is about.', default: 'Your partner from application to arrival' },
      { key: 'about.hero.text', label: 'Intro line', type: 'textarea', rows: 2, default: 'Cloud Bridge — International Student Consultancy (CBC) has been guiding Bangladeshi students to universities abroad since 2019.' },
    ],
  },
  {
    title: 'About Cloud Bridge',
    description: 'Picture on the left, three paragraphs on the right.',
    fields: [
      { key: 'about.intro.heading', label: 'Heading', default: 'About Cloud Bridge (CBC)' },
      { key: 'about.intro.p1', label: 'Paragraph 1', type: 'textarea', rows: 4, default: "Cloud Bridge — International Student Consultancy (CBC) is a study-abroad consultancy committed to helping ambitious Bangladeshi students reach the right university, in the right country, without the guesswork. We believe access to quality international education shouldn't depend on who you already know." },
      { key: 'about.intro.p2', label: 'Paragraph 2', type: 'textarea', rows: 4, default: "We follow ethical counselling practices in line with recognised international education standards — honest advice, no hidden costs, and no pressure to choose a university just because it pays the highest commission. Integrity, transparency, and respect for every student's goals sit behind every recommendation we make." },
      { key: 'about.intro.p3', label: 'Paragraph 3', type: 'textarea', rows: 3, default: 'Since 2019, CBC has grown from a single Dhaka office into a team spanning Dhaka and Sylhet, supporting students across 10 countries — from first shortlisting a course to settling into life abroad.' },
      { key: 'about.intro.image', label: 'Photograph', type: 'image', fallback: '/assets/logo.png', help: 'Leave empty to keep the plain blue panel that is there now. A wide photo works best.' },
      { key: 'about.intro.image_alt', label: 'Describe the photograph', help: 'Read aloud to blind visitors, and used by Google image search.', default: 'The CloudBridge team at work' },
    ],
  },
  {
    title: 'Our Mission',
    description: 'Text on the left, picture on the right.',
    fields: [
      { key: 'about.mission.heading', label: 'Heading', default: 'Our Mission' },
      { key: 'about.mission.p1', label: 'Paragraph 1', type: 'textarea', rows: 3, default: 'Our mission is to guide students toward academic excellence and a career path that actually fits them — through free, personalised counselling from day one.' },
      { key: 'about.mission.p2', label: 'Paragraph 2', type: 'textarea', rows: 4, default: "We help students understand entry requirements, realistic tuition and living costs, and scholarship options for their destination — then match them honestly to courses they're genuinely qualified for, not just the ones easiest for us to sell." },
      { key: 'about.mission.p3', label: 'Paragraph 3', type: 'textarea', rows: 3, default: 'Every student works with a dedicated counsellor who stays with them through the entire process — application, visa, and beyond.' },
      { key: 'about.mission.image', label: 'Photograph', type: 'image', fallback: '/assets/logo.png', help: 'Leave empty to keep the plain red panel.' },
      { key: 'about.mission.image_alt', label: 'Describe the photograph', default: 'A counsellor advising a student' },
    ],
  },
  {
    title: 'Our Vision',
    description: 'Picture on the left, two paragraphs on the right.',
    fields: [
      { key: 'about.vision.heading', label: 'Heading', default: 'Our Vision' },
      { key: 'about.vision.p1', label: 'Paragraph 1', type: 'textarea', rows: 3, default: 'Our vision is to be the education consultancy Bangladeshi students trust first — recognised not for the loudest marketing, but for consistently getting students into universities that are genuinely right for them.' },
      { key: 'about.vision.p2', label: 'Paragraph 2', type: 'textarea', rows: 4, default: "We're working toward a future where every aspiring student, in Dhaka, Sylhet, or beyond, can access the same quality of guidance without traveling far or paying a taka in consultancy fees — with a growing office network and a digital-first application process that removes friction at every step." },
      { key: 'about.vision.image', label: 'Photograph', type: 'image', fallback: '/assets/logo.png', help: 'Leave empty to keep the plain green panel.' },
      { key: 'about.vision.image_alt', label: 'Describe the photograph', default: 'Students on campus abroad' },
    ],
  },
  {
    title: 'Coloured banner with two buttons',
    description: 'The navy-to-red band halfway down the page.',
    fields: [
      { key: 'about.band.label', label: 'Small label', default: '10,000+ Students Served Since 2019' },
      { key: 'about.band.heading', label: 'Heading', default: 'Start Your Journey Today, Achieve More Tomorrow' },
      { key: 'about.band.cta1_label', label: 'Left button — text', default: 'Read Success Stories' },
      { key: 'about.band.cta1_url', label: 'Left button — where it goes', help: 'A page on this site starts with a slash, like /blogs.', default: '/blogs' },
      { key: 'about.band.cta2_label', label: 'Right button — text', default: 'Contact Us' },
      { key: 'about.band.cta2_url', label: 'Right button — where it goes', default: '/contact' },
    ],
  },
  {
    title: 'Key Skills',
    description: 'The grid of small round icons and captions.',
    fields: [
      { key: 'about.skills.heading', label: 'Heading', default: 'Key Skills and Core Competences Gained' },
      { key: 'about.skills.text', label: 'Line under the heading', type: 'textarea', rows: 2, default: 'What students walk away with, beyond just an offer letter.' },
    ],
    list: {
      group: 'about.skills',
      title: 'The skills themselves',
      note: 'Each one shows as an icon with a caption. Pick the icon from the list — that keeps the page consistent and stops broken graphics.',
      fields: ['title', 'icon'],
      labels: { title: 'Skill' },
    },
  },
  {
    title: 'Reasons to Choose Us',
    description: 'The white box of ticked lines.',
    fields: [
      { key: 'about.reasons.heading', label: 'Heading', default: 'Six Reasons to Choose Us' },
      { key: 'about.reasons.text', label: 'Line under the heading', type: 'textarea', rows: 2, default: "We're committed to supporting you at every step of your journey, from first shortlist to settling in abroad." },
    ],
    list: {
      group: 'about.reasons',
      title: 'The reasons',
      note: 'Choosing any colour makes that line bold — the last line uses this today. Leave it on Default for a normal line.',
      fields: ['title', 'accent'],
      labels: { title: 'Reason', accent: 'Emphasis' },
    },
  },
  {
    title: 'Company History',
    description: 'The dated timeline running down the page.',
    note: 'These milestones were written as examples when the page was first built. Put your real dates in, or delete the ones that are not true — the page presents them to students as fact.',
    fields: [
      { key: 'about.history.heading', label: 'Heading', default: 'Our Company History' },
      { key: 'about.history.text', label: 'Line under the heading', type: 'textarea', rows: 2, help: 'Leave empty to show nothing here.', default: '' },
    ],
    list: {
      group: 'about.history',
      title: 'Milestones',
      note: 'They alternate left and right down the timeline automatically, in the order shown here.',
      fields: ['subtitle', 'title', 'body'],
      labels: { subtitle: 'Year', title: 'What happened', body: 'Details' },
    },
  },
  {
    title: 'Team section',
    description: 'The heading above the sliding team photos, and the team itself.',
    note: 'This list is shared with the Our Team page — group key team.members — so a person edited here also updates there.',
    fields: [
      { key: 'about.team.heading', label: 'Heading', default: 'Our Team Members' },
      { key: 'about.team.text', label: 'Line under the heading', type: 'textarea', rows: 2, default: 'The counsellors and staff behind every successful application.' },
    ],
    list: {
      group: 'team.members',
      title: 'Team members',
      note: 'Photo: upload one, or leave it blank to show a plain silhouette (used for two people currently). Label: their role. Text: their branch — shown as a link on this page, plain text on Our Team. Link text: reused here for an ID number, shown under the role.',
      fields: ['icon', 'title', 'subtitle', 'body', 'link_label'],
      labels: { icon: 'Photo', title: 'Name', subtitle: 'Role', body: 'Branch', link_label: 'ID number' },
    },
  },
  {
    title: 'Closing call to action',
    description: 'The last band on the page, above the footer.',
    fields: [
      { key: 'about.cta.heading', label: 'Heading', default: 'Ready to start your journey?' },
      { key: 'about.cta.label', label: 'Button text', default: 'Talk to a Counsellor' },
      { key: 'about.cta.url', label: 'Where the button goes', default: '/contact' },
    ],
  },
  {
    title: 'Google search result',
    description: 'Not on the page itself — this is the title and grey text people see in Google.',
    fields: [
      { key: 'about.meta_title', label: 'Title in Google', help: 'Around 60 characters. Longer than that and Google cuts it off mid-word.', default: 'About Us | CloudBridge Study Abroad Consultancy' },
      { key: 'about.meta_description', label: 'Description in Google', type: 'textarea', rows: 3, help: 'Around 155 characters. Write it as a reason to click, not a summary.', default: 'Learn how CloudBridge supports students from university shortlisting to visa approval, with expert counsellors guiding every step abroad.' },
    ],
  },
];
---
<AdminLayout title="About Page" active="about">
  <div class="flex items-start justify-between gap-4 flex-wrap mb-2">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">About Page</h1>
      <p class="text-slate-500 mt-1 text-sm max-w-2xl">
        The sections below run in the same order as the page itself — top of the page first.
        Change what you need, then press Save once at the bottom.
      </p>
    </div>
    <a href="/about" target="_blank" rel="noopener"
       class="shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">
      View the live page ↗
    </a>
  </div>

  <div class="mt-6 pb-24">
    <ContentSections sections={sections} values={cm} />
  </div>

  <!-- One Save for the whole screen: text, images and lists together. -->
  <div class="sticky bottom-0 -mx-5 md:-mx-9 px-5 md:px-9 py-4 bg-white/90 backdrop-blur border-t border-slate-200 flex items-center justify-end gap-4">
    <span id="saveHint" class="text-xs text-slate-400">All changes saved</span>
    <button id="saveContentBtn"
            class="bg-sunrise-600 hover:bg-sunrise-700 text-white font-semibold rounded-xl px-7 py-3 shadow-lg transition">
      Save changes
    </button>
  </div>
</AdminLayout>

<script src={content_fieldsUrl} is:inline></script>
<script src={list_editorUrl} is:inline></script>
