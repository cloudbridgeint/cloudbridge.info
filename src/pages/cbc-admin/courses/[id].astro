---
/*
 * The course page editor, at /cbc-admin/courses/<id>.
 *
 * Written for counsellors rather than for whoever built it. That drives three
 * choices:
 *
 * - There is no publish button. A page appears on the site when the three
 *   boxes marked "needed" have been filled in, and disappears if they are
 *   emptied. One less concept, and no way to put an empty page online.
 * - The URL slug is behind "Advanced settings", closed. It is generated, it is
 *   almost never the right thing to change, and changing it after a page is
 *   live breaks links.
 * - Every box says what goes in it and shows a real example, because the
 *   alternative is someone being walked through it once and then guessing.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import course_editorUrl from '../../../scripts/admin-course-editor.js?url';

export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const row = await db.prepare('SELECT * FROM courses WHERE id = ?').bind(Astro.params.id).first();
if (!row) return Astro.redirect('/cbc-admin/courses');

const uni = await db
  .prepare('SELECT slug FROM university_directory WHERE name = ? AND active = 1')
  .bind(row.university).first();
const liveUrl = uni?.slug && row.slug ? `/courses/${uni.slug}/${row.slug}` : '';

const NEEDED = [
  { id: 'overview', label: 'About this course', rows: 8,
    help: 'Two or three short paragraphs: what the course covers, who it suits, anything that makes it stand out. Leave a blank line between paragraphs.',
    eg: 'Aston\u2019s BSc Biomedical Science is built around what a hospital pathology laboratory actually does\u2026' },
  { id: 'entry_requirements', label: 'Entry requirements', rows: 6,
    help: 'What grades a student needs. Write one per line — press Enter between them.',
    eg: 'A-levels: BCC \u2013 CCD\nBTEC: DDM\nUCAS code C900' },
];

const EXTRA = [
  { id: 'english_requirements', label: 'English requirements', rows: 4,
    help: 'IELTS, TOEFL or PTE scores. One per line. If the score is the university\u2019s general one rather than this course\u2019s, say so.',
    eg: 'IELTS 6.5 overall with a minimum of 6.0 in each band' },
  { id: 'tuition_note', label: 'Notes about the fee', rows: 4,
    help: 'Anything a student should know about the money — placement year cost, whether it rises each year.',
    eg: 'The placement year is charged separately at \u00a32,500.' },
  { id: 'scholarships_info', label: 'Scholarships', rows: 4,
    help: 'Scholarships available for this course. One per line.',
    eg: 'International Excellence Scholarship \u2014 up to \u00a34,000' },
  { id: 'modules', label: 'What the student will study', rows: 8,
    help: 'The subjects taught, one per line.',
    eg: 'Year 1 \u2014 Biomolecules (30 credits)\nYear 1 \u2014 Cells to Systems (30 credits)' },
  { id: 'careers', label: 'Jobs after this course', rows: 5,
    help: 'One job per line.',
    eg: 'Biomedical Scientist (NHS)\nPharmaceutical industry' },
  { id: 'how_to_apply', label: 'How to apply', rows: 6,
    help: 'The steps, in order, one per line. They appear numbered on the page.',
    eg: 'Talk to a CloudBridge counsellor and get your transcripts checked' },
  { id: 'faq', label: 'Common questions', rows: 6,
    help: 'One per line. Put the question, then the | key, then the answer. These also show up in Google.',
    eg: 'Is the placement year guaranteed? | No. Placements are limited and competitive.' },
];
---
<AdminLayout title={`Edit — ${row.name}`} active="courses">
  <nav class="text-sm text-slate-500 mb-2">
    <a href="/cbc-admin/courses" class="hover:text-bridge-700 hover:underline">Courses</a>
    <span class="mx-1.5 text-slate-300">/</span>
    <span class="text-slate-700 font-medium">{row.name}</span>
  </nav>
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-2xl font-bold text-slate-900">{row.name}</h1>
      <p class="text-slate-500 mt-1 text-sm">{row.university}{row.city ? ` — ${row.city}` : ''}</p>
    </div>
    {liveUrl && (
      <a id="viewLive" href={liveUrl} target="_blank" rel="noopener"
         class:list={['shrink-0 inline-flex items-center gap-1.5 rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50',
           row.published ? '' : 'hidden']}>
        See this page ↗
      </a>
    )}
  </div>

  <!-- The status of the page, in a sentence, at the top where it is read. -->
  <div id="statusBox" class="mt-5 rounded-2xl px-5 py-4 ring-1"></div>

  <form id="courseForm" data-id={row.id} data-liveurl={liveUrl} class="mt-6 space-y-6">

    <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-6 space-y-6">
      <div>
        <p class="font-semibold text-bridge-950">Needed for the page to go on the site</p>
        <p class="text-sm text-slate-500 mt-1">Fill in these three and the page appears. Leave any empty and it stays off.</p>
      </div>

      {NEEDED.map((b, i) => (
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">
            <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-bridge-700 text-white text-xs mr-2">{i + 1}</span>
            {b.label}
          </label>
          <p class="text-xs text-slate-500 mb-2 ml-7">{b.help}</p>
          <textarea id={`f_${b.id}`} rows={b.rows} data-needed="1"
                    class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm leading-relaxed">{row[b.id] || ''}</textarea>
          <p class="text-xs text-slate-400 mt-1 ml-0.5">Example: <span class="italic">{b.eg.split('\n')[0]}</span></p>
        </div>
      ))}

      <div>
        <label class="block text-sm font-semibold text-slate-700 mb-1">
          <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-bridge-700 text-white text-xs mr-2">3</span>
          Tuition fee for one year
        </label>
        <p class="text-xs text-slate-500 mb-2 ml-7">What an international student pays per year. Copy it exactly from the university's own page.</p>
        <input id="fTuitionFee" value={row.tuition_fee || ''} placeholder="£22,575" data-needed="1"
               class="w-full max-w-xs rounded-lg border border-slate-300 px-3 py-2 text-sm">
      </div>
    </div>

    <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-6 space-y-6">
      <div>
        <p class="font-semibold text-bridge-950">The rest of the page</p>
        <p class="text-sm text-slate-500 mt-1">Optional. Anything left empty is simply left off the page — it will not show a blank heading.</p>
      </div>

      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Award</label>
          <p class="text-xs text-slate-500 mb-2">The qualification given at the end.</p>
          <input id="fCredential" value={row.credential || ''} placeholder="BSc (Hons)"
                 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Intakes</label>
          <p class="text-xs text-slate-500 mb-2">When the course starts. Separate with commas.</p>
          <input id="fIntakes" value={(row.intakes || '').split('\n').join(', ')} placeholder="September 2026, January 2027"
                 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        </div>
      </div>

      {EXTRA.map(b => (
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">{b.label}</label>
          <p class="text-xs text-slate-500 mb-2">{b.help}</p>
          <textarea id={`f_${b.id}`} rows={b.rows}
                    class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm leading-relaxed">{row[b.id] || ''}</textarea>
          <p class="text-xs text-slate-400 mt-1">Example: <span class="italic">{b.eg.split('\n')[0]}</span></p>
        </div>
      ))}
    </div>

    <div class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-6">
      <p class="font-semibold text-bridge-950">Where you got this from</p>
      <p class="text-sm text-slate-500 mt-1">
        Fees and entry requirements change every year, and only the university's own website is reliable —
        other sites get the fee wrong all the time. Both of these show at the bottom of the page so students
        can check for themselves.
      </p>
      <div class="mt-4 grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Link to the university's course page</label>
          <input id="fSourceUrl" value={row.source_url || ''} placeholder="https://www.aston.ac.uk/study/courses/..."
                 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-700 mb-1">Date you checked it</label>
          <input id="fVerified" type="date" value={row.last_verified_at || ''}
                 class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
        </div>
      </div>
    </div>

    <details class="card-soft rounded-2xl ring-1 ring-black/5 shadow-sm p-6">
      <summary class="font-semibold text-bridge-950 cursor-pointer text-sm">Advanced settings</summary>
      <div class="mt-4">
        <label class="block text-sm font-semibold text-slate-700 mb-1">Web address</label>
        <p class="text-xs text-slate-500 mb-2">
          Set automatically from the course name. Only change this if you know why —
          if the page is already on the site, changing it breaks every link to it.
        </p>
        <input id="fSlug" value={row.slug || ''}
               class="w-full max-w-md rounded-lg border border-slate-300 px-3 py-2 text-sm font-mono">
        {liveUrl && <p class="text-xs text-slate-400 mt-1">cloudbridge.info{liveUrl}</p>}
      </div>
    </details>

    <div class="flex items-center gap-3 sticky bottom-0 bg-white/95 backdrop-blur py-4 border-t border-slate-100">
      <button type="button" id="saveBtn"
              class="bg-bridge-700 hover:bg-bridge-800 text-white text-sm font-semibold rounded-lg px-6 py-2.5 transition">
        Save
      </button>
      <a href="/cbc-admin/courses" class="text-sm font-semibold text-slate-500 hover:text-slate-700">Back to courses</a>
      <span id="savedNote" class="text-sm text-green-700 font-semibold hidden">Saved</span>
    </div>
  </form>
</AdminLayout>

<script src={course_editorUrl} is:inline></script>
