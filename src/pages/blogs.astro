---
import Layout from '../layouts/Layout.astro';
import { getPublishedBlogPosts, mediaUrl } from '../lib/content';
export const prerender = false;
const title = "Blogs | CloudBridge Study Abroad";
const description = "Study abroad tips, visa updates, and university guides from the CloudBridge team.";

const db = (Astro.locals as any).runtime.env.DB;
const posts = await getPublishedBlogPosts(db);

// Every article lives at /blogs/<slug>. Six of them used to be linked at
// /<slug> as well, which left search engines choosing between two identical
// pages; those paths now redirect here.
function postHref(slug: string) {
  return `/blogs/${slug}`;
}
---
<Layout title={title} description={description}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / Blogs</p>
    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">Blogs</h1>
    <p class="mt-4 max-w-xl text-white/75">Guidance, tips, and updates for students planning to study abroad.</p>
  </div>
</section>
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    {posts.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((p: any) => (
          <a href={postHref(p.slug)} class="nav-link rounded-2xl border border-black/10 overflow-hidden block bg-white group">
            <div class="h-44 overflow-hidden">
              <img src={mediaUrl(p.hero_image, '/assets/logo.png')} alt={p.title} class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
            </div>
            <div class="p-5">
              {p.category && <p class="text-xs font-semibold uppercase tracking-wide text-sunrise-600">{p.category}</p>}
              <h3 class="mt-1 font-display font-bold text-bridge-900">{p.title}</h3>
              {p.description && <p class="mt-2 text-sm text-ink/60">{p.description}</p>}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-ink/60">No articles published yet — check back soon.</p>
    )}
  </div>
</section>

</Layout>
