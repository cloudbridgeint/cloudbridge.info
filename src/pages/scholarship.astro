---
/*
 * Scholarships. Every heading, paragraph and card on this page is editable in
 * the admin: fixed copy lives in the content table under scholarship.*, the
 * repeating cards live in page_items, and the named awards live in their own
 * scholarships table so the office can publish real funding with deadlines and
 * apply links rather than describing funding in the abstract.
 */
import Layout from '../layouts/Layout.astro';
import { getAllContent, getPageItemGroups, getScholarships, c } from '../lib/content';
import { iconPath, iconImage, accentBar } from '../lib/icons';

export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const [cm, groups, awards] = await Promise.all([
  getAllContent(db),
  getPageItemGroups(db, ['scholarship.types', 'scholarship.steps', 'scholarship.destinations', 'scholarship.faqs']),
  getScholarships(db),
]);
const types = groups['scholarship.types'];
const steps = groups['scholarship.steps'];
const destinations = groups['scholarship.destinations'];
const faqs = groups['scholarship.faqs'];

const title = c(cm, 'scholarship.meta_title', 'Scholarships | CloudBridge Study Abroad');
const description = c(cm, 'scholarship.meta_description', 'Find scholarships at 500+ universities — CloudBridge counsellors match you with funding you actually qualify for.');

/* The named awards feed a FAQ-style rich result only when there is something
   to describe, so an empty list does not publish empty structured data. */
const faqSchema = faqs.length ? [{
  '@type': 'FAQPage',
  '@id': 'https://cloudbridge.info/scholarship#faq',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.title,
    acceptedAnswer: { '@type': 'Answer', text: f.body },
  })),
}] : [];
---
<Layout title={title} description={description} schema={faqSchema}
        breadcrumbs={[{ name: 'Scholarship', url: '/scholarship' }]}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / Scholarship</p>
    <div class="mt-4 grid md:grid-cols-2 gap-8 items-center">
      <div>
        <p class="inline-block mb-4 px-4 py-1 rounded-full border border-white/20 text-sunrise-200 text-sm font-medium">{c(cm, 'scholarship.hero.badge', 'Free Scholarship Guidance')}</p>
        <h1 class="text-3xl md:text-5xl font-extrabold leading-tight">{c(cm, 'scholarship.hero.heading', 'Scholarships at 500+ Universities')}</h1>
        <p class="mt-4 max-w-xl text-white/75">{c(cm, 'scholarship.hero.text', 'Let our counsellors match you with funding you actually qualify for — most students never even check. From merit awards to country-specific grants, we help you find real money for your degree.')}</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={c(cm, 'scholarship.hero.cta1_url', '/#lead-form')} class="btn-primary nav-link inline-flex">{c(cm, 'scholarship.hero.cta1_label', 'Check My Eligibility')}</a>
          <a href={c(cm, 'scholarship.hero.cta2_url', '/contact')} class="btn-secondary nav-link inline-flex">{c(cm, 'scholarship.hero.cta2_label', 'Talk to a Counsellor')}</a>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-4 text-center">
        <div class="bg-white/5 border border-white/10 rounded-2xl px-3 py-5">
          <p class="counter font-display text-3xl font-extrabold text-sunrise-200" data-target={c(cm, 'scholarship.stat1_number', '500')}>0</p>
          <p class="mt-1 text-xs text-white/70">{c(cm, 'scholarship.stat1_label', 'Partner Universities')}</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl px-3 py-5">
          <p class="counter font-display text-3xl font-extrabold text-sunrise-200" data-target={c(cm, 'scholarship.stat2_number', '10000')}>0</p>
          <p class="mt-1 text-xs text-white/70">{c(cm, 'scholarship.stat2_label', 'Students Placed')}</p>
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl px-3 py-5">
          <p class="counter font-display text-3xl font-extrabold text-sunrise-200" data-target={c(cm, 'scholarship.stat3_number', '13')}>0</p>
          <p class="mt-1 text-xs text-white/70">{c(cm, 'scholarship.stat3_label', 'Years of Experience')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

{types.length > 0 && (
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <div class="max-w-xl">
      <h2 class="section-heading">{c(cm, 'scholarship.types.heading', 'Types of Funding')}</h2>
      <p class="mt-3 text-ink/60">{c(cm, 'scholarship.types.text', 'Scholarships and funding come in more forms than most students realise — our counsellors check every option that applies to your profile.')}</p>
    </div>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {types.map(t => (
        <div class="bg-white rounded-2xl p-6 shadow-sm ring-1 ring-black/5">
          <div class="w-11 h-11 rounded-xl bg-bridge-50 flex items-center justify-center overflow-hidden">
            {iconImage(t.icon)
              ? <img src={iconImage(t.icon)} alt="" loading="lazy" class="w-6 h-6 object-contain" />
              : <svg viewBox="0 0 24 24" class="w-5 h-5 text-bridge-700" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconPath(t.icon)} /></svg>}
          </div>
          <h3 class="mt-4 font-display font-bold text-bridge-900">{t.title}</h3>
          <p class="mt-2 text-sm text-ink/60">{t.body}</p>
          {t.subtitle && <span class="course-badge mt-4">{t.subtitle}</span>}
        </div>
      ))}
      <div class="bg-bridge-950 text-white rounded-2xl p-6 shadow-sm flex flex-col justify-between">
        <div>
          <h3 class="font-display font-bold">{c(cm, 'scholarship.types.cta_heading', 'Not sure what you qualify for?')}</h3>
          <p class="mt-2 text-sm text-white/70">{c(cm, 'scholarship.types.cta_text', "Share your academic profile once — we'll check every scholarship route across our partner universities for you, free of charge.")}</p>
        </div>
        <a href={c(cm, 'scholarship.types.cta_url', '/#lead-form')} class="btn-primary nav-link mt-5 inline-flex !bg-[#db1f2a] hover:!bg-[#c01822]">{c(cm, 'scholarship.types.cta_label', 'Get My Free Match')}</a>
      </div>
    </div>
  </div>
</section>
)}

{awards.length > 0 && (
<section class="py-16 bg-white border-y border-black/5">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mx-auto">{c(cm, 'scholarship.list.heading', 'Scholarships Open Now')}</h2>
    <p class="mt-3 text-ink/60 text-center max-w-xl mx-auto">{c(cm, 'scholarship.list.text', 'Named awards our counsellors are currently helping students apply for. Deadlines and amounts are set by the provider — confirm on their own page before you apply.')}</p>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {awards.map(s => (
        <article class="university-card rounded-2xl ring-1 ring-black/5 bg-white overflow-hidden flex flex-col">
          <div class="p-6 flex-1">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-display font-bold text-bridge-900">{s.name}</h3>
              {s.featured === 1 && <span class="shrink-0 rounded-full bg-sunrise-50 text-sunrise-600 text-[11px] font-semibold px-2.5 py-1">Featured</span>}
            </div>
            {s.provider && <p class="mt-1 text-xs text-ink/45">{s.provider}</p>}
            {s.description && <p class="mt-3 text-sm text-ink/60">{s.description}</p>}
            <dl class="mt-4 space-y-1.5 text-sm">
              {s.amount && <div class="flex gap-2"><dt class="text-ink/45 w-24 shrink-0">Amount</dt><dd class="text-ink/75">{s.amount}</dd></div>}
              {s.coverage && <div class="flex gap-2"><dt class="text-ink/45 w-24 shrink-0">Covers</dt><dd class="text-ink/75">{s.coverage}</dd></div>}
              {s.country && <div class="flex gap-2"><dt class="text-ink/45 w-24 shrink-0">Country</dt><dd class="text-ink/75">{s.country}</dd></div>}
              {s.level && <div class="flex gap-2"><dt class="text-ink/45 w-24 shrink-0">Level</dt><dd class="text-ink/75">{s.level}</dd></div>}
              {s.deadline && <div class="flex gap-2"><dt class="text-ink/45 w-24 shrink-0">Deadline</dt><dd class="text-ink/75">{s.deadline}</dd></div>}
            </dl>
            {s.eligibility && <p class="mt-3 text-xs text-ink/50 leading-relaxed">{s.eligibility}</p>}
          </div>
          <div class="px-6 pb-6 flex flex-wrap gap-2">
            <a href="/#lead-form" class="uni-card-btn inline-flex items-center gap-1 text-sm font-semibold text-bridge-800 border border-bridge-800/30 px-4 py-2 nav-link">Check my eligibility</a>
            {s.apply_url && <a href={s.apply_url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-sm font-semibold text-ink/50 hover:text-bridge-800 px-2 py-2">Official page ↗</a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
)}

{steps.length > 0 && (
<section class="py-16 bg-bridge-50/50">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mx-auto">{c(cm, 'scholarship.steps.heading', 'How Scholarship Support Works')}</h2>
    <p class="mt-3 text-ink/60 text-center max-w-xl mx-auto">{c(cm, 'scholarship.steps.text', 'Four simple steps from your first message to a confirmed funding offer.')}</p>

    <div class="mt-12 timeline-wrap max-w-3xl mx-auto">
      <div class="timeline-line"></div>
      {steps.map((s, i) => (
        <div class={`relative pl-12 md:pl-0 md:grid md:grid-cols-2 md:gap-10 ${i === steps.length - 1 ? '' : 'pb-10'}`}>
          <div class="timeline-dot" style="top:0.4rem"></div>
          {i % 2 === 0 ? (
            <>
              <div class="md:text-right md:pr-2">
                <div class="timeline-card inline-block text-left">
                  <span class="timeline-year">{s.subtitle}</span>
                  <h3 class="font-display font-bold text-bridge-900">{s.title}</h3>
                  <p class="mt-1 text-sm text-ink/60">{s.body}</p>
                </div>
              </div>
              <div class="hidden md:block"></div>
            </>
          ) : (
            <>
              <div class="hidden md:block"></div>
              <div class="md:pl-2">
                <div class="timeline-card inline-block text-left">
                  <span class="timeline-year">{s.subtitle}</span>
                  <h3 class="font-display font-bold text-bridge-900">{s.title}</h3>
                  <p class="mt-1 text-sm text-ink/60">{s.body}</p>
                </div>
              </div>
            </>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
)}

{destinations.length > 0 && (
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mx-auto">{c(cm, 'scholarship.destinations.heading', 'Scholarships by Destination')}</h2>
    <p class="mt-3 text-ink/60 text-center max-w-xl mx-auto">{c(cm, 'scholarship.destinations.text', "Funding rules and amounts vary by country — explore what's available where you want to study.")}</p>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {destinations.map(d => (
        <div class="university-card rounded-2xl overflow-hidden ring-1 ring-black/5 bg-white">
          <div class={`h-2 ${accentBar(d.accent)}`}></div>
          <div class="p-6">
            <h3 class="font-display font-bold text-bridge-900">{d.title}</h3>
            <p class="mt-2 text-sm text-ink/60">{d.body}</p>
            {d.link_url && (
              <a href={d.link_url} class="uni-card-btn mt-4 inline-flex items-center gap-1 text-sm font-semibold text-bridge-800 border border-bridge-800/30 px-4 py-2 nav-link">{d.link_label || 'Explore options'} &rarr;</a>
            )}
          </div>
        </div>
      ))}
    </div>
    <div class="mt-10 flex justify-center">
      <a href="/destinations" class="btn-primary nav-link inline-flex">See All Destinations</a>
    </div>
  </div>
</section>
)}

{faqs.length > 0 && (
<section class="py-16 bg-bridge-50/50">
  <div class="mx-auto px-4 md:px-8 max-w-container">
    <h2 class="section-heading text-center mx-auto">{c(cm, 'scholarship.faqs.heading', 'Scholarship FAQs')}</h2>
    <div class="mt-10 border border-black/10 rounded-2xl divide-y divide-black/10 bg-white">
      {faqs.map((f, i) => (
        <div>
          <button class="faq-btn w-full text-left px-6 py-4 font-display font-semibold text-bridge-900 flex justify-between items-center">{f.title}<span class="faq-icon transition-transform">+</span></button>
          <p class={i === 0 ? 'faq-answer px-6 pb-5 text-sm text-ink/70' : 'faq-answer hidden px-6 pb-5 text-sm text-ink/70'}>{f.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<section class="py-16 bg-white text-center">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mx-auto">{c(cm, 'scholarship.cta.heading', 'Find Out What You Qualify For')}</h2>
    <p class="mt-3 max-w-xl mx-auto text-ink/60">{c(cm, 'scholarship.cta.text', "Tell us your academic background and destination — we'll match you with real funding options, free of charge.")}</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={c(cm, 'scholarship.cta.cta1_url', '/#lead-form')} class="btn-primary nav-link inline-flex">{c(cm, 'scholarship.cta.cta1_label', 'Check Scholarship Eligibility')}</a>
      <a href={c(cm, 'scholarship.cta.cta2_url', '/contact')} class="btn-outline nav-link inline-flex">{c(cm, 'scholarship.cta.cta2_label', 'Talk to a Counsellor')}</a>
    </div>
  </div>
</section>

</Layout>
