---
import Layout from '../layouts/Layout.astro';
const title = "Book Your Free Consultation | CloudBridge Study Abroad";
const description = "Get personalised guidance on courses, universities, and scholarships — book a free consultation with a CloudBridge counsellor.";
---
<Layout title={title} description={description}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / Free Consultation</p>
    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">Book Your Free Consultation</h1>
    <p class="mt-4 max-w-xl text-white/75">Tell us about your goals and a counsellor will get back to you — free, no obligation.</p>
  </div>
</section>

<section class="py-16">
  <div class="mx-auto px-4 md:px-8 max-w-4xl text-center">
    <h2 class="section-heading text-center">Planning to Study Abroad?</h2>
    <p class="mt-3 text-ink/60">Get personalised guidance on courses, universities, and available scholarships. Our team ensures a smooth application process, making your admission journey hassle-free.</p>
    <p class="mt-4 font-display font-bold text-sunrise-600">Book your FREE consultation today!</p>

    <form class="demo-form mt-8 grid sm:grid-cols-2 gap-5 bg-white rounded-2xl p-6 md:p-10 shadow-sm ring-1 ring-black/5 text-left" data-source="free-consultation">
      <input name="firstName" required placeholder="First name" class="form-input rounded-xl border border-black/10 px-4 py-3.5 text-sm">
      <input name="lastName" required placeholder="Last name" class="form-input rounded-xl border border-black/10 px-4 py-3.5 text-sm">
      <input name="phone" required placeholder="Phone number (WhatsApp)" class="form-input rounded-xl border border-black/10 px-4 py-3.5 text-sm">
      <input name="email" type="email" required placeholder="Email address" class="form-input rounded-xl border border-black/10 px-4 py-3.5 text-sm">
      <select name="residenceCountry" class="form-input rounded-xl border border-black/10 px-4 py-3.5 text-sm text-ink/70"><option value="">Country of residence</option><option>Bangladesh</option><option>India</option><option>UAE</option><option>Saudi Arabia</option><option>Other</option></select>
      <div>
        <select id="destinationSelect" onchange="toggleOtherDestination()" class="form-input rounded-xl border border-black/10 px-4 py-3.5 text-sm text-ink/70 w-full">
          <option value="">Preferred destination</option>
          <option>United Kingdom</option>
          <option>USA</option>
          <option>Canada</option>
          <option>Malta</option>
          <option>France</option>
          <option>Spain</option>
          <option>Finland</option>
          <option>New Zealand</option>
          <option>Netherlands</option>
          <option>Malaysia</option>
          <option value="Other">Other</option>
        </select>
        <input type="text" id="otherDestinationInput" placeholder="Please specify your preferred country" class="form-input hidden mt-3 rounded-xl border border-black/10 px-4 py-3.5 text-sm w-full">
      </div>
      <select name="degreeLevel" class="form-input rounded-xl border border-black/10 px-4 py-3.5 text-sm text-ink/70"><option value="">Most recently completed degree</option><option>SSC / O Levels</option><option>HSC / A Levels</option><option>Diploma</option><option>Bachelor's</option><option>Master's</option></select>
      <div class="relative" id="subjectCombo">
        <input type="text" readonly id="subjectDisplay" placeholder="Subject interested" onclick="toggleSubjectDropdown()" class="form-input rounded-xl border border-black/10 px-4 py-3.5 text-sm w-full cursor-pointer bg-white">
        <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 absolute right-3 top-1/2 -translate-y-1/2 text-ink/40 pointer-events-none"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
        <div id="subjectPanel" class="hidden absolute z-20 mt-2 w-full bg-white rounded-xl shadow-lg border border-black/10 overflow-hidden flex flex-col">
          <input type="text" id="subjectSearch" placeholder="Search subjects..." oninput="filterSubjects()" class="border-b border-black/10 px-4 py-2.5 text-sm outline-none">
          <div id="subjectList" class="max-h-56 overflow-y-auto"></div>
        </div>
      </div>
      <div class="sm:col-span-2">
        <p class="text-sm text-ink/70 mb-2">English proficiency test <span class="text-ink/40 font-normal">(select all that apply)</span></p>
        <div class="flex flex-wrap gap-x-4 gap-y-2 rounded-xl border border-black/10 px-4 py-3.5">
          <label class="flex items-center gap-1.5 text-sm text-ink/70"><input type="checkbox" class="uni-filter-check" name="engTest" value="IELTS"> IELTS</label>
          <label class="flex items-center gap-1.5 text-sm text-ink/70"><input type="checkbox" class="uni-filter-check" name="engTest" value="TOEFL"> TOEFL</label>
          <label class="flex items-center gap-1.5 text-sm text-ink/70"><input type="checkbox" class="uni-filter-check" name="engTest" value="PTE Academic"> PTE Academic</label>
          <label class="flex items-center gap-1.5 text-sm text-ink/70"><input type="checkbox" class="uni-filter-check" name="engTest" value="Duolingo"> Duolingo English Test</label>
          <label class="flex items-center gap-1.5 text-sm text-ink/70"><input type="checkbox" class="uni-filter-check" name="engTest" value="MOI"> MOI Certificate</label>
          <label class="flex items-center gap-1.5 text-sm text-ink/70"><input type="checkbox" class="uni-filter-check" name="engTest" value="Not yet taken"> Not yet taken</label>
        </div>
      </div>
      <input name="testScore" placeholder="Test result(s) — e.g. IELTS 6.5, Duolingo 115" class="form-input rounded-xl border border-black/10 px-4 py-3.5 text-sm sm:col-span-2">
      <label class="sm:col-span-2 flex items-start gap-2 text-xs text-ink/50">
        <input type="checkbox" required class="mt-0.5 uni-filter-check">
        <span>We will not share your details with anyone without your permission. I agree to CloudBridge's terms and privacy policy.</span>
      </label>
      <button type="submit" class="sm:col-span-2 rounded-2xl py-3.5 font-display font-semibold text-white shadow-sm transition hover:brightness-110" style="background-image:linear-gradient(90deg,#1c3255 0%,#1c3255 35%,#e12d38 100%)">Submit</button>
    </form>
    <div class="demo-form-thanks hidden mt-6 rounded-2xl bg-harbor-500/10 p-6 text-center text-harbor-600 font-display font-semibold">
      Thanks! One of our counsellors will call you shortly. <span class="block text-xs font-normal text-ink/40 mt-1">(demo only — nothing was actually sent)</span>
    </div>
  </div>
</section>

<section class="py-16 bg-bridge-50/50">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mx-auto">What Students Say About Us</h2>
    <p class="mt-3 text-ink/60 text-center max-w-xl mx-auto">Real experiences from students we've guided through their study abroad journey.</p>
    <div class="mt-10 relative">
      <button onclick="testiMove(-1)" aria-label="Previous testimonials" class="hidden md:flex absolute top-1/2 -translate-y-1/2 -left-5 lg:-left-12 w-10 h-10 rounded-full bg-white ring-1 ring-black/10 shadow items-center justify-center text-bridge-900 text-2xl leading-none hover:bg-bridge-50 transition z-10">&#8249;</button>
      <div class="overflow-hidden">
        <div id="testiTrack" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6"></div>
      </div>
      <button onclick="testiMove(1)" aria-label="Next testimonials" class="hidden md:flex absolute top-1/2 -translate-y-1/2 -right-5 lg:-right-12 w-10 h-10 rounded-full bg-white ring-1 ring-black/10 shadow items-center justify-center text-bridge-900 text-2xl leading-none hover:bg-bridge-50 transition z-10">&#8250;</button>
    </div>
    <div class="mt-6 flex md:hidden items-center justify-center gap-4">
      <button onclick="testiMove(-1)" aria-label="Previous testimonials" class="w-10 h-10 rounded-full bg-white ring-1 ring-black/10 shadow flex items-center justify-center text-bridge-900 text-2xl leading-none">&#8249;</button>
      <button onclick="testiMove(1)" aria-label="Next testimonials" class="w-10 h-10 rounded-full bg-white ring-1 ring-black/10 shadow flex items-center justify-center text-bridge-900 text-2xl leading-none">&#8250;</button>
    </div>
    <div id="testiDots" class="mt-6 flex items-center justify-center gap-2"></div>
  </div>
</section>

<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mx-auto">Visit Us</h2>
    <p class="mt-3 text-ink/60 text-center max-w-xl mx-auto">Our offices across Bangladesh and the UK.</p>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="rounded-2xl border border-bridge-100 ring-1 ring-black/5 p-6">
        <h3 class="font-display font-bold text-bridge-900 text-lg">Dhaka Office</h3>
        <div class="mt-4 space-y-3">
          <div class="flex items-start gap-3">
            <span class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0" style="background-image:linear-gradient(135deg,#1c3255,#e12d38)"><svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
            <p class="text-sm text-ink/70 text-left">Lift 3, House 27, Road 21, Nikunjo-2, Dhaka 1229, Bangladesh</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0" style="background-image:linear-gradient(135deg,#1c3255,#e12d38)"><svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4c0 9 7 16 16 16l2-4-6-2-2 2c-2-1-4-3-5-5l2-2-2-6-4 1Z"/></svg></span>
            <p class="text-sm text-ink/70 text-left">+880 1686 007004</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0" style="background-image:linear-gradient(135deg,#1c3255,#e12d38)"><svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 6 8 6 8-6"/></svg></span>
            <p class="text-sm text-ink/70 text-left">apply@cloudbridge.info</p>
          </div>
        </div>
      </div>
      <div class="rounded-2xl border border-bridge-100 ring-1 ring-black/5 p-6">
        <h3 class="font-display font-bold text-bridge-900 text-lg">Sylhet Office</h3>
        <div class="mt-4 space-y-3">
          <div class="flex items-start gap-3">
            <span class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0" style="background-image:linear-gradient(135deg,#1c3255,#e12d38)"><svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
            <p class="text-sm text-ink/70 text-left">405-406 Manru Shopping City, 4th Floor, Chowhatta, Sylhet 3100, Bangladesh</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0" style="background-image:linear-gradient(135deg,#1c3255,#e12d38)"><svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4c0 9 7 16 16 16l2-4-6-2-2 2c-2-1-4-3-5-5l2-2-2-6-4 1Z"/></svg></span>
            <p class="text-sm text-ink/70 text-left">+880 1619 130469</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0" style="background-image:linear-gradient(135deg,#1c3255,#e12d38)"><svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 6 8 6 8-6"/></svg></span>
            <p class="text-sm text-ink/70 text-left">studyabroad.sylhet@cloudbridge.info</p>
          </div>
        </div>
      </div>
      <div class="rounded-2xl border border-bridge-100 ring-1 ring-black/5 p-6">
        <h3 class="font-display font-bold text-bridge-900 text-lg">UK Office</h3>
        <div class="mt-4 space-y-3">
          <div class="flex items-start gap-3">
            <span class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 opacity-50" style="background-image:linear-gradient(135deg,#1c3255,#e12d38)"><svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
            <p class="text-sm text-ink/40 text-left italic">Loading...</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 opacity-50" style="background-image:linear-gradient(135deg,#1c3255,#e12d38)"><svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4c0 9 7 16 16 16l2-4-6-2-2 2c-2-1-4-3-5-5l2-2-2-6-4 1Z"/></svg></span>
            <p class="text-sm text-ink/40 text-left italic">Loading...</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 opacity-50" style="background-image:linear-gradient(135deg,#1c3255,#e12d38)"><svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 6 8 6 8-6"/></svg></span>
            <p class="text-sm text-ink/40 text-left italic">Loading...</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

</Layout>
