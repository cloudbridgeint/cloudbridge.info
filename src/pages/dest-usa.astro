---
import Layout from '../layouts/Layout.astro';
const title = "Study in the USA | CloudBridge Study Abroad Consultancy";
const description = "Plan your journey to study in the USA — university options, costs, and visa support from CloudBridge.";
---
<Layout title={title} description={description}>

<section class="text-white py-20" style="background-image:linear-gradient(160deg,#0f1c30,#963c3c); background-size:cover;">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / <a href="/destinations">Study Destination</a> / USA</p>
    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">Study in the USA</h1>
    <p class="mt-4 max-w-xl text-white/80">Small classes, academic freedom, and strong mentorship at world-renowned universities.</p>
    <a href="/#lead-form" class="btn-primary nav-link mt-8 inline-flex">Book Free Consultation</a>
  </div>
</section>
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-10">
    <div>
      <h2 class="font-display text-xl font-bold text-bridge-900">Why study in the USA?</h2>
      <ul class="mt-4 space-y-3 text-sm text-ink/70">
        <li>• World's largest network of research universities</li>
        <li>• Flexible course selection, especially at undergrad level</li>
        <li>• Optional Practical Training (OPT) work authorization</li>
        <li>• Huge Bangladeshi student community in major cities</li>
      </ul>
    </div>
    <div>
      <h2 class="font-display text-xl font-bold text-bridge-900">Popular programs</h2>
      <ul class="mt-4 space-y-3 text-sm text-ink/70">
        <li>• Computer Science & Data Analytics</li>
        <li>• MBA & Finance</li>
        <li>• Biomedical & Electrical Engineering</li>
        <li>• Public Policy & International Relations</li>
      </ul>
    </div>
  </div>
</section>

</Layout>
