---
import Layout from '../../../layouts/Layout.astro';
import { getEventBySlugPeriod, mediaUrl, eventPeriod, renderEventDescription } from '../../../lib/content';

export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const { slug, period } = Astro.params;
const ev = slug && period ? await getEventBySlugPeriod(db, slug, period) : null;

if (!ev) {
  return new Response(null, { status: 404 });
}

const eventDate = new Date(ev.event_date + 'T00:00:00');
const isPast = !isNaN(eventDate.getTime()) && eventDate < new Date(new Date().toDateString());

function fmtLong(dateStr: string) {
  if (!dateStr) return 'Date to be announced';
  const d = new Date(dateStr + 'T00:00:00');
  if (isNaN(d.getTime())) return dateStr;
  return d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
}
const dateLabel = fmtLong(ev.event_date);
const canonical = `https://cloudbridge.info/events/${ev.slug}/${eventPeriod(ev.event_date)}`;
const descHtml = renderEventDescription(ev.description || '');

const title = `${ev.title}${ev.location ? ` — ${ev.location}` : ''} | CloudBridge`;
const description = (ev.description
  ? String(ev.description).replace(/[#*\-]/g, '').replace(/\s+/g, ' ').trim().slice(0, 155)
  : `${ev.title} by CloudBridge${ev.location ? ` at ${ev.location}` : ''} on ${dateLabel}. Register free to join.`);

// Only emitted for an event still to come — Google drops past events from rich
// results, and marking a finished one as available would be misleading.
const eventSchema = isPast ? null : {
  '@context': 'https://schema.org',
  '@type': 'EducationEvent',
  name: ev.title,
  startDate: ev.event_date,
  eventAttendanceMode: /online/i.test(ev.location || '')
    ? 'https://schema.org/OnlineEventAttendanceMode'
    : 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: /online/i.test(ev.location || '')
    ? { '@type': 'VirtualLocation', url: canonical }
    : { '@type': 'Place', name: ev.location || 'CloudBridge', address: ev.location || 'Bangladesh' },
  description: (ev.description || ev.title).replace(/[#*]/g, ''),
  organizer: { '@type': 'Organization', name: 'CloudBridge', url: 'https://cloudbridge.info' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'BDT', availability: 'https://schema.org/InStock', url: canonical },
  url: canonical,
};
---
<Layout title={title} description={description}>

  {eventSchema && <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} is:inline />}
  <link rel="canonical" href={canonical} slot="head" />

  <section class="bg-dusk-gradient text-white py-16">
    <div class="max-w-container mx-auto px-4 md:px-8">
      <p class="crumb"><a href="/">Home</a> / <a href="/events">Events</a> / {ev.title}</p>
      {isPast && (
        <span class="inline-block mt-4 rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide">This event has finished</span>
      )}
      <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">{ev.title}</h1>
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-white/80">
        <span class="inline-flex items-center gap-2">
          <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
          {dateLabel}
        </span>
        {ev.location && (
          <span class="inline-flex items-center gap-2">
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-5.2 7-10a7 7 0 1 0-14 0c0 4.8 7 10 7 10Z"/><circle cx="12" cy="11" r="2.5"/></svg>
            {ev.location}
          </span>
        )}
        {ev.event_time && (
          <span class="inline-flex items-center gap-2">
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            {ev.event_time}
          </span>
        )}
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="max-w-container mx-auto px-4 md:px-8 grid lg:grid-cols-3 gap-10 items-start">

      <div class="lg:col-span-2">
        <h2 class="section-heading">About this event</h2>

        {ev.image && (
          <img src={mediaUrl(ev.image, '')} alt={ev.title}
               class="w-full rounded-2xl mt-6 object-cover max-h-[26rem]" loading="lazy" decoding="async">
        )}

        <div class="ev-desc mt-8" set:html={descHtml || '<p>Full details for this event will be shared soon. Register below and our team will contact you with the agenda.</p>'}></div>

        <!-- Registration sits under the details, which is where someone is once
             they've read enough to decide. -->
        <div id="joinEvent" class="mt-12 scroll-mt-28">
          {isPast ? (
            <div class="rounded-2xl bg-bridge-50/60 ring-1 ring-black/5 p-6 md:p-8 text-center">
              <h2 class="font-display font-bold text-xl text-bridge-900">This event has finished</h2>
              <p class="mt-2 text-ink/60">We run this event regularly — tell us you're interested and we'll share the next date.</p>
              <a href="/free-consultation" class="btn-primary nav-link inline-flex mt-5">Get the next date</a>
            </div>
          ) : (
            <div class="rounded-2xl bg-white ring-1 ring-black/5 shadow-sm p-6 md:p-8">
              <h2 class="font-display font-extrabold text-2xl text-center text-bridge-900">Join Our Event</h2>
              <p class="mt-2 text-center text-sm text-ink/60">
                Fill the form below to reserve your seat for <span class="font-semibold text-bridge-900">{ev.title}</span>.
              </p>

              <form id="eventJoinForm" class="ev-join-form mt-7 grid sm:grid-cols-2 gap-4" data-event-id={ev.id}>
                <div class="sm:col-span-2">
                  <label class="ev-label">Full name <span class="text-sunrise-600">*</span></label>
                  <input name="name" required placeholder="Your full name" class="ev-input">
                </div>
                <div>
                  <label class="ev-label">Phone (WhatsApp) <span class="text-sunrise-600">*</span></label>
                  <input name="phone" required placeholder="+880 1XXXXXXXXX" class="ev-input">
                </div>
                <div>
                  <label class="ev-label">Email</label>
                  <input name="email" type="email" placeholder="name@email.com" class="ev-input">
                </div>
                <div>
                  <label class="ev-label">City</label>
                  <input name="city" placeholder="e.g. Sylhet" class="ev-input">
                </div>
                <div>
                  <label class="ev-label">Preferred branch <span class="text-sunrise-600">*</span></label>
                  <select name="branch" required class="ev-input">
                    <option value="">— Select —</option>
                    <option>Dhaka</option>
                    <option>Sylhet</option>
                    <option>Online</option>
                  </select>
                </div>

                <p class="sm:col-span-2 text-xs text-ink/45">We will not share your details with anyone without your permission.</p>
                <p class="ev-form-error sm:col-span-2 hidden text-sm font-semibold text-sunrise-600"></p>

                <div class="sm:col-span-2 flex justify-center pt-1">
                  <button type="submit" class="btn-primary inline-flex px-10">Register Now</button>
                </div>
              </form>

              <div class="ev-join-done hidden text-center py-8">
                <div class="w-14 h-14 mx-auto rounded-full bg-harbor-500/10 flex items-center justify-center text-harbor-600">
                  <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
                </div>
                <p class="mt-4 font-display font-bold text-lg text-bridge-900">You're registered!</p>
                <p class="mt-2 text-ink/60 text-sm max-w-sm mx-auto">
                  We've saved your seat for <span class="font-semibold text-bridge-900">{ev.title}</span>.
                  Our team will contact you with the joining details.
                </p>
              </div>
            </div>
          )}
        </div>
      </div>

      <aside class="lg:col-span-1">
        <div class="rounded-2xl bg-bridge-50/60 ring-1 ring-black/5 p-6 lg:sticky lg:top-28">
          {isPast ? (
            <>
              <p class="font-display font-bold text-bridge-900">This event has finished</p>
              <p class="mt-2 text-sm text-ink/60">We run this event regularly. Tell us you're interested and we'll let you know the next date.</p>
              <a href="/free-consultation" class="btn-primary nav-link inline-flex mt-5 w-full justify-center">Get the next date</a>
              <a href="/events" class="btn-outline nav-link inline-flex mt-3 w-full justify-center">See upcoming events</a>
            </>
          ) : (
            <>
              <p class="font-display font-bold text-bridge-900">Reserve your seat</p>
              <p class="mt-2 text-sm text-ink/60">Free to attend. Registration takes under a minute.</p>
              <dl class="mt-5 space-y-3 text-sm">
                <div class="flex justify-between gap-4"><dt class="text-ink/50">Date</dt><dd class="font-semibold text-bridge-900 text-right">{dateLabel}</dd></div>
                {ev.event_time && <div class="flex justify-between gap-4"><dt class="text-ink/50">Time</dt><dd class="font-semibold text-bridge-900 text-right">{ev.event_time}</dd></div>}
                {ev.location && <div class="flex justify-between gap-4"><dt class="text-ink/50">Venue</dt><dd class="font-semibold text-bridge-900 text-right">{ev.location}</dd></div>}
                <div class="flex justify-between gap-4"><dt class="text-ink/50">Entry</dt><dd class="font-semibold text-bridge-900 text-right">Free</dd></div>
              </dl>
              <!-- Scrolls to the form below rather than opening a dialog, so the
                   page has a single place to register. -->
              <a href="#joinEvent" class="btn-primary inline-flex mt-6 w-full justify-center">Register Now</a>
              <a href="/events" class="btn-outline nav-link inline-flex mt-3 w-full justify-center">See all events</a>
            </>
          )}
        </div>
      </aside>

    </div>
  </section>

  <style is:global>
    /* Field styles live in EventModals.astro too, but this page renders the
       form inline without that component, so it needs its own copy. */
    .ev-label { display:block; font-size:.7rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:#374151; margin-bottom:.35rem; }
    .ev-input { width:100%; border-radius:.75rem; border:1px solid rgba(0,0,0,.12); padding:.7rem .95rem; font-size:.875rem; background:#fff; }
    .ev-input:focus { outline:none; border-color:#2f5182; box-shadow:0 0 0 3px rgba(47,81,130,.15); }

    .ev-desc { color: rgba(30,36,48,.75); line-height: 1.75; }
    .ev-desc p { margin-bottom: .9rem; }
    .ev-desc .ev-desc-h { font-family: inherit; font-weight: 700; color: #15263f; font-size: 1.05rem; margin: 1.6rem 0 .6rem; }
    .ev-desc .ev-desc-h:first-child { margin-top: 0; }
    .ev-desc .ev-desc-ul { list-style: disc; padding-left: 1.4rem; margin-bottom: 1rem; }
    .ev-desc .ev-desc-ul li { margin-bottom: .4rem; }
    .ev-desc strong { color: #15263f; font-weight: 700; }
  </style>

</Layout>
