---
/**
 * A bare /events/<slug> is no longer a page of its own — each occurrence has
 * its own permanent URL at /events/<slug>/<month>-<year>. This redirects to the
 * newest occurrence so links shared before the change, and anyone who trims the
 * URL by hand, still land somewhere useful instead of a 404. Redirecting rather
 * than rendering also keeps a single canonical address per occurrence.
 */
import { getLatestOccurrence, eventPeriod } from '../../lib/content';

export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const { slug } = Astro.params;
const ev = slug ? await getLatestOccurrence(db, slug) : null;

if (!ev) {
  return new Response(null, { status: 404 });
}

return Astro.redirect(`/events/${ev.slug}/${eventPeriod(ev.event_date)}`, 302);
---
