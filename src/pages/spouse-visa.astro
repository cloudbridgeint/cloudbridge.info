---
import Layout from '../layouts/Layout.astro';
import { getAllContent, getPageItemGroups, c } from '../lib/content';

export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const [cm, groups] = await Promise.all([
  getAllContent(db),
  getPageItemGroups(db, ['spouse-visa.features']),
]);
const features = groups['spouse-visa.features'];

const title = c(cm, 'spouse-visa.meta_title', 'Spouse Visa Support | CloudBridge');
const description = c(cm, 'spouse-visa.meta_description', 'Guidance and documentation support for spouse and dependent visas so your family can join you abroad, from CloudBridge.');
---
<Layout title={title} description={description}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / Service / Spouse Visa</p>
    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">{c(cm, 'spouse-visa.hero.heading', 'Spouse Visa Support')}</h1>
    <p class="mt-4 max-w-xl text-white/75">{c(cm, 'spouse-visa.hero.text', "Studying abroad shouldn't mean leaving your family behind. We help eligible students bring their spouse along.")}</p>
  </div>
</section>
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-8">
    {features.map(f => (
      <div class="rounded-2xl border border-black/10 p-6">
        <h3 class="font-display font-bold text-bridge-900">{f.title}</h3>
        <p class="mt-2 text-sm text-ink/60">{f.body}</p>
      </div>
    ))}
  </div>
  <div class="mt-8">
    <a href={c(cm, 'spouse-visa.cta.url', '/#lead-form')} class="btn-primary nav-link">{c(cm, 'spouse-visa.cta.label', 'Ask about spouse visas')}</a>
  </div>
</section>

</Layout>
