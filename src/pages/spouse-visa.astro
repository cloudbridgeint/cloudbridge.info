---
import Layout from '../layouts/Layout.astro';
const title = "Spouse Visa Support | CloudBridge";
const description = "Guidance and documentation support for spouse and dependent visas so your family can join you abroad, from CloudBridge.";
---
<Layout title={title} description={description}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / Service / Spouse Visa</p>
    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">Spouse Visa Support</h1>
    <p class="mt-4 max-w-xl text-white/75">Studying abroad shouldn't mean leaving your family behind. We help eligible students bring their spouse along.</p>
  </div>
</section>
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-8">
    <div class="rounded-2xl border border-black/10 p-6"><h3 class="font-display font-bold text-bridge-900">Eligibility Check</h3><p class="mt-2 text-sm text-ink/60">Not every course or destination allows dependent visas — we check your eligibility before you apply, not after.</p></div>
    <div class="rounded-2xl border border-black/10 p-6"><h3 class="font-display font-bold text-bridge-900">Financial Documentation</h3><p class="mt-2 text-sm text-ink/60">Dependent visas usually need extra proof of funds — we help you plan and document this correctly the first time.</p></div>
    <div class="rounded-2xl border border-black/10 p-6"><h3 class="font-display font-bold text-bridge-900">Application Support</h3><p class="mt-2 text-sm text-ink/60">We prepare and file the dependent visa application alongside your own student visa application.</p></div>
    <div class="rounded-2xl border border-black/10 p-6"><h3 class="font-display font-bold text-bridge-900">Settling In Together</h3><p class="mt-2 text-sm text-ink/60">Guidance on accommodation, healthcare registration, and work rights for accompanying spouses.</p></div>
  </div>
  <div class="mt-8"><a href="/#lead-form" class="btn-primary nav-link">Ask about spouse visas</a></div>
</section>

</Layout>
