---
import Layout from '../layouts/Layout.astro';
import { getAllContent, getPageItemGroups, c } from '../lib/content';
import { iconImage } from '../lib/icons';

export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const [cm, groups] = await Promise.all([
  getAllContent(db),
  getPageItemGroups(db, ['team.members']),
]);
const team = groups['team.members'];

const title = c(cm, 'our-team.meta_title', 'Our Team | CloudBridge Study Abroad Consultants');
const description = c(cm, 'our-team.meta_description', 'Meet the CloudBridge counselling team helping students in Bangladesh apply to universities in the UK, Malaysia, and the USA.');
---
<Layout title={title} description={description}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / <a href="/about">About</a> / Our Team</p>
    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">{c(cm, 'our-team.hero.heading', 'Our Team')}</h1>
    <p class="mt-4 max-w-xl text-white/75">{c(cm, 'our-team.hero.text', 'The counsellors and staff behind every successful application — real people who know your destination country inside out.')}</p>
  </div>
</section>
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <div class="max-w-xl">
      <h2 class="section-heading">{c(cm, 'our-team.intro.heading', "Meet the People You'll Work With")}</h2>
      <p class="mt-3 text-ink/60">{c(cm, 'our-team.intro.text', 'Every student is matched with a dedicated counsellor from day one.')}</p>
    </div>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {team.map(m => {
        const photo = iconImage(m.icon);
        return (
          <div class="rounded-2xl border border-black/10 overflow-hidden text-center shadow-sm">
            {photo
              ? <img src={photo} alt={m.title} loading="lazy" class="w-full aspect-square object-cover">
              : <div class="w-full aspect-square bg-bridge-50 flex items-center justify-center text-bridge-300"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-16 h-16"><circle cx="12" cy="6.5" r="3.5"/><path d="M9.5 11h5l3.2 9.5a1 1 0 01-.95 1.5H7.25a1 1 0 01-.95-1.5L9.5 11z"/></svg></div>}
            <div class="p-6">
              <h3 class="font-display font-bold text-bridge-900">{m.title}</h3>
              <p class="text-sm text-sunrise-600 font-semibold mt-0.5">{m.subtitle}</p>
              {m.body && <p class="mt-2 text-sm text-ink/60">{m.body}</p>}
              {m.link_label && <p class="mt-1 text-xs text-ink/40">{m.link_label}</p>}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
<section class="py-16 bg-dusk-gradient text-white text-center">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="text-2xl md:text-3xl font-extrabold">{c(cm, 'our-team.cta.heading', 'Want to meet your counsellor?')}</h2>
    <a href={c(cm, 'our-team.cta.url', '/#lead-form')} class="btn-primary nav-link mt-6 inline-flex">{c(cm, 'our-team.cta.label', 'Book Free Consultation')}</a>
  </div>
</section>

</Layout>
