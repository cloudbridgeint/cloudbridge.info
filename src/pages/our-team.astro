---
import Layout from '../layouts/Layout.astro';
const title = "Our Team | CloudBridge Study Abroad Consultants";
const description = "Meet the CloudBridge counselling team helping students in Bangladesh apply to universities in the UK, Malaysia, and the USA.";
---
<Layout title={title} description={description}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / <a href="/about">About</a> / Our Team</p>
    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">Our Team</h1>
    <p class="mt-4 max-w-xl text-white/75">The counsellors and staff behind every successful application — real people who know your destination country inside out.</p>
  </div>
</section>
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <div class="max-w-xl">
      <h2 class="section-heading">Meet the People You'll Work With</h2>
      <p class="mt-3 text-ink/60">Every student is matched with a dedicated counsellor from day one.</p>
    </div>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="rounded-2xl border border-black/10 overflow-hidden text-center shadow-sm">
        <img src="/assets/team/shahan.jpg" alt="Mohammed Shahan" class="w-full aspect-square object-cover">
        <div class="p-6">
          <h3 class="font-display font-bold text-bridge-900">Mohammed Shahan</h3>
          <p class="text-sm text-sunrise-600 font-semibold mt-0.5">Founder &amp; CEO</p>
        </div>
      </div>
      <div class="rounded-2xl border border-black/10 overflow-hidden text-center shadow-sm">
        <img src="/assets/team/ariful.jpg" alt="Ariful Islam" class="w-full aspect-square object-cover">
        <div class="p-6">
          <h3 class="font-display font-bold text-bridge-900">Ariful Islam</h3>
          <p class="text-sm text-sunrise-600 font-semibold mt-0.5">Branch Manager (UK Specialist)</p>
          <p class="mt-2 text-sm text-ink/60">UK Branch</p>
          <p class="mt-1 text-xs text-ink/40">ID: 102042025</p>
        </div>
      </div>
      <div class="rounded-2xl border border-black/10 overflow-hidden text-center shadow-sm">
        <img src="/assets/team/sunny.jpg" alt="Sunny Arafat" class="w-full aspect-square object-cover">
        <div class="p-6">
          <h3 class="font-display font-bold text-bridge-900">Sunny Arafat</h3>
          <p class="text-sm text-sunrise-600 font-semibold mt-0.5">Sr. Executive — Digital Marketing</p>
          <p class="mt-2 text-sm text-ink/60">Dhaka Branch</p>
          <p class="mt-1 text-xs text-ink/40">ID: 52012026</p>
        </div>
      </div>
      <div class="rounded-2xl border border-black/10 overflow-hidden text-center shadow-sm">
        <img src="/assets/team/mehedi.jpg" alt="Mehedi Hasan" class="w-full aspect-square object-cover">
        <div class="p-6">
          <h3 class="font-display font-bold text-bridge-900">Mehedi Hasan</h3>
          <p class="text-sm text-sunrise-600 font-semibold mt-0.5">Administrative Executive</p>
          <p class="mt-2 text-sm text-ink/60">Dhaka Branch</p>
          <p class="mt-1 text-xs text-ink/40">ID: 201042025</p>
        </div>
      </div>
      <div class="rounded-2xl border border-black/10 overflow-hidden text-center shadow-sm">
        <img src="/assets/team/mim.jpg" alt="Kazi Mim" class="w-full aspect-square object-cover">
        <div class="p-6">
          <h3 class="font-display font-bold text-bridge-900">Kazi Mim</h3>
          <p class="text-sm text-sunrise-600 font-semibold mt-0.5">Application Team</p>
          <p class="mt-2 text-sm text-ink/60">Dhaka Branch</p>
          <p class="mt-1 text-xs text-ink/40">ID: 301042025</p>
        </div>
      </div>
      <div class="rounded-2xl border border-black/10 overflow-hidden text-center shadow-sm">
        <img src="/assets/team/mahi.jpg" alt="Mahpara Jahan Mahi" class="w-full aspect-square object-cover">
        <div class="p-6">
          <h3 class="font-display font-bold text-bridge-900">Mahpara Jahan Mahi</h3>
          <p class="text-sm text-sunrise-600 font-semibold mt-0.5">Senior Counselor</p>
          <p class="mt-2 text-sm text-ink/60">Sylhet Branch</p>
          <p class="mt-1 text-xs text-ink/40">ID: 501012026</p>
        </div>
      </div>
      <div class="rounded-2xl border border-black/10 overflow-hidden text-center shadow-sm">
        <div class="w-full aspect-square bg-bridge-50 flex items-center justify-center text-bridge-300"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-16 h-16"><circle cx="12" cy="6.5" r="3.5"/><path d="M9.5 11h5l3.2 9.5a1 1 0 01-.95 1.5H7.25a1 1 0 01-.95-1.5L9.5 11z"/></svg></div>
        <div class="p-6">
          <h3 class="font-display font-bold text-bridge-900">Sharmin Hoque</h3>
          <p class="text-sm text-sunrise-600 font-semibold mt-0.5">Student Counselor</p>
          <p class="mt-2 text-sm text-ink/60">Sylhet Branch</p>
          <p class="mt-1 text-xs text-ink/40">ID: 601012026</p>
        </div>
      </div>
      <div class="rounded-2xl border border-black/10 overflow-hidden text-center shadow-sm">
        <div class="w-full aspect-square bg-bridge-50 flex items-center justify-center text-bridge-300"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-16 h-16"><circle cx="12" cy="6.5" r="3.5"/><path d="M9.5 11h5l3.2 9.5a1 1 0 01-.95 1.5H7.25a1 1 0 01-.95-1.5L9.5 11z"/></svg></div>
        <div class="p-6">
          <h3 class="font-display font-bold text-bridge-900">Kaniz Mim</h3>
          <p class="text-sm text-sunrise-600 font-semibold mt-0.5">Student Counselor</p>
          <p class="mt-2 text-sm text-ink/60">Dhaka Branch</p>
          <p class="mt-1 text-xs text-ink/40">ID: 720072026</p>
        </div>
      </div>
      <div class="rounded-2xl border border-black/10 overflow-hidden text-center shadow-sm">
        <img src="/assets/team/fahim.jpg" alt="Fahim" class="w-full aspect-square object-cover">
        <div class="p-6">
          <h3 class="font-display font-bold text-bridge-900">Fahim</h3>
          <p class="text-sm text-sunrise-600 font-semibold mt-0.5">Executive — Operations</p>
          <p class="mt-2 text-sm text-ink/60">Sylhet Branch</p>
          <p class="mt-1 text-xs text-ink/40">ID: 01012026</p>
        </div>
      </div>
    </div>
  </div>
</section>
<section class="py-16 bg-dusk-gradient text-white text-center">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="text-2xl md:text-3xl font-extrabold">Want to meet your counsellor?</h2>
    <a href="/#lead-form" class="btn-primary nav-link mt-6 inline-flex">Book Free Consultation</a>
  </div>
</section>

</Layout>
