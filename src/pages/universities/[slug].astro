---
/*
 * One university's profile at /universities/<slug>.
 *
 * A menu of sections pinned on the left, the content on the right. The
 * right-hand column that used to hold a counselling card and a website box
 * narrowed the reading column and gave the page no way to navigate — on a
 * profile this long a student wants to jump to Programmes or Accommodation
 * rather than scroll for them.
 *
 * The sections themselves are plain headings and prose, matching the rest of
 * the site. Wrapping each one in its own bordered card was tried and dropped:
 * ten stacked boxes fight the page rather than structure it, and the menu
 * already does the structuring.
 *
 * Fees and entry requirements are given as the usual range and labelled as
 * such. They move, and only the university's own page is authoritative, so
 * every profile records when it was last checked and links to the source.
 */
import Layout from '../../layouts/Layout.astro';
import { getUniversityBySlug, getCoursesByUniversity, paragraphs } from '../../lib/content';

export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const { slug } = Astro.params;
const u = slug ? await getUniversityBySlug(db, slug) : null;
if (!u) return new Response(null, { status: 404 });

const courses = await getCoursesByUniversity(db, u.name);
const url = `https://cloudbridge.info/universities/${u.slug}`;

const title = `${u.name} — Courses, Fees & Entry Requirements | CloudBridge`;
const description = u.overview
  ? paragraphs(u.overview)[0].slice(0, 155)
  : `Study at ${u.name} in ${u.city}, ${u.country}. Courses, intakes, tuition range and how CloudBridge helps you apply from Bangladesh.`;

const feeRange = u.fee_min && u.fee_max
  ? `$${Number(u.fee_min).toLocaleString()} – $${Number(u.fee_max).toLocaleString()}`
  : '';

/* Bulleted lists are stored one entry per line. */
const bullets = (raw: string | null | undefined) =>
  String(raw || '').split(/\r?\n/).map(s => s.trim()).filter(Boolean);

/* Only sections with something in them are listed or rendered — an empty
   heading makes a profile look abandoned, and a menu entry that jumps to
   nothing is worse than no menu entry. */
const sections = [
  { id: 'overview', label: 'University Overview', show: !!u.overview },
  { id: 'why', label: 'Why Choose This University', show: bullets(u.why_choose).length > 0 },
  { id: 'programmes', label: 'University Programmes', show: courses.length > 0 },
  { id: 'entry', label: 'Entry Requirements', show: !!u.entry_requirements },
  { id: 'fees', label: 'Fees & Scholarships', show: !!(feeRange || u.scholarships_info) },
  { id: 'rankings', label: 'University Rankings', show: !!(u.rankings_note || (u.ranking && u.ranking !== 'Not Ranked')) },
  { id: 'facilities', label: 'Campus & Facilities', show: !!u.facilities },
  { id: 'services', label: 'Services', show: !!u.services },
  { id: 'student-life', label: 'Student Life', show: !!u.student_life },
  { id: 'accommodation', label: 'Accommodation', show: !!u.accommodation },
  { id: 'apply', label: 'How to Apply', show: true },
].filter(s => s.show);

const schema = [{
  '@type': 'CollegeOrUniversity',
  '@id': url + '#university',
  name: u.name,
  ...(u.website ? { url: u.website } : {}),
  ...(u.founded ? { foundingDate: u.founded } : {}),
  address: { '@type': 'PostalAddress', addressLocality: u.city, addressCountry: u.country },
}];

const verified = u.last_verified_at
  ? new Date(u.last_verified_at + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  : '';

/* The headline figures, as icon-and-number rather than a table.
   Each one is left out entirely when it is not known: three boxes reading
   "Not Rated" make a profile look unfinished, where showing only what has
   been checked looks deliberate. */
const stats = [
  { icon: 'building', value: u.founded, label: 'Founding year' },
  { icon: 'medal', value: u.ranking && u.ranking !== 'Not Ranked' ? u.ranking : '', label: 'QS World Ranking' },
  { icon: 'laurel', value: u.ranking_guardian, label: 'Guardian Ranking' },
  { icon: 'chart', value: u.ranking_the, label: 'THE World Ranking' },
  { icon: 'people', value: u.student_count, label: 'Students' },
  { icon: 'cap-money', value: u.scholarship ? 'Available' : '', label: 'Scholarships' },
].filter(s => String(s.value || '').trim());

const facts = [
  { k: 'Location', v: [u.city, u.country].filter(Boolean).join(', ') || '—' },
  { k: 'International', v: u.international_count || '—' },
  { k: 'Tuition range (per year)', v: feeRange || 'Ask a counsellor' },
];

/* What the map is asked to find. The name plus the city resolves correctly for
   almost every institution; it is editable for the ones where it does not. */
const mapQuery = (u.map_query || [u.name, u.city, u.country].filter(Boolean).join(', ')).trim();
const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapQuery)}`;

/* Fixed set, so nothing stored in the database ends up as markup on the page. */
const STAT_ICONS: Record<string, string> = {
  building: 'M3 21h18M4 21V10l8-5 8 5v11M9 21v-6h6v6M7 13h.01M17 13h.01',
  medal: 'M12 15a5 5 0 100-10 5 5 0 000 10zm0 0v6l-3-2-3 2m6-6v6l3-2 3 2M12 8.5l.7 1.4 1.6.2-1.2 1.1.3 1.6-1.4-.8-1.4.8.3-1.6L9.7 10l1.6-.2.7-1.3z',
  laurel: 'M12 4v10m0 0c-2.5 0-4.5-2-4.5-4.5M12 14c2.5 0 4.5-2 4.5-4.5M6 12c0 3.3 2.7 6 6 6s6-2.7 6-6M9 20h6',
  chart: 'M4 20h16M7 20v-6m5 6V8m5 12v-9M12 3l1.2 2.4 2.6.4-1.9 1.8.5 2.6-2.4-1.3-2.4 1.3.5-2.6L8.2 5.8l2.6-.4L12 3z',
  people: 'M17 20h5v-2a4 4 0 00-3-3.87M9 20H2v-2a4 4 0 013-3.87m4-3.13a4 4 0 100-8 4 4 0 000 8zm7 3.13a4 4 0 00-3-3.87',
  'cap-money': 'M12 4L3 8.5 12 13l9-4.5L12 4zM6.5 10.6V15c0 1.4 2.5 3 5.5 3s5.5-1.6 5.5-3v-4.4M12 15.5v2',
};
---
<Layout title={title} description={description} schema={schema}
        image={u.coverUrl || undefined}
        breadcrumbs={[
          { name: 'University & College', url: '/university-college' },
          { name: u.name, url },
        ]}>

<section class="relative text-white">
  <div class="absolute inset-0" style="background-image:linear-gradient(160deg,#0f1c30,#2e4a7a)"></div>
  {u.coverUrl && (
    <img src={u.coverUrl} alt="" aria-hidden="true" class="absolute inset-0 w-full h-full object-cover opacity-45" />
  )}
  <div class="relative max-w-container mx-auto px-4 md:px-8 py-12 md:py-16">
    <p class="crumb"><a href="/">Home</a> / <a href="/university-college">Universities</a> / {u.name}</p>
    <div class="mt-5 flex items-start gap-5 flex-wrap">
      {u.logoUrl && (
        <span class="shrink-0 w-20 h-20 rounded-2xl bg-white flex items-center justify-center p-2.5 shadow-lg">
          <img src={u.logoUrl} alt={`${u.name} logo`} class="max-w-full max-h-full object-contain" />
        </span>
      )}
      <div class="min-w-0">
        <h1 class="text-3xl md:text-5xl font-extrabold leading-tight">{u.name}</h1>
        <p class="mt-2 text-white/80">{u.city}{u.city && u.country ? ', ' : ''}{u.country}</p>
      </div>
    </div>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={`/programs?university=${encodeURIComponent(u.name)}`} class="btn-primary inline-flex">View courses</a>
      <a href="/free-consultation" class="btn-secondary inline-flex">Talk to a counsellor — free</a>
      {u.website && (
        <a href={u.website} target="_blank" rel="noopener noreferrer"
           class="inline-flex items-center rounded-full border border-white/30 px-5 py-2.5 text-sm font-semibold text-white/90 hover:bg-white/10 transition">
          Official website ↗
        </a>
      )}
    </div>
  </div>
</section>

<!-- Enquire, share and the map, then the headline figures -->
<section class="py-8 bg-bridge-50/60 border-b border-black/5">
  <div class="max-w-container mx-auto px-4 md:px-8
              lg:grid lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-x-6 lg:gap-y-0 lg:items-start">

    <div class="flex flex-wrap items-start justify-between gap-6 lg:contents">
      <div class="min-w-0 grid sm:grid-cols-3 gap-3 flex-1 lg:col-start-1 lg:row-start-1">
        {facts.map(x => (
          <div class="h-full flex flex-col rounded-xl bg-white border border-black/10 overflow-hidden">
            <p class="bg-bridge-50 border-b border-black/10 px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-ink/55">{x.k}</p>
            <p class="flex-1 px-3 py-2.5 text-sm text-ink/75 leading-snug">{x.v}</p>
          </div>
        ))}
      </div>

      <div class="shrink-0 w-full sm:w-72 lg:w-auto lg:col-start-2 lg:row-start-1 lg:row-span-3">
        <div class="flex items-center gap-2">
          <a href="/free-consultation" class="flex-1 inline-flex items-center justify-center rounded-lg bg-sunrise-600 hover:bg-sunrise-700 px-4 py-2.5 text-sm font-semibold text-white transition">Enquire Now</a>
          <button type="button" id="shareBtn"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-black/15 bg-white px-4 py-2.5 text-sm font-semibold text-bridge-900 hover:bg-bridge-50 transition">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-4 h-4" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.7 10.7l6.6-3.4M8.7 13.3l6.6 3.4M18 8a2 2 0 100-4 2 2 0 000 4zM6 14a2 2 0 100-4 2 2 0 000 4zm12 6a2 2 0 100-4 2 2 0 000 4z" /></svg>
            Share
          </button>
        </div>
        <!-- Loaded lazily: the map is a third-party frame and is not what the
             page is for, so it must not hold up the content. -->
        <div class="mt-3 rounded-xl overflow-hidden border border-black/10 bg-white">
          <iframe src={mapEmbed} title={`Map showing ${u.name}`} loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  class="w-full h-40 block border-0"></iframe>
        </div>
        <a href={mapLink} target="_blank" rel="noopener noreferrer"
           class="mt-2 inline-flex text-xs font-semibold text-bridge-700 hover:underline">Open in Google Maps ↗</a>
      </div>
    </div>

    {stats.length > 0 && (
      <div class="mt-6 pt-6 border-t border-black/10 lg:col-start-1 lg:min-w-0">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {stats.map(st => (
            <div class="text-center">
              <span class="mx-auto w-14 h-14 rounded-full bg-white border border-black/10 flex items-center justify-center text-bridge-700">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="w-6 h-6" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={STAT_ICONS[st.icon]} />
                </svg>
              </span>
              <p class="mt-3 font-display font-bold text-bridge-900">{st.value}</p>
              <p class="text-xs text-ink/50">{st.label}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    {(u.intakeList.length > 0 || u.studyLevelList.length > 0 || u.facultyList.length > 0) && (
      <div class="mt-6 flex flex-wrap gap-2 lg:col-start-1 lg:min-w-0">
        {u.intakeList.map((i: string) => (
          <span class="rounded-full bg-white border border-black/10 px-3 py-1.5 text-xs text-ink/70">Intake: {i}</span>
        ))}
        {u.studyLevelList.map((sl: string) => (
          <span class="rounded-full bg-white border border-black/10 px-3 py-1.5 text-xs text-ink/70">{sl}</span>
        ))}
        {u.facultyList.map((f: string) => (
          <span class="rounded-full bg-white border border-black/10 px-3 py-1.5 text-xs text-ink/70">{f}</span>
        ))}
      </div>
    )}
  </div>
</section>

<section class="py-10 md:py-14">
  <div class="max-w-container mx-auto px-4 md:px-8 lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-10 lg:items-start">

    <!-- Section menu. On a narrow screen it becomes a strip you swipe, so it
         does not eat the whole first screen. -->
    <nav aria-label="Sections on this page" class="lg:sticky lg:top-24 mb-6 lg:mb-0">
      <p class="hidden lg:block text-[11px] font-bold uppercase tracking-wider text-ink/40 px-4 mb-2">On this page</p>
      <ul id="uniSectionNav" class="flex gap-2 overflow-x-auto pb-2 lg:block lg:space-y-1 lg:overflow-visible lg:pb-0">
        {sections.map(s => (
          <li class="shrink-0 lg:shrink">
            <a href={`#${s.id}`} data-uni-nav={s.id}
               class="block rounded-xl border border-black/10 bg-white px-4 py-3 text-sm font-medium text-bridge-900 hover:border-bridge-800/40 hover:bg-bridge-50 transition whitespace-nowrap lg:whitespace-normal">
              {s.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="space-y-12 min-w-0">

      {u.overview && (
        <div id="overview" class="scroll-mt-28">
          <h2 class="section-heading">Overview for international students</h2>
          {paragraphs(u.overview).map(p => <p class="mt-4 text-ink/70 leading-relaxed">{p}</p>)}
        </div>
      )}

      {bullets(u.why_choose).length > 0 && (
        <div id="why" class="scroll-mt-28">
          <h2 class="section-heading">Why choose {u.name}</h2>
          <ul class="mt-5 space-y-3">
            {bullets(u.why_choose).map(b => (
              <li class="flex gap-3 text-ink/70">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-sunrise-600 shrink-0 mt-0.5" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {courses.length > 0 && (
        <div id="programmes" class="scroll-mt-28">
          <h2 class="section-heading">{u.name} programmes</h2>
          <p class="mt-3 text-sm text-ink/60">{courses.length} programme{courses.length === 1 ? '' : 's'} in our directory. Use the course search for the full list with filters.</p>
          <div class="mt-5 overflow-x-auto rounded-xl border border-black/10">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left bg-bridge-50 border-b border-black/10">
                  <th class="px-4 py-3 font-semibold text-bridge-900">Course name</th>
                  <th class="px-4 py-3 font-semibold text-bridge-900 whitespace-nowrap">Study level</th>
                  <th class="px-4 py-3 font-semibold text-bridge-900 whitespace-nowrap">Duration</th>
                  <th class="px-4 py-3"></th>
                </tr>
              </thead>
              <tbody>
                {courses.map(c => (
                  <tr class="border-b border-black/5 last:border-0">
                    <td class="px-4 py-3 font-medium text-bridge-900">{c.name}</td>
                    <td class="px-4 py-3 text-ink/70 whitespace-nowrap">{c.level}</td>
                    <td class="px-4 py-3 text-ink/70 whitespace-nowrap">{c.duration}</td>
                    <td class="px-4 py-3 text-right whitespace-nowrap">
                      <a href="/apply-now" class="text-sm font-semibold text-sunrise-600 hover:underline">Learn more</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <a href={`/programs?university=${encodeURIComponent(u.name)}`} class="btn-outline mt-5 inline-flex">See these in the course search</a>
        </div>
      )}

      {u.entry_requirements && (
        <div id="entry" class="scroll-mt-28">
          <h2 class="section-heading">Entry requirements</h2>
          {paragraphs(u.entry_requirements).map(p => <p class="mt-4 text-ink/70 leading-relaxed">{p}</p>)}
        </div>
      )}

      {(feeRange || u.scholarships_info) && (
        <div id="fees" class="scroll-mt-28">
          <h2 class="section-heading">Fees and scholarships</h2>
          {feeRange && (
            <p class="mt-4 text-ink/70 leading-relaxed">Tuition for international students is typically in the range of
              <span class="font-semibold text-bridge-900"> {feeRange}</span> per year, depending on the course.</p>
          )}
          {u.scholarships_info && paragraphs(u.scholarships_info).map(p => <p class="mt-4 text-ink/70 leading-relaxed">{p}</p>)}
        </div>
      )}

      {(u.rankings_note || (u.ranking && u.ranking !== 'Not Ranked')) && (
        <div id="rankings" class="scroll-mt-28">
          <h2 class="section-heading">University rankings</h2>
          {u.ranking && u.ranking !== 'Not Ranked' && (
            <p class="mt-4 inline-block rounded-lg bg-bridge-50 border border-black/10 px-4 py-2 text-sm text-ink/75">
              QS World University Rankings: <span class="font-semibold text-bridge-900">{u.ranking}</span>
            </p>
          )}
          {u.rankings_note && paragraphs(u.rankings_note).map(p => <p class="mt-4 text-ink/70 leading-relaxed">{p}</p>)}
        </div>
      )}

      {u.facilities && (
        <div id="facilities" class="scroll-mt-28">
          <h2 class="section-heading">Campus and facilities</h2>
          {paragraphs(u.facilities).map(p => <p class="mt-4 text-ink/70 leading-relaxed">{p}</p>)}
        </div>
      )}

      {u.services && (
        <div id="services" class="scroll-mt-28">
          <h2 class="section-heading">Services for international students</h2>
          {paragraphs(u.services).map(p => <p class="mt-4 text-ink/70 leading-relaxed">{p}</p>)}
        </div>
      )}

      {u.student_life && (
        <div id="student-life" class="scroll-mt-28">
          <h2 class="section-heading">International student life</h2>
          {paragraphs(u.student_life).map(p => <p class="mt-4 text-ink/70 leading-relaxed">{p}</p>)}
        </div>
      )}

      {u.accommodation && (
        <div id="accommodation" class="scroll-mt-28">
          <h2 class="section-heading">Accommodation</h2>
          {paragraphs(u.accommodation).map(p => <p class="mt-4 text-ink/70 leading-relaxed">{p}</p>)}
        </div>
      )}

      {!u.overview && (
        <div class="rounded-2xl border border-black/10 bg-bridge-50/50 p-6">
          <h2 class="font-display font-bold text-bridge-900">We are still writing this profile</h2>
          <p class="mt-2 text-sm text-ink/70">
            Our counsellors already work with {u.name} — the written guide is on its way.
            In the meantime, ask us anything about courses, fees or entry requirements and we will answer from what the university tells us directly.
          </p>
        </div>
      )}

      <div id="apply" class="scroll-mt-28 rounded-2xl p-6 md:p-8 text-white shadow-xl" style="background-image:linear-gradient(140deg,#2f5182,#aa1821)">
        <h2 class="font-display text-xl font-bold">Thinking about {u.name}?</h2>
        <p class="mt-2 text-white/85 max-w-2xl">
          Our counsellors check your grades, budget and plans against this university before you apply, and handle the application and visa paperwork with you — free, with no obligation.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/free-consultation" class="inline-flex rounded-full bg-white px-6 py-3 text-sm font-semibold text-bridge-900">Book a free consultation</a>
          <a href="/apply-now" class="inline-flex rounded-full border border-white/40 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10 transition">Start an application</a>
        </div>
      </div>

      {verified && (
        <p class="text-xs text-ink/50">
          Tuition, intakes and entry requirements are set by the university and change.
          Last checked {verified} —
          {u.source_url
            ? <a href={u.source_url} target="_blank" rel="noopener noreferrer" class="underline"> confirm on {u.name}’s own pages</a>
            : <span> confirm with the university before you budget or apply</span>}.
        </p>
      )}
    </div>
  </div>
</section>

<script is:inline>
  /* Share: the device's own share sheet where there is one — that is what a
     student on a phone expects — and a copied link everywhere else. No
     third-party share buttons, which would load tracking script on a page
     that otherwise loads none. */
  (function () {
    var btn = document.getElementById('shareBtn');
    if (!btn) return;
    btn.addEventListener('click', async function () {
      var data = { title: document.title, url: location.href };
      try {
        if (navigator.share) { await navigator.share(data); return; }
        await navigator.clipboard.writeText(location.href);
        var original = btn.innerHTML;
        btn.textContent = 'Link copied';
        setTimeout(function () { btn.innerHTML = original; }, 1800);
      } catch (e) { /* dismissed by the user — nothing to report */ }
    });
  })();

  /* Mark the section you are reading in the left menu. A long profile is
     easier to hold on to when the menu says where you are, not just where you
     could go. */
  (function () {
    var links = Array.prototype.slice.call(document.querySelectorAll('[data-uni-nav]'));
    if (!links.length) return;
    var panes = links
      .map(function (a) { return document.getElementById(a.dataset.uniNav); })
      .filter(Boolean);

    function setActive(id) {
      links.forEach(function (a) {
        var on = a.dataset.uniNav === id;
        a.classList.toggle('bg-bridge-50', on);
        a.classList.toggle('border-bridge-800/40', on);
        a.classList.toggle('font-semibold', on);
        a.classList.toggle('text-bridge-800', on);
      });
    }

    var seen = {};
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { seen[e.target.id] = e.intersectionRatio; });
      var best = null, bestRatio = 0;
      Object.keys(seen).forEach(function (id) {
        if (seen[id] > bestRatio) { bestRatio = seen[id]; best = id; }
      });
      if (best) setActive(best);
    }, { rootMargin: '-120px 0px -55% 0px', threshold: [0, 0.2, 0.5, 1] });

    panes.forEach(function (p) { io.observe(p); });
  })();
</script>

</Layout>
