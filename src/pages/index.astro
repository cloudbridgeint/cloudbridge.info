---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getAllContent, c, cImage, getUniversities, getFaqs, getPublishedBlogPosts, getNextEvent, mediaUrl } from '../lib/content';
import heroSlide1 from '../assets/hero/slide1.jpg';
import heroSlide2 from '../assets/hero/slide2.jpg';
import heroSlide3 from '../assets/hero/slide3.jpg';
import admissionExpert from '../assets/admission-expert.jpg';
import entryConsultation from '../assets/entry-consultation.jpg';
import blogStudyUk from '../assets/blog/study-uk.jpg';
import blogStudyUsa from '../assets/blog/study-usa.jpg';
import blogStudyEurope from '../assets/blog/study-europe.jpg';
const title = "CloudBridge — Study Abroad Consultancy | UK, Malaysia & USA";
const description = "CloudBridge guides students across Bangladesh into top universities in the UK, Malaysia, and the USA — free counselling, university selection, and visa support.";

export const prerender = false;
const db = (Astro.locals as any).runtime.env.DB;
const cm = await getAllContent(db);
const universities = await getUniversities(db);
const faqs = await getFaqs(db);

const nextEvent = await getNextEvent(db);

const eventDateLabel = nextEvent?.event_date
  ? new Date(nextEvent.event_date + 'T00:00:00').toLocaleDateString('en-GB',
      { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
  : '';

const grouped: Record<string, any[]> = {};
for (const u of universities) {
  (grouped[u.country] ||= []).push(u);
}

// Tab order is set by hand rather than alphabetically — this is the order the
// destinations are actually promoted in. Anything not listed here still shows,
// appended alphabetically, so adding a new country in the admin never makes it
// disappear from the homepage.
const COUNTRY_ORDER = ['UK', 'USA', 'Canada', 'Finland', 'France', 'Malta',
                       'Netherlands', 'New Zealand', 'Spain', 'Malaysia'];
const orderedCountries = Object.keys(grouped).sort((a, b) => {
  const ia = COUNTRY_ORDER.indexOf(a);
  const ib = COUNTRY_ORDER.indexOf(b);
  if (ia === -1 && ib === -1) return a.localeCompare(b);
  if (ia === -1) return 1;
  if (ib === -1) return -1;
  return ia - ib;
});
const uniByCountry: Record<string, any[]> = {};
for (const country of orderedCountries) uniByCountry[country] = grouped[country];
---
<Layout title={title} description={description}>

<section class="relative overflow-hidden bg-bridge-950 text-white" id="heroSlider">

  <div class="slider-slide relative min-h-[480px] md:min-h-[560px] flex items-center" data-slide="0">
    {cm['home.hero.slide1.image'] ? (
      <img src={cImage(cm, 'home.hero.slide1.image', '')} alt={c(cm, 'home.hero.slide1.heading', 'Your Bridge to Studying Abroad')} class="absolute inset-0 w-full h-full object-cover hero-img-1" loading="eager" fetchpriority="high">
    ) : (
      <Image src={heroSlide1} alt="A student ready to study abroad, with landmarks from partner destination countries in the background" class="absolute inset-0 w-full h-full object-cover hero-img-1" loading="eager" fetchpriority="high" widths={[480, 768, 1200, 1920]} sizes="100vw" />
    )}
    <div class="absolute inset-0 bg-gradient-to-r from-cloud/50 via-cloud/25 to-transparent"></div>
    <div class="relative max-w-container mx-auto px-4 md:px-8 w-full">
      <div class="max-w-xl">
        <p class="inline-block mb-4 px-4 py-1 rounded-full border border-bridge-900/15 text-sunrise-600 text-sm font-medium">{c(cm, 'home.hero.slide1.badge', 'Overseas Education Consultancy')}</p>
        <h1 class="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight text-bridge-950" style="font-family:'Times New Roman', Times, serif" set:html={c(cm, 'home.hero.slide1.heading', "Your Bridge to<br class='md:hidden'> Studying Abroad")} />
        <p class="mt-5 max-w-md text-ink/70">{c(cm, 'home.hero.slide1.text', 'From university selection to visa approval — CloudBridge guides students across Bangladesh into universities in the UK, Malaysia, and the USA.')}</p>
        <a href="/apply-now" class="btn-primary nav-link mt-7 inline-flex">Apply Now</a>
      </div>
    </div>
  </div>

  <div class="slider-slide hidden relative min-h-[480px] md:min-h-[560px] flex items-center" data-slide="1">
    {cm['home.hero.slide2.image'] ? (
      <img src={cImage(cm, 'home.hero.slide2.image', '')} alt={c(cm, 'home.hero.slide2.heading', 'Fall 2026 Intake Open Now')} class="absolute inset-0 w-full h-full object-cover" style="object-position:76% center">
    ) : (
      <Image src={heroSlide2} alt="A student ready to study in the UK, with Big Ben and London landmarks in the background" class="absolute inset-0 w-full h-full object-cover" style="object-position:76% center" widths={[480, 768, 1200, 1920]} sizes="100vw" />
    )}
    <div class="absolute inset-0 bg-gradient-to-r from-cloud/50 via-cloud/25 to-transparent"></div>
    <div class="relative max-w-container mx-auto px-4 md:px-8 w-full">
      <div class="max-w-xl">
        <p class="inline-block mb-4 px-4 py-1 rounded-full border border-bridge-900/15 text-sunrise-600 text-sm font-medium">{c(cm, 'home.hero.slide2.badge', 'Admissions Open')}</p>
        <h1 class="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight text-bridge-950" style="font-family:'Times New Roman', Times, serif" set:html={c(cm, 'home.hero.slide2.heading', "Fall 2026 Intake<br class='md:hidden'> Open Now")} />
        <p class="mt-5 max-w-md text-ink/70">{c(cm, 'home.hero.slide2.text', '100% free end-to-end counseling and application processing — from shortlisting your university to visa approval.')}</p>
        <a href="/apply-now" class="btn-primary nav-link mt-7 inline-flex">Apply Now</a>
      </div>
    </div>
  </div>

  <div class="slider-slide hidden relative min-h-[480px] md:min-h-[560px] flex items-center" data-slide="2">
    {cm['home.hero.slide3.image'] ? (
      <img src={cImage(cm, 'home.hero.slide3.image', '')} alt={c(cm, 'home.hero.slide3.heading', 'Scholarships at 500+ Universities')} class="absolute inset-0 w-full h-full object-cover hero-img-3">
    ) : (
      <Image src={heroSlide3} alt="A student ready to study abroad, with a university campus in the background" class="absolute inset-0 w-full h-full object-cover hero-img-3" widths={[480, 768, 1200, 1920]} sizes="100vw" />
    )}
    <div class="absolute inset-0 bg-gradient-to-r from-cloud/50 via-cloud/25 to-transparent"></div>
    <div class="relative max-w-container mx-auto px-4 md:px-8 w-full">
      <div class="max-w-xl">
        <p class="inline-block mb-4 px-4 py-1 rounded-full border border-bridge-900/15 text-sunrise-600 text-sm font-medium">{c(cm, 'home.hero.slide3.badge', 'Scholarships')}</p>
        <h1 class="text-3xl md:text-5xl font-extrabold leading-tight tracking-tight text-bridge-950" style="font-family:'Times New Roman', Times, serif">{c(cm, 'home.hero.slide3.heading', 'Scholarships at 500+ Universities')}</h1>
        <p class="mt-5 max-w-md text-ink/70">{c(cm, 'home.hero.slide3.text', 'Let our counsellors match you with funding you actually qualify for — most students never even check.')}</p>
        <a href="/apply-now" class="btn-primary nav-link mt-7 inline-flex">Apply Now</a>
      </div>
    </div>
  </div>

  <div class="hidden lg:flex absolute right-10 top-1/2 -translate-y-1/2 z-20 flex-col items-center justify-center w-52 aspect-square rounded-2xl text-center shadow-2xl px-5" style="background-image:linear-gradient(135deg,#2f5182,#aa1821)">
    <p class="font-display text-5xl font-extrabold leading-none">{c(cm, 'home.hero.badge_number', '7')}<span class="text-sunrise-100 align-top text-2xl">+</span></p>
    <p class="mt-1 text-base font-semibold">{c(cm, 'home.hero.badge_label', 'years')}</p>
    <p class="mt-2 text-xs text-white/85 leading-snug">{c(cm, 'home.hero.badge_subtext', 'of student service excellence')}</p>
  </div>

  <button onclick="sliderMove(-1)" class="slider-arrow" style="left:1rem" aria-label="Previous slide">‹</button>
  <button onclick="sliderMove(1)" class="slider-arrow" style="right:1rem" aria-label="Next slide">›</button>

  <div class="absolute bottom-5 inset-x-0 z-20 flex justify-center gap-2">
    <button class="slider-dot w-2.5 h-2.5 rounded-full bg-sunrise-400" data-dot="0" onclick="sliderGoTo(0)" aria-label="Slide 1"></button>
    <button class="slider-dot w-2.5 h-2.5 rounded-full bg-white/30" data-dot="1" onclick="sliderGoTo(1)" aria-label="Slide 2"></button>
    <button class="slider-dot w-2.5 h-2.5 rounded-full bg-white/30" data-dot="2" onclick="sliderGoTo(2)" aria-label="Slide 3"></button>
  </div>
</section>

{nextEvent && (
<section class="py-16 bg-bridge-50/50">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-10 items-center">
    <div class="rounded-2xl h-64 md:h-80 overflow-hidden">
      {nextEvent.image ? (
        <img src={mediaUrl(nextEvent.image, '/assets/logo.png')} alt={nextEvent.title} class="w-full h-full object-cover">
      ) : (
        <div class="w-full h-full flex flex-col items-center justify-center text-white text-center px-6"
             style="background-image:linear-gradient(160deg,#0f1c30 0%,#1c3255 45%,#2f5182 100%)">
          <p class="font-display text-5xl md:text-6xl font-extrabold leading-none">
            {new Date(nextEvent.event_date + 'T00:00:00').getDate()}
          </p>
          <p class="mt-1 font-display font-semibold uppercase tracking-widest text-sm text-white/80">
            {new Date(nextEvent.event_date + 'T00:00:00').toLocaleDateString('en-GB', { month: 'long' })}
          </p>
          <p class="mt-4 text-white/70 text-sm max-w-xs">{nextEvent.location || 'Venue to be announced'}</p>
        </div>
      )}
    </div>
    <div>
      <p class="text-sunrise-600 font-display font-semibold text-sm uppercase tracking-wide mb-3">Upcoming Event</p>
      <h2 class="section-heading">{nextEvent.title}</h2>
      <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink/70">
        <span class="inline-flex items-center gap-2">
          <svg viewBox="0 0 24 24" class="w-4 h-4 text-sunrise-600" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
          {eventDateLabel}
        </span>
        {nextEvent.location && (
          <span class="inline-flex items-center gap-2">
            <svg viewBox="0 0 24 24" class="w-4 h-4 text-sunrise-600" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-5.2 7-10a7 7 0 1 0-14 0c0 4.8 7 10 7 10Z"/><circle cx="12" cy="11" r="2.5"/></svg>
            {nextEvent.location}
          </span>
        )}
      </div>
      {nextEvent.description && <p class="mt-4 text-ink/60">{nextEvent.description}</p>}
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`/?event=${encodeURIComponent(nextEvent.title)}#lead-form`} class="btn-primary nav-link inline-flex">Register Now</a>
        <a href="/events" class="btn-outline nav-link inline-flex">See all events</a>
      </div>
    </div>
  </div>
</section>
)}

<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="section-heading text-center">{c(cm, 'home.destination.heading', 'Choose Your Destination')}</h2>
      <p class="mt-3 text-ink/60">Every country we work with, hand-picked for strong outcomes for Bangladeshi students.</p>
    </div>
    <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <a href="/dest-uk" class="nav-link group relative h-72 rounded-2xl overflow-hidden flex flex-col justify-end card-photo" style="background-image:linear-gradient(0deg,rgba(15,28,48,.35),rgba(15,28,48,.1)),url('/assets/destinations/uk.jpg')">
        <div class="absolute inset-0 bg-gradient-to-t from-bridge-950/85 via-bridge-950/10 to-transparent"></div>
        <div class="relative p-5 text-white"><h3 class="font-display text-xl font-bold">United Kingdom</h3><p class="mt-1 text-sm text-white/75">Globally respected degrees and diverse study opportunities.</p></div>
      </a>
      <a href="/dest-malaysia" class="nav-link group relative h-72 rounded-2xl overflow-hidden flex flex-col justify-end card-photo" style="background-image:linear-gradient(0deg,rgba(15,28,48,.35),rgba(15,28,48,.1)),url('/assets/destinations/malaysia.jpg')">
        <div class="absolute inset-0 bg-gradient-to-t from-bridge-950/85 via-bridge-950/10 to-transparent"></div>
        <div class="relative p-5 text-white"><h3 class="font-display text-xl font-bold">Malaysia</h3><p class="mt-1 text-sm text-white/75">English-medium education with affordable living costs.</p></div>
      </a>
      <a href="/dest-usa" class="nav-link group relative h-72 rounded-2xl overflow-hidden flex flex-col justify-end card-photo" style="background-image:linear-gradient(0deg,rgba(15,28,48,.35),rgba(15,28,48,.1)),url('/assets/destinations/usa.jpg')">
        <div class="absolute inset-0 bg-gradient-to-t from-bridge-950/85 via-bridge-950/10 to-transparent"></div>
        <div class="relative p-5 text-white"><h3 class="font-display text-xl font-bold">USA</h3><p class="mt-1 text-sm text-white/75">Small classes, academic freedom, strong mentorship.</p></div>
      </a>
    </div>
    <div class="mt-8 text-center">
      <a href="/destinations" class="nav-link btn-outline see-more-btn !rounded-lg">See More</a>
    </div>
  </div>
</section>

<section class="py-12 bg-white border-y border-black/5">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mb-6">{c(cm, 'home.universities.heading', 'Featured Universities')}</h2>
    <div class="flex flex-wrap justify-center gap-2 mb-8">
      {Object.keys(uniByCountry).map((country, idx) => (
        <button class={`uni-tab-btn btn-outline !text-xs ${idx === 0 ? 'active' : ''}`} data-tab={country}>{country}</button>
      ))}
    </div>
    {Object.entries(uniByCountry).map(([country, unis], idx) => (
      <div class={`uni-tab-panel ${idx === 0 ? '' : 'hidden'}`} data-panel={country}>
        <div class="uni-logo-viewport overflow-hidden">
          <div class="uni-logo-track flex gap-4">
            {[...unis, ...unis].map((u: any) => (
              <div class="uni-logo-item shrink-0 h-24 w-40 rounded-lg bg-white border border-black/10 shadow flex items-center justify-center p-4">
                <img src={u.logo_url ? (u.logo_url.startsWith('media:') ? `/api/media/${u.logo_url.slice(6)}` : u.logo_url) : '/assets/logo.png'} alt={u.name} class="max-h-full max-w-full object-contain" loading="lazy" decoding="async">
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}
    {universities.length === 0 && (
      <p class="text-center text-xs text-ink/30 mt-4">No universities added yet — add some from the admin panel.</p>
    )}
  </div>
</section>


<section class="py-16 bg-bridge-50/50">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-10 items-center">
    <div class="order-2 md:order-1 rounded-2xl h-64 md:h-80 overflow-hidden">
      {cm['home.admission_expert.image'] ? (
        <img src={cImage(cm, 'home.admission_expert.image', '')} alt="A university admission expert consulting with a student about study abroad options" class="w-full h-full object-cover">
      ) : (
        <Image src={admissionExpert} alt="A university admission expert consulting with a student about study abroad options" class="w-full h-full object-cover" widths={[400, 640, 960]} sizes="(min-width: 768px) 50vw, 100vw" />
      )}
    </div>
    <div class="order-1 md:order-2">
      <p class="text-sunrise-600 font-display font-semibold text-sm uppercase tracking-wide mb-3">Free Consultation</p>
      <h2 class="section-heading">{c(cm, 'home.admission_expert.heading', 'Talk with University Admission Expert')}</h2>
      <p class="mt-4 text-ink/60">{c(cm, 'home.admission_expert.text', 'Get personalised guidance from our expert counsellors on choosing the right university, course, and destination for your goals — completely free, with no obligation.')}</p>
      <a href="/#lead-form" class="btn-primary nav-link mt-6 inline-flex">Send Admission Query</a>
    </div>
  </div>
</section>

<section class="bg-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="section-heading text-center">{c(cm, 'home.trusted.heading', 'Trusted education consultant')}</h2>
      <p class="mt-3 text-ink/60">{c(cm, 'home.trusted.text', 'Our company has grown by helping international students find admission to universities abroad.')}</p>
    </div>
    <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      <div><p class="counter font-display text-4xl font-extrabold text-bridge-700" data-target={c(cm, 'home.trusted.stat_students', '10000')}>0</p><p class="mt-2 text-sm font-medium text-ink/60">Students Placed</p></div>
      <div><p class="counter font-display text-4xl font-extrabold text-bridge-700" data-target={c(cm, 'home.trusted.stat_universities', '500')}>0</p><p class="mt-2 text-sm font-medium text-ink/60">Partner Universities</p></div>
      <div><p class="counter font-display text-4xl font-extrabold text-bridge-700" data-target={c(cm, 'home.trusted.stat_years', '13')} data-suffix="">0</p><p class="mt-2 text-sm font-medium text-ink/60">Years of Experience</p></div>
      <div><p class="counter font-display text-4xl font-extrabold text-bridge-700" data-target={c(cm, 'home.trusted.stat_visa_rate', '99')} data-suffix="%">0</p><p class="mt-2 text-sm font-medium text-ink/60">Visa Success Rate</p></div>
    </div>
  </div>
</section>

<section class="py-16 bg-bridge-50/50">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="section-heading text-center">{c(cm, 'home.entry_requirements.heading', 'Get Your Entry Requirements')}</h2>
      <p class="mt-3 text-ink/60">{c(cm, 'home.entry_requirements.text', "Fill up the form and we'll send you the exact entry requirements for your destination, university, and program of choice.")}</p>
    </div>
    <div class="mt-10 grid md:grid-cols-2 gap-8 items-stretch">
      <div class="relative rounded-2xl overflow-hidden min-h-[320px] md:min-h-[480px]">
        {cm['home.entry_requirements.image'] ? (
          <img src={cImage(cm, 'home.entry_requirements.image', '')} alt="A CloudBridge counsellor reviewing entry requirements with a student" class="absolute inset-0 w-full h-full object-cover">
        ) : (
          <Image src={entryConsultation} alt="A CloudBridge counsellor reviewing entry requirements with a student" class="absolute inset-0 w-full h-full object-cover" widths={[400, 640, 960]} sizes="(min-width: 768px) 50vw, 100vw" />
        )}
        <div class="absolute inset-0 bg-gradient-to-t from-bridge-950/85 via-bridge-950/25 to-transparent"></div>
        <div class="absolute left-6 right-6 bottom-6 md:left-8 md:right-8 md:bottom-8">
          <p class="inline-block px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-sunrise-200 text-xs font-semibold">500+ Partner Universities</p>
          <h3 class="mt-3 text-white text-xl md:text-2xl font-display font-bold leading-snug">Your Future Starts With the Right Requirements</h3>
        </div>
      </div>
      <div>
        <form class="demo-form grid sm:grid-cols-2 gap-4 bg-white rounded-2xl p-6 md:p-8 shadow-sm ring-1 ring-black/5" data-source="free-consultation">
          <h3 class="section-heading !text-2xl text-center sm:col-span-2 mb-1">Start Your Journey Now</h3>
          <input name="firstName" required placeholder="First name" class="form-input rounded-xl border border-black/10 px-4 py-3 text-sm">
          <input name="lastName" required placeholder="Last name" class="form-input rounded-xl border border-black/10 px-4 py-3 text-sm">
          <input name="phone" required placeholder="Phone number (WhatsApp)" class="form-input rounded-xl border border-black/10 px-4 py-3 text-sm">
          <input name="email" type="email" required placeholder="Email address" class="form-input rounded-xl border border-black/10 px-4 py-3 text-sm">
          <select name="residenceCountry" class="form-input rounded-xl border border-black/10 px-4 py-3 text-sm text-ink/70"><option value="">Country of residence</option><option>Bangladesh</option><option>India</option><option>UAE</option><option>Saudi Arabia</option><option>Other</option></select>
          <div>
            <select id="destinationSelect2" onchange="toggleOtherDestination2()" class="form-input rounded-xl border border-black/10 px-4 py-3 text-sm text-ink/70 w-full">
              <option value="">Preferred destination</option>
              <option>United Kingdom</option>
              <option>USA</option>
              <option>Canada</option>
              <option>Malta</option>
              <option>France</option>
              <option>Spain</option>
              <option>Finland</option>
              <option>New Zealand</option>
              <option>Netherlands</option>
              <option>Malaysia</option>
              <option value="Other">Other</option>
            </select>
            <input type="text" id="otherDestinationInput2" placeholder="Please specify your preferred country" class="form-input hidden mt-3 rounded-xl border border-black/10 px-4 py-3 text-sm w-full">
          </div>
          <select name="degreeLevel" class="form-input rounded-xl border border-black/10 px-4 py-3 text-sm text-ink/70"><option value="">Most recently completed degree</option><option>SSC / O Levels</option><option>HSC / A Levels</option><option>Diploma</option><option>Bachelor's</option><option>Master's</option></select>
          <div class="relative" id="subjectCombo2">
            <input type="text" readonly id="subjectDisplay2" placeholder="Subject interested" onclick="toggleSubjectDropdown2()" class="form-input rounded-xl border border-black/10 px-4 py-3 text-sm w-full cursor-pointer bg-white">
            <svg viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 absolute right-3 top-1/2 -translate-y-1/2 text-ink/40 pointer-events-none"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
            <div id="subjectPanel2" class="hidden absolute z-20 mt-2 w-full bg-white rounded-xl shadow-lg border border-black/10 overflow-hidden flex flex-col">
              <input type="text" id="subjectSearch2" placeholder="Search subjects..." oninput="filterSubjects2()" class="border-b border-black/10 px-4 py-2.5 text-sm outline-none">
              <div id="subjectList2" class="max-h-56 overflow-y-auto"></div>
            </div>
          </div>
          <div class="sm:col-span-2">
            <p class="text-sm text-ink/70 mb-2">English proficiency test <span class="text-ink/40 font-normal">(select all that apply)</span></p>
            <div class="flex flex-wrap gap-x-4 gap-y-2 rounded-xl border border-black/10 px-4 py-3">
              <label class="flex items-center gap-1.5 text-sm text-ink/70"><input type="checkbox" class="uni-filter-check" name="engTest2" value="IELTS"> IELTS</label>
              <label class="flex items-center gap-1.5 text-sm text-ink/70"><input type="checkbox" class="uni-filter-check" name="engTest2" value="TOEFL"> TOEFL</label>
