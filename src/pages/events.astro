---
import Layout from '../layouts/Layout.astro';
import { getPublishedEvents, mediaUrl } from '../lib/content';
export const prerender = false;
const title = "Events | CloudBridge Study Abroad";
const description = "Upcoming CloudBridge education fairs, webinars, and campus events for students planning to study abroad.";
const db = (Astro.locals as any).runtime.env.DB;
const events = await getPublishedEvents(db);

const gradients = [
  'linear-gradient(160deg,#2e4a7a,#4d70a8)',
  'linear-gradient(160deg,#1e786e,#22a396)',
  'linear-gradient(160deg,#963c3c,#c25a5a)',
  'linear-gradient(160deg,#6b4a9e,#9370c9)',
];
function formatDate(dateStr: string) {
  if (!dateStr) return 'Date TBA';
  const d = new Date(dateStr + 'T00:00:00');
  if (isNaN(d.getTime())) return dateStr;
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}
---
<Layout title={title} description={description}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / Events</p>
    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">Events</h1>
    <p class="mt-4 max-w-xl text-white/75">Join our expos, seminars, and info sessions to get expert guidance in person.</p>
  </div>
</section>
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    {events.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {events.map((ev: any, i: number) => (
          <div class="bg-white rounded-2xl overflow-hidden ring-1 ring-black/5">
            {ev.image ? (
              <img src={mediaUrl(ev.image, '')} alt={ev.title} class="h-36 w-full object-cover">
            ) : (
              <div class="h-36" style={`background:${gradients[i % gradients.length]}`}></div>
            )}
            <div class="p-5">
              <p class="text-xs text-ink/50">{formatDate(ev.event_date)}{ev.location ? ` · ${ev.location}` : ''}</p>
              <h3 class="mt-1 font-display font-bold text-bridge-900">{ev.title}</h3>
              {ev.description && <p class="mt-2 text-sm text-ink/60">{ev.description}</p>}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-ink/60">No upcoming events right now — check back soon.</p>
    )}
    <p class="mt-8 text-sm text-ink/50">More events added regularly — check back soon.</p>
    <div class="mt-8"><a href="/#lead-form" class="btn-primary nav-link inline-flex">Reserve Your Seat</a></div>
  </div>
</section>

</Layout>
