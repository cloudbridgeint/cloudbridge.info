---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import teamShahan from '../assets/team/shahan.jpg';
import teamAriful from '../assets/team/ariful.jpg';
import teamSunny from '../assets/team/sunny.jpg';
import teamMehedi from '../assets/team/mehedi.jpg';
import teamMim from '../assets/team/mim.jpg';
import teamMahi from '../assets/team/mahi.jpg';
import teamFahim from '../assets/team/fahim.jpg';
const title = "About Us | CloudBridge Study Abroad Consultancy";
const description = "Learn how CloudBridge supports students from university shortlisting to visa approval, with expert counsellors guiding every step abroad.";
---
<Layout title={title} description={description}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / About us</p>
    <p class="inline-block mt-4 mb-4 px-4 py-1 rounded-full border border-white/20 text-sunrise-200 text-sm font-medium">About CloudBridge</p>
    <h1 class="text-3xl md:text-5xl font-extrabold leading-tight max-w-2xl">Your partner from application to arrival</h1>
    <p class="mt-4 max-w-xl text-white/75">Cloud Bridge — International Student Consultancy (CBC) has been guiding Bangladeshi students to universities abroad since 2019.</p>
  </div>
</section>

<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-10 items-center">
    <div class="order-2 md:order-1 rounded-2xl h-72 md:h-80" style="background-image:linear-gradient(160deg,#1c3255,#4d70a8)"></div>
    <div class="order-1 md:order-2">
      <h2 class="section-heading">About Cloud Bridge (CBC)</h2>
      <p class="mt-4 text-ink/70 leading-relaxed"><span class="font-semibold text-bridge-900">Cloud Bridge — International Student Consultancy (CBC)</span> is a study-abroad consultancy committed to helping ambitious Bangladeshi students reach the right university, in the right country, without the guesswork. We believe access to quality international education shouldn't depend on who you already know.</p>
      <p class="mt-4 text-ink/70 leading-relaxed">We follow ethical counselling practices in line with recognised international education standards — honest advice, no hidden costs, and no pressure to choose a university just because it pays the highest commission. Integrity, transparency, and respect for every student's goals sit behind every recommendation we make.</p>
      <p class="mt-4 text-ink/70 leading-relaxed">Since 2019, CBC has grown from a single Dhaka office into a team spanning Dhaka and Sylhet, supporting students across 10 countries — from first shortlisting a course to settling into life abroad.</p>
    </div>
  </div>
</section>

<section class="py-16 bg-bridge-50/50">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-10 items-center">
    <div>
      <h2 class="section-heading">Our Mission</h2>
      <p class="mt-4 text-ink/70 leading-relaxed">Our mission is to guide students toward academic excellence and a career path that actually fits them — through free, personalised counselling from day one.</p>
      <p class="mt-4 text-ink/70 leading-relaxed">We help students understand entry requirements, realistic tuition and living costs, and scholarship options for their destination — then match them honestly to courses they're genuinely qualified for, not just the ones easiest for us to sell.</p>
      <p class="mt-4 text-ink/70 leading-relaxed">Every student works with a dedicated counsellor who stays with them through the entire process — application, visa, and beyond.</p>
    </div>
    <div class="rounded-2xl h-72 md:h-80" style="background-image:linear-gradient(160deg,#963c3c,#c25a5a)"></div>
  </div>
</section>

<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-10 items-center">
    <div class="order-2 md:order-1 rounded-2xl h-72 md:h-80" style="background-image:linear-gradient(160deg,#1e786e,#22a396)"></div>
    <div class="order-1 md:order-2">
      <h2 class="section-heading">Our Vision</h2>
      <p class="mt-4 text-ink/70 leading-relaxed">Our vision is to be the education consultancy Bangladeshi students trust first — recognised not for the loudest marketing, but for consistently getting students into universities that are genuinely right for them.</p>
      <p class="mt-4 text-ink/70 leading-relaxed">We're working toward a future where every aspiring student, in Dhaka, Sylhet, or beyond, can access the same quality of guidance without traveling far or paying a taka in consultancy fees — with a growing office network and a digital-first application process that removes friction at every step.</p>
    </div>
  </div>
</section>

<section class="py-16 text-white text-center" style="background-image:linear-gradient(120deg,#0f1c30,#1c3255 45%,#aa1821)">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="text-xs font-semibold uppercase tracking-widest text-white/70">10,000+ Students Served Since 2019</p>
    <h2 class="mt-3 text-2xl md:text-4xl font-extrabold max-w-2xl mx-auto">Start Your Journey Today, Achieve More Tomorrow</h2>
    <div class="mt-7 flex flex-wrap justify-center gap-4">
      <a href="/blogs" class="btn-primary nav-link !rounded-lg">Read Success Stories</a>
      <a href="/contact" class="btn-secondary nav-link !rounded-lg">Contact Us</a>
    </div>
  </div>
</section>

<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mx-auto">Key Skills and Core Competences Gained</h2>
    <p class="mt-3 text-ink/60 text-center max-w-xl mx-auto">What students walk away with, beyond just an offer letter.</p>
    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
      <div class="text-center"><div class="w-14 h-14 mx-auto rounded-full bg-white shadow-sm ring-1 ring-black/5 flex items-center justify-center text-sunrise-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0 0l-4-4m4 4l4-4" /></svg></div><p class="mt-3 text-xs font-semibold text-bridge-900">Adaptability &amp; Flexibility</p></div>
      <div class="text-center"><div class="w-14 h-14 mx-auto rounded-full bg-white shadow-sm ring-1 ring-black/5 flex items-center justify-center text-sunrise-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z" /></svg></div><p class="mt-3 text-xs font-semibold text-bridge-900">Effective Problem-Solving</p></div>
      <div class="text-center"><div class="w-14 h-14 mx-auto rounded-full bg-white shadow-sm ring-1 ring-black/5 flex items-center justify-center text-sunrise-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4-.8L3 20l1.3-3.9A7.9 7.9 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg></div><p class="mt-3 text-xs font-semibold text-bridge-900">Strong Communication Skills</p></div>
      <div class="text-center"><div class="w-14 h-14 mx-auto rounded-full bg-white shadow-sm ring-1 ring-black/5 flex items-center justify-center text-sunrise-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 3v18M3 9h18M3 15h18" /></svg></div><p class="mt-3 text-xs font-semibold text-bridge-900">Analytical Thinking &amp; Decision Making</p></div>
      <div class="text-center"><div class="w-14 h-14 mx-auto rounded-full bg-white shadow-sm ring-1 ring-black/5 flex items-center justify-center text-sunrise-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m5-3.13a4 4 0 100-8 4 4 0 000 8zm7 3.13a4 4 0 00-3-3.87M6.5 9.13A4 4 0 1010 5" /></svg></div><p class="mt-3 text-xs font-semibold text-bridge-900">Leadership &amp; Teamwork</p></div>
      <div class="text-center"><div class="w-14 h-14 mx-auto rounded-full bg-white shadow-sm ring-1 ring-black/5 flex items-center justify-center text-sunrise-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7a2 2 0 012-2h2a2 2 0 012 2v10m-6 0h6m-6 0H5a2 2 0 01-2-2v-2a2 2 0 012-2h1m13 6h1a2 2 0 002-2v-2a2 2 0 00-2-2h-1" /></svg></div><p class="mt-3 text-xs font-semibold text-bridge-900">Project Management Skills</p></div>
      <div class="text-center"><div class="w-14 h-14 mx-auto rounded-full bg-white shadow-sm ring-1 ring-black/5 flex items-center justify-center text-sunrise-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /></svg></div><p class="mt-3 text-xs font-semibold text-bridge-900">Technical Proficiency</p></div>
      <div class="text-center"><div class="w-14 h-14 mx-auto rounded-full bg-white shadow-sm ring-1 ring-black/5 flex items-center justify-center text-sunrise-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2" /><circle cx="12" cy="12" r="9" /></svg></div><p class="mt-3 text-xs font-semibold text-bridge-900">Time Management &amp; Prioritisation</p></div>
      <div class="text-center"><div class="w-14 h-14 mx-auto rounded-full bg-white shadow-sm ring-1 ring-black/5 flex items-center justify-center text-sunrise-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a4 4 0 115.657 0c-.63.63-1.172 1.34-1.172 2.243V19a1 1 0 01-1 1h-2a1 1 0 01-1-1v-.514c0-.903-.542-1.612-1.172-2.243z" /></svg></div><p class="mt-3 text-xs font-semibold text-bridge-900">Creativity &amp; Innovation</p></div>
      <div class="text-center"><div class="w-14 h-14 mx-auto rounded-full bg-white shadow-sm ring-1 ring-black/5 flex items-center justify-center text-sunrise-600"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 100-18 9 9 0 000 18zm0 0c2.5 0 4.5-4 4.5-9S14.5 3 12 3s-4.5 4-4.5 9 2 9 4.5 9zM3.5 9h17M3.5 15h17" /></svg></div><p class="mt-3 text-xs font-semibold text-bridge-900">Global Perspective</p></div>
    </div>
  </div>
</section>

<section class="py-16 bg-bridge-50/50">
  <div class="max-w-container mx-auto px-4 md:px-8 text-center">
    <h2 class="section-heading text-center mx-auto">Six Reasons to Choose Us</h2>
    <p class="mt-3 text-ink/60 max-w-xl mx-auto">We're committed to supporting you at every step of your journey, from first shortlist to settling in abroad.</p>
    <div class="mt-8 max-w-xl mx-auto bg-white rounded-2xl shadow-sm p-8 text-left space-y-4">
      <p class="flex items-center gap-3 text-ink/80"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-sunrise-600 shrink-0"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>We're with you every step of the way</p>
      <p class="flex items-center gap-3 text-ink/80"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-sunrise-600 shrink-0"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>Student satisfaction is our top priority</p>
      <p class="flex items-center gap-3 text-ink/80"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-sunrise-600 shrink-0"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>A clear, efficient application process</p>
      <p class="flex items-center gap-3 text-ink/80"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-sunrise-600 shrink-0"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>Specialising across 10 countries, not just one</p>
      <p class="flex items-center gap-3 text-ink/80"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-sunrise-600 shrink-0"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>Complimentary end-to-end counselling</p>
      <p class="flex items-center gap-3 font-semibold text-bridge-900"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-sunrise-600 shrink-0"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>Zero consultancy fees for students, guaranteed</p>
    </div>
  </div>
</section>

<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mx-auto">Our Company History</h2>
    <p class="mt-3 text-ink/60 text-center max-w-xl mx-auto">(illustrative timeline — replace with your exact milestones and dates)</p>

    <div class="mt-12 timeline-wrap max-w-3xl mx-auto">
      <div class="timeline-line"></div>

      <div class="relative pl-12 md:pl-0 md:grid md:grid-cols-2 md:gap-10 pb-10">
        <div class="timeline-dot" style="top:0.4rem"></div>
        <div class="md:text-right md:pr-2">
          <div class="timeline-card inline-block text-left">
            <span class="timeline-year">2019</span>
            <h3 class="font-display font-bold text-bridge-900">Established</h3>
            <p class="mt-1 text-sm text-ink/60">Cloud Bridge (CBC) was founded in Dhaka to make studying abroad accessible and transparent for Bangladeshi students.</p>
          </div>
        </div>
        <div class="hidden md:block"></div>
      </div>

      <div class="relative pl-12 md:pl-0 md:grid md:grid-cols-2 md:gap-10 pb-10">
        <div class="timeline-dot" style="top:0.4rem"></div>
        <div class="hidden md:block"></div>
        <div class="md:pl-2">
          <div class="timeline-card inline-block text-left">
            <span class="timeline-year">2020</span>
            <h3 class="font-display font-bold text-bridge-900">Virtual Counselling Launched</h3>
            <p class="mt-1 text-sm text-ink/60">Introduced fully remote counselling and application support so students never had to pause their plans.</p>
          </div>
        </div>
      </div>

      <div class="relative pl-12 md:pl-0 md:grid md:grid-cols-2 md:gap-10 pb-10">
        <div class="timeline-dot" style="top:0.4rem"></div>
        <div class="md:text-right md:pr-2">
          <div class="timeline-card inline-block text-left">
            <span class="timeline-year">2021</span>
            <h3 class="font-display font-bold text-bridge-900">Multi-Country Expansion</h3>
            <p class="mt-1 text-sm text-ink/60">Added partner universities in Canada and mainland Europe alongside our original UK and USA network.</p>
          </div>
        </div>
        <div class="hidden md:block"></div>
      </div>

      <div class="relative pl-12 md:pl-0 md:grid md:grid-cols-2 md:gap-10 pb-10">
        <div class="timeline-dot" style="top:0.4rem"></div>
        <div class="hidden md:block"></div>
        <div class="md:pl-2">
          <div class="timeline-card inline-block text-left">
            <span class="timeline-year">2022</span>
            <h3 class="font-display font-bold text-bridge-900">Sylhet Branch Opened</h3>
            <p class="mt-1 text-sm text-ink/60">Opened our second office in Sylhet to bring in-person counselling closer to students in the northeast.</p>
          </div>
        </div>
      </div>

      <div class="relative pl-12 md:pl-0 md:grid md:grid-cols-2 md:gap-10 pb-10">
        <div class="timeline-dot" style="top:0.4rem"></div>
        <div class="md:text-right md:pr-2">
          <div class="timeline-card inline-block text-left">
            <span class="timeline-year">2023</span>
            <h3 class="font-display font-bold text-bridge-900">5,000+ Students Milestone</h3>
            <p class="mt-1 text-sm text-ink/60">Crossed 5,000 successful student placements across our partner destinations.</p>
          </div>
        </div>
        <div class="hidden md:block"></div>
      </div>

      <div class="relative pl-12 md:pl-0 md:grid md:grid-cols-2 md:gap-10 pb-10">
        <div class="timeline-dot" style="top:0.4rem"></div>
        <div class="hidden md:block"></div>
        <div class="md:pl-2">
          <div class="timeline-card inline-block text-left">
            <span class="timeline-year">2024</span>
            <h3 class="font-display font-bold text-bridge-900">Malaysia &amp; Oceania Added</h3>
            <p class="mt-1 text-sm text-ink/60">Extended our network to Malaysia and New Zealand, rounding out a 10-country portfolio.</p>
          </div>
        </div>
      </div>

      <div class="relative pl-12 md:pl-0 md:grid md:grid-cols-2 md:gap-10 pb-10">
        <div class="timeline-dot" style="top:0.4rem"></div>
        <div class="md:text-right md:pr-2">
          <div class="timeline-card inline-block text-left">
            <span class="timeline-year">2025</span>
            <h3 class="font-display font-bold text-bridge-900">500+ Partner Universities</h3>
            <p class="mt-1 text-sm text-ink/60">Our partner network grew to 500+ universities and colleges across all 10 destinations.</p>
          </div>
        </div>
        <div class="hidden md:block"></div>
      </div>

      <div class="relative pl-12 md:pl-0 md:grid md:grid-cols-2 md:gap-10">
        <div class="timeline-dot" style="top:0.4rem"></div>
        <div class="hidden md:block"></div>
        <div class="md:pl-2">
          <div class="timeline-card inline-block text-left">
            <span class="timeline-year">2026</span>
            <h3 class="font-display font-bold text-bridge-900">Today</h3>
            <p class="mt-1 text-sm text-ink/60">A redesigned digital platform and expanded scholarship support — with plenty more ahead.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="py-16 bg-bridge-50/50">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mx-auto">Our Team Members</h2>
    <p class="mt-3 text-ink/60 text-center max-w-xl mx-auto">The counsellors and staff behind every successful application.</p>

    <div class="mt-10 flex items-center justify-center gap-3 md:gap-8">
      <button id="aboutTeamPrev" type="button" aria-label="Previous team member" class="shrink-0 w-11 h-11 rounded-full bg-white shadow-md ring-1 ring-black/5 flex items-center justify-center text-sunrise-600 hover:bg-sunrise-50 transition">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 010 1.06L9.06 10l3.73 3.71a.75.75 0 11-1.06 1.06l-4.25-4.25a.75.75 0 010-1.06l4.25-4.25a.75.75 0 011.06 0z" clip-rule="evenodd" /></svg>
      </button>
      <div class="max-w-sm w-full">
        <div id="aboutTeamSlider">
        <div class="team-slide active flex-col items-center text-center" data-slide="0">
          <Image src={teamShahan} alt="Mohammed Shahan" class="w-64 h-64 md:w-72 md:h-72 mx-auto rounded-2xl object-cover" widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" />
          <h3 class="mt-4 font-display font-bold text-bridge-900 text-lg">Mohammed Shahan</h3>
          <p class="text-sm text-ink/60">Founder &amp; CEO</p>
        </div>
        <div class="team-slide flex-col items-center text-center" data-slide="1">
