---
/*
 * About us. Everything except the team carousel is editable in the admin:
 * simple fields live in the content table under about.*, and the three
 * repeating lists (skills, reasons, history) live in page_items.
 *
 * The team slides still come from src/assets because they are the same people
 * rendered on /our-team — moving one copy into the database and not the other
 * would leave two sources of truth for the same staff list.
 */
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getAllContent, getPageItemGroups, c, cImage } from '../lib/content';
import { iconPath, iconImage } from '../lib/icons';
import teamShahan from '../assets/team/shahan.jpg';
import teamAriful from '../assets/team/ariful.jpg';
import teamSunny from '../assets/team/sunny.jpg';
import teamMehedi from '../assets/team/mehedi.jpg';
import teamMim from '../assets/team/mim.jpg';
import teamMahi from '../assets/team/mahi.jpg';
import teamFahim from '../assets/team/fahim.jpg';

export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const [cm, groups] = await Promise.all([
  getAllContent(db),
  getPageItemGroups(db, ['about.skills', 'about.reasons', 'about.history']),
]);
const skills = groups['about.skills'];
const reasons = groups['about.reasons'];
const history = groups['about.history'];

const title = c(cm, 'about.meta_title', 'About Us | CloudBridge Study Abroad Consultancy');
const description = c(cm, 'about.meta_description', 'Learn how CloudBridge supports students from university shortlisting to visa approval, with expert counsellors guiding every step abroad.');

/* Each of the three story sections can carry a photograph. Until one is
   uploaded the original gradient panel is kept, so the layout never collapses
   into an empty box. */
const storyImage = (key: string) => cImage(cm, key, '');
const introFallback = "Cloud Bridge — International Student Consultancy (CBC) is a study-abroad consultancy committed to helping ambitious Bangladeshi students reach the right university, in the right country, without the guesswork. We believe access to quality international education shouldn't depend on who you already know.";
---

<Layout title={title} description={description}
        breadcrumbs={[{ name: 'About us', url: 'https://cloudbridge.info/about' }]}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / About us</p>
    <p class="inline-block mt-4 mb-4 px-4 py-1 rounded-full border border-white/20 text-sunrise-200 text-sm font-medium">{c(cm, 'about.hero.badge', 'About CloudBridge')}</p>
    <h1 class="text-3xl md:text-5xl font-extrabold leading-tight max-w-2xl">{c(cm, 'about.hero.heading', 'Your partner from application to arrival')}</h1>
    <p class="mt-4 max-w-xl text-white/75">{c(cm, 'about.hero.text', 'Cloud Bridge — International Student Consultancy (CBC) has been guiding Bangladeshi students to universities abroad since 2019.')}</p>
  </div>
</section>

<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-10 items-center">
    {storyImage('about.intro.image')
      ? <img src={storyImage('about.intro.image')} alt={c(cm, 'about.intro.image_alt', 'The CloudBridge team at work')} loading="lazy" class="order-2 md:order-1 rounded-2xl h-72 md:h-80 w-full object-cover" />
      : <div class="order-2 md:order-1 rounded-2xl h-72 md:h-80" style="background-image:linear-gradient(160deg,#1c3255,#4d70a8)"></div>}
    <div class="order-1 md:order-2">
      <h2 class="section-heading">{c(cm, 'about.intro.heading', 'About Cloud Bridge (CBC)')}</h2>
      <p class="mt-4 text-ink/70 leading-relaxed whitespace-pre-line">{c(cm, 'about.intro.p1', introFallback)}</p>
      <p class="mt-4 text-ink/70 leading-relaxed whitespace-pre-line">{c(cm, 'about.intro.p2', 'We follow ethical counselling practices in line with recognised international education standards — honest advice, no hidden costs, and no pressure to choose a university just because it pays the highest commission. Integrity, transparency, and respect for every student\'s goals sit behind every recommendation we make.')}</p>
      <p class="mt-4 text-ink/70 leading-relaxed whitespace-pre-line">{c(cm, 'about.intro.p3', 'Since 2019, CBC has grown from a single Dhaka office into a team spanning Dhaka and Sylhet, supporting students across 10 countries — from first shortlisting a course to settling into life abroad.')}</p>
    </div>
  </div>
</section>

<section class="py-16 bg-bridge-50/50">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-10 items-center">
    <div>
      <h2 class="section-heading">{c(cm, 'about.mission.heading', 'Our Mission')}</h2>
      <p class="mt-4 text-ink/70 leading-relaxed whitespace-pre-line">{c(cm, 'about.mission.p1', 'Our mission is to guide students toward academic excellence and a career path that actually fits them — through free, personalised counselling from day one.')}</p>
      <p class="mt-4 text-ink/70 leading-relaxed whitespace-pre-line">{c(cm, 'about.mission.p2', "We help students understand entry requirements, realistic tuition and living costs, and scholarship options for their destination — then match them honestly to courses they're genuinely qualified for, not just the ones easiest for us to sell.")}</p>
      <p class="mt-4 text-ink/70 leading-relaxed whitespace-pre-line">{c(cm, 'about.mission.p3', 'Every student works with a dedicated counsellor who stays with them through the entire process — application, visa, and beyond.')}</p>
    </div>
    {storyImage('about.mission.image')
      ? <img src={storyImage('about.mission.image')} alt={c(cm, 'about.mission.image_alt', 'A counsellor advising a student')} loading="lazy" class="rounded-2xl h-72 md:h-80 w-full object-cover" />
      : <div class="rounded-2xl h-72 md:h-80" style="background-image:linear-gradient(160deg,#963c3c,#c25a5a)"></div>}
  </div>
</section>

<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-10 items-center">
    {storyImage('about.vision.image')
      ? <img src={storyImage('about.vision.image')} alt={c(cm, 'about.vision.image_alt', 'Students on campus abroad')} loading="lazy" class="order-2 md:order-1 rounded-2xl h-72 md:h-80 w-full object-cover" />
      : <div class="order-2 md:order-1 rounded-2xl h-72 md:h-80" style="background-image:linear-gradient(160deg,#1e786e,#22a396)"></div>}
    <div class="order-1 md:order-2">
      <h2 class="section-heading">{c(cm, 'about.vision.heading', 'Our Vision')}</h2>
      <p class="mt-4 text-ink/70 leading-relaxed whitespace-pre-line">{c(cm, 'about.vision.p1', 'Our vision is to be the education consultancy Bangladeshi students trust first — recognised not for the loudest marketing, but for consistently getting students into universities that are genuinely right for them.')}</p>
      <p class="mt-4 text-ink/70 leading-relaxed whitespace-pre-line">{c(cm, 'about.vision.p2', "We're working toward a future where every aspiring student, in Dhaka, Sylhet, or beyond, can access the same quality of guidance without traveling far or paying a taka in consultancy fees — with a growing office network and a digital-first application process that removes friction at every step.")}</p>
    </div>
  </div>
</section>

<section class="py-16 text-white text-center" style="background-image:linear-gradient(120deg,#0f1c30,#1c3255 45%,#aa1821)">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="text-xs font-semibold uppercase tracking-widest text-white/70">{c(cm, 'about.band.label', '10,000+ Students Served Since 2019')}</p>
    <h2 class="mt-3 text-2xl md:text-4xl font-extrabold max-w-2xl mx-auto">{c(cm, 'about.band.heading', 'Start Your Journey Today, Achieve More Tomorrow')}</h2>
    <div class="mt-7 flex flex-wrap justify-center gap-4">
      <a href={c(cm, 'about.band.cta1_url', '/blogs')} class="btn-primary nav-link !rounded-lg">{c(cm, 'about.band.cta1_label', 'Read Success Stories')}</a>
      <a href={c(cm, 'about.band.cta2_url', '/contact')} class="btn-secondary nav-link !rounded-lg">{c(cm, 'about.band.cta2_label', 'Contact Us')}</a>
    </div>
  </div>
</section>

{skills.length > 0 && (
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mx-auto">{c(cm, 'about.skills.heading', 'Key Skills and Core Competences Gained')}</h2>
    <p class="mt-3 text-ink/60 text-center max-w-xl mx-auto">{c(cm, 'about.skills.text', 'What students walk away with, beyond just an offer letter.')}</p>
    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
      {skills.map(s => (
        <div class="text-center">
          <div class="w-14 h-14 mx-auto rounded-full bg-white shadow-sm ring-1 ring-black/5 flex items-center justify-center text-sunrise-600 overflow-hidden">
            {iconImage(s.icon)
              ? <img src={iconImage(s.icon)} alt="" loading="lazy" class="w-7 h-7 object-contain" />
              : <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-6 h-6" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={iconPath(s.icon)} />
                </svg>}
          </div>
          <p class="mt-3 text-xs font-semibold text-bridge-900">{s.title}</p>
        </div>
      ))}
    </div>
  </div>
</section>
)}

{reasons.length > 0 && (
<section class="py-16 bg-bridge-50/50">
  <div class="max-w-container mx-auto px-4 md:px-8 text-center">
    <h2 class="section-heading text-center mx-auto">{c(cm, 'about.reasons.heading', 'Six Reasons to Choose Us')}</h2>
    <p class="mt-3 text-ink/60 max-w-xl mx-auto">{c(cm, 'about.reasons.text', "We're committed to supporting you at every step of your journey, from first shortlist to settling in abroad.")}</p>
    <div class="mt-8 max-w-xl mx-auto bg-white rounded-2xl shadow-sm p-8 text-left space-y-4">
      {reasons.map(r => (
        <p class={r.accent ? 'flex items-center gap-3 font-semibold text-bridge-900' : 'flex items-center gap-3 text-ink/80'}>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 text-sunrise-600 shrink-0" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
          {r.title}
        </p>
      ))}
    </div>
  </div>
</section>
)}

{history.length > 0 && (
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mx-auto">{c(cm, 'about.history.heading', 'Our Company History')}</h2>
    {c(cm, 'about.history.text', '') && (
      <p class="mt-3 text-ink/60 text-center max-w-xl mx-auto">{c(cm, 'about.history.text', '')}</p>
    )}

    <div class="mt-12 timeline-wrap max-w-3xl mx-auto">
      <div class="timeline-line"></div>
      {history.map((h, i) => (
        <div class={`relative pl-12 md:pl-0 md:grid md:grid-cols-2 md:gap-10 ${i === history.length - 1 ? '' : 'pb-10'}`}>
          <div class="timeline-dot" style="top:0.4rem"></div>
          {i % 2 === 0 ? (
            <>
              <div class="md:text-right md:pr-2">
                <div class="timeline-card inline-block text-left">
                  <span class="timeline-year">{h.subtitle}</span>
                  <h3 class="font-display font-bold text-bridge-900">{h.title}</h3>
                  <p class="mt-1 text-sm text-ink/60">{h.body}</p>
                </div>
              </div>
              <div class="hidden md:block"></div>
            </>
          ) : (
            <>
              <div class="hidden md:block"></div>
              <div class="md:pl-2">
                <div class="timeline-card inline-block text-left">
                  <span class="timeline-year">{h.subtitle}</span>
                  <h3 class="font-display font-bold text-bridge-900">{h.title}</h3>
                  <p class="mt-1 text-sm text-ink/60">{h.body}</p>
                </div>
              </div>
            </>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
)}

<section class="py-16 bg-bridge-50/50">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="section-heading text-center mx-auto">{c(cm, 'about.team.heading', 'Our Team Members')}</h2>
    <p class="mt-3 text-ink/60 text-center max-w-xl mx-auto">{c(cm, 'about.team.text', 'The counsellors and staff behind every successful application.')}</p>

    <div class="mt-10 flex items-center justify-center gap-3 md:gap-8">
      <button id="aboutTeamPrev" type="button" aria-label="Previous team member" class="shrink-0 w-11 h-11 rounded-full bg-white shadow-md ring-1 ring-black/5 flex items-center justify-center text-sunrise-600 hover:bg-sunrise-50 transition">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5"><path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 010 1.06L9.06 10l3.73 3.71a.75.75 0 11-1.06 1.06l-4.25-4.25a.75.75 0 010-1.06l4.25-4.25a.75.75 0 011.06 0z" clip-rule="evenodd" /></svg>
      </button>
      <div class="max-w-sm w-full">
        <div id="aboutTeamSlider">
        <div class="team-slide active flex-col items-center text-center" data-slide="0">
          <Image src={teamShahan} alt="Mohammed Shahan" class="w-64 h-64 md:w-72 md:h-72 mx-auto rounded-2xl object-cover" widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" />
          <h3 class="mt-4 font-display font-bold text-bridge-900 text-lg">Mohammed Shahan</h3>
          <p class="text-sm text-ink/60">Founder &amp; CEO</p>
        </div>
        <div class="team-slide flex-col items-center text-center" data-slide="1">
          <Image src={teamAriful} alt="Ariful Islam" class="w-64 h-64 md:w-72 md:h-72 mx-auto rounded-2xl object-cover" widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" />
          <h3 class="mt-4 font-display font-bold text-bridge-900 text-lg">Ariful Islam</h3>
          <p class="text-sm text-ink/60">Branch Manager (UK Specialist)</p>
          <p class="text-xs text-ink/40">ID: 102042025</p>
          <a href="/our-team" class="mt-1 text-sm text-sunrise-600 hover:underline nav-link cursor-pointer">UK Branch</a>
        </div>
        <div class="team-slide flex-col items-center text-center" data-slide="2">
          <Image src={teamSunny} alt="Sunny Arafat" class="w-64 h-64 md:w-72 md:h-72 mx-auto rounded-2xl object-cover" widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" />
          <h3 class="mt-4 font-display font-bold text-bridge-900 text-lg">Sunny Arafat</h3>
          <p class="text-sm text-ink/60">Sr. Executive — Digital Marketing</p>
          <p class="text-xs text-ink/40">ID: 52012026</p>
          <a href="/our-team" class="mt-1 text-sm text-sunrise-600 hover:underline nav-link cursor-pointer">Dhaka Branch</a>
        </div>
        <div class="team-slide flex-col items-center text-center" data-slide="3">
          <Image src={teamMehedi} alt="Mehedi Hasan" class="w-64 h-64 md:w-72 md:h-72 mx-auto rounded-2xl object-cover" widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" />
          <h3 class="mt-4 font-display font-bold text-bridge-900 text-lg">Mehedi Hasan</h3>
          <p class="text-sm text-ink/60">Administrative Executive</p>
          <p class="text-xs text-ink/40">ID: 201042025</p>
          <a href="/our-team" class="mt-1 text-sm text-sunrise-600 hover:underline nav-link cursor-pointer">Dhaka Branch</a>
        </div>
        <div class="team-slide flex-col items-center text-center" data-slide="4">
          <Image src={teamMim} alt="Kazi Mim" class="w-64 h-64 md:w-72 md:h-72 mx-auto rounded-2xl object-cover" widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" />
          <h3 class="mt-4 font-display font-bold text-bridge-900 text-lg">Kazi Mim</h3>
          <p class="text-sm text-ink/60">Application Team</p>
          <p class="text-xs text-ink/40">ID: 301042025</p>
          <a href="/our-team" class="mt-1 text-sm text-sunrise-600 hover:underline nav-link cursor-pointer">Dhaka Branch</a>
        </div>
        <div class="team-slide flex-col items-center text-center" data-slide="5">
          <Image src={teamMahi} alt="Mahpara Jahan Mahi" class="w-64 h-64 md:w-72 md:h-72 mx-auto rounded-2xl object-cover" widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" />
          <h3 class="mt-4 font-display font-bold text-bridge-900 text-lg">Mahpara Jahan Mahi</h3>
          <p class="text-sm text-ink/60">Senior Counselor</p>
          <p class="text-xs text-ink/40">ID: 501012026</p>
          <a href="/our-team" class="mt-1 text-sm text-sunrise-600 hover:underline nav-link cursor-pointer">Sylhet Branch</a>
        </div>
        <div class="team-slide flex-col items-center text-center" data-slide="6">
          <div class="w-64 h-64 md:w-72 md:h-72 mx-auto rounded-2xl bg-bridge-50 flex items-center justify-center text-bridge-300"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-20 h-20"><circle cx="12" cy="6.5" r="3.5"/><path d="M9.5 11h5l3.2 9.5a1 1 0 01-.95 1.5H7.25a1 1 0 01-.95-1.5L9.5 11z"/></svg></div>
          <h3 class="mt-4 font-display font-bold text-bridge-900 text-lg">Sharmin Hoque</h3>
          <p class="text-sm text-ink/60">Student Counselor</p>
          <p class="text-xs text-ink/40">ID: 601012026</p>
          <a href="/our-team" class="mt-1 text-sm text-sunrise-600 hover:underline nav-link cursor-pointer">Sylhet Branch</a>
        </div>
        <div class="team-slide flex-col items-center text-center" data-slide="8">
          <div class="w-64 h-64 md:w-72 md:h-72 mx-auto rounded-2xl bg-bridge-50 flex items-center justify-center text-bridge-300"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-20 h-20"><circle cx="12" cy="6.5" r="3.5"/><path d="M9.5 11h5l3.2 9.5a1 1 0 01-.95 1.5H7.25a1 1 0 01-.95-1.5L9.5 11z"/></svg></div>
          <h3 class="mt-4 font-display font-bold text-bridge-900 text-lg">Kaniz Mim</h3>
          <p class="text-sm text-ink/60">Student Counselor</p>
          <p class="text-xs text-ink/40">ID: 720072026</p>
          <a href="/our-team" class="mt-1 text-sm text-sunrise-600 hover:underline nav-link cursor-pointer">Dhaka Branch</a>
        </div>
        <div class="team-slide flex-col items-center text-center" data-slide="10">
          <Image src={teamFahim} alt="Fahim" class="w-64 h-64 md:w-72 md:h-72 mx-auto rounded-2xl object-cover" widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" />
          <h3 class="mt-4 font-display font-bold text-bridge-900 text-lg">Fahim</h3>
          <p class="text-sm text-ink/60">Executive — Operations</p>
          <p class="text-xs text-ink/40">ID: 01012026</p>
          <a href="/our-team" class="mt-1 text-sm text-sunrise-600 hover:underline nav-link cursor-pointer">Sylhet Branch</a>
        </div>
        </div>
        <div id="aboutTeamDots" class="mt-6 flex items-center justify-center gap-2"></div>
      </div>
      <button id="aboutTeamNext" type="button" aria-label="Next team member" class="shrink-0 w-11 h-11 rounded-full bg-white shadow-md ring-1 ring-black/5 flex items-center justify-center text-sunrise-600 hover:bg-sunrise-50 transition">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 010-1.06L10.94 10 7.21 6.29a.75.75 0 111.06-1.06l4.25 4.25a.75.75 0 010 1.06l-4.25 4.25a.75.75 0 01-1.06 0z" clip-rule="evenodd" /></svg>
      </button>
    </div>
    <div class="mt-6 text-center"><a href="/our-team" class="font-semibold text-sunrise-600 hover:underline nav-link cursor-pointer">See the full team &rarr;</a></div>
  </div>
</section>

<section class="py-16 bg-dusk-gradient text-white text-center">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <h2 class="text-2xl md:text-3xl font-extrabold">{c(cm, 'about.cta.heading', 'Ready to start your journey?')}</h2>
    <a href={c(cm, 'about.cta.url', '/contact')} class="btn-primary nav-link mt-6 inline-flex">{c(cm, 'about.cta.label', 'Talk to a Counsellor')}</a>
  </div>
</section>

</Layout>
