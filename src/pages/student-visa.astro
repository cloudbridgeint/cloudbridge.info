---
import Layout from '../layouts/Layout.astro';
import { getAllContent, getPageItemGroups, c } from '../lib/content';

export const prerender = false;

const db = (Astro.locals as any).runtime.env.DB;
const [cm, groups] = await Promise.all([
  getAllContent(db),
  getPageItemGroups(db, ['student-visa.steps']),
]);
const steps = groups['student-visa.steps'];

const title = c(cm, 'student-visa.meta_title', 'Student Visa Support | CloudBridge');
const description = c(cm, 'student-visa.meta_description', 'Step-by-step student visa support for the UK, Malaysia, and USA — documentation, interviews, and approval guidance from CloudBridge.');
---
<Layout title={title} description={description}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / Service / Student Visa</p>
    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">{c(cm, 'student-visa.hero.heading', 'Student Visa Support')}</h1>
    <p class="mt-4 max-w-xl text-white/75">{c(cm, 'student-visa.hero.text', "We prepare your documents, coach you for the interview, and track every deadline — so nothing gets left to chance.")}</p>
  </div>
</section>
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-8">
    {steps.map(s => (
      <div class="rounded-2xl border border-black/10 p-6">
        {s.subtitle && <span class="font-display font-bold text-sunrise-600">{s.subtitle}</span>}
        <h3 class="mt-1 font-display font-bold text-bridge-900">{s.title}</h3>
        <p class="mt-2 text-sm text-ink/60">{s.body}</p>
      </div>
    ))}
  </div>
  <div class="mt-8">
    <a href={c(cm, 'student-visa.cta.url', '/#lead-form')} class="btn-primary nav-link">{c(cm, 'student-visa.cta.label', 'Start your visa process')}</a>
  </div>
</section>

</Layout>
