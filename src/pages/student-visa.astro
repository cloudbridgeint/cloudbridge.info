---
import Layout from '../layouts/Layout.astro';
const title = "Student Visa Support | CloudBridge";
const description = "Step-by-step student visa support for the UK, Malaysia, and USA — documentation, interviews, and approval guidance from CloudBridge.";
---
<Layout title={title} description={description}>

<section class="bg-dusk-gradient text-white py-16">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / Service / Student Visa</p>
    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">Student Visa Support</h1>
    <p class="mt-4 max-w-xl text-white/75">We prepare your documents, coach you for the interview, and track every deadline — so nothing gets left to chance.</p>
  </div>
</section>
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-8">
    <div class="rounded-2xl border border-black/10 p-6"><span class="font-display font-bold text-sunrise-600">Step 1</span><h3 class="mt-1 font-display font-bold text-bridge-900">Document Preparation</h3><p class="mt-2 text-sm text-ink/60">We help you gather and organise financial, academic, and identity documents to the exact requirements of your destination country.</p></div>
    <div class="rounded-2xl border border-black/10 p-6"><span class="font-display font-bold text-sunrise-600">Step 2</span><h3 class="mt-1 font-display font-bold text-bridge-900">Application Filing</h3><p class="mt-2 text-sm text-ink/60">Our team submits your visa application and monitors its progress, flagging any issues before they become delays.</p></div>
    <div class="rounded-2xl border border-black/10 p-6"><span class="font-display font-bold text-sunrise-600">Step 3</span><h3 class="mt-1 font-display font-bold text-bridge-900">Interview Coaching</h3><p class="mt-2 text-sm text-ink/60">Mock interviews and common-question prep so you walk in confident, if your destination requires an interview.</p></div>
    <div class="rounded-2xl border border-black/10 p-6"><span class="font-display font-bold text-sunrise-600">Step 4</span><h3 class="mt-1 font-display font-bold text-bridge-900">Pre-Departure Briefing</h3><p class="mt-2 text-sm text-ink/60">Once your visa is approved, we brief you on travel, accommodation, and what to expect in your first weeks.</p></div>
  </div>
  <div class="mt-8"><a href="/#lead-form" class="btn-primary nav-link">Start your visa process</a></div>
</section>

</Layout>
