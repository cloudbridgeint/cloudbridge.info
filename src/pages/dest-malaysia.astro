---
import Layout from '../layouts/Layout.astro';
const title = "Study in Malaysia | CloudBridge Study Abroad Consultancy";
const description = "Discover universities, courses, and visa requirements to study in Malaysia with guidance from CloudBridge counsellors.";
---
<Layout title={title} description={description}>

<section class="text-white py-20" style="background-image:linear-gradient(160deg,#0f1c30,#1e786e); background-size:cover;">
  <div class="max-w-container mx-auto px-4 md:px-8">
    <p class="crumb"><a href="/">Home</a> / <a href="/destinations">Study Destination</a> / Malaysia</p>
    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold">Study in Malaysia</h1>
    <p class="mt-4 max-w-xl text-white/80">Globally recognized English-medium education with affordable tuition and living costs.</p>
    <a href="/#lead-form" class="btn-primary nav-link mt-8 inline-flex">Book Free Consultation</a>
  </div>
</section>
<section class="py-16">
  <div class="max-w-container mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-10">
    <div>
      <h2 class="font-display text-xl font-bold text-bridge-900">Why study in Malaysia?</h2>
      <ul class="mt-4 space-y-3 text-sm text-ink/70">
        <li>• Lower cost of living than UK, USA, or Australia</li>
        <li>• Branch campuses of respected international universities</li>
        <li>• English-taught programs, no need for a second language</li>
        <li>• Simple, fast student visa process</li>
      </ul>
    </div>
    <div>
      <h2 class="font-display text-xl font-bold text-bridge-900">Popular programs</h2>
      <ul class="mt-4 space-y-3 text-sm text-ink/70">
        <li>• Computer Science & IT</li>
        <li>• Business Administration</li>
        <li>• Hospitality & Tourism Management</li>
        <li>• Engineering (Electrical, Mechanical)</li>
      </ul>
    </div>
  </div>
</section>

</Layout>
