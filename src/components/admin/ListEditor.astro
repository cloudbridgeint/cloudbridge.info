---
/*
 * One repeatable list on an admin screen — the About timeline, the
 * scholarship funding cards, and so on. The markup is a shell; the
 * behaviour lives in /scripts/admin-list-editor.js, which finds every
 * [data-list-editor] on the page and wires it to /api/page-items.
 *
 * The icon and colour choices are passed in from src/lib/icons.ts rather
 * than typed by an editor, so a list can never publish arbitrary SVG.
 */
import { ICONS, ACCENTS } from '../../lib/icons';

export interface Props {
  group: string;
  title: string;
  note?: string;
  /** Which columns this list uses, in display order. */
  fields: string[];
  /** Rename a field for this list, e.g. subtitle -> "Year". */
  labels?: Record<string, string>;
}
const { group, title, note, fields, labels = {} } = Astro.props;
---
<div class="bg-white rounded-2xl ring-1 ring-black/5 shadow-sm p-6"
     data-list-editor
     data-group={group}
     data-fields={fields.join(',')}
     data-labels={JSON.stringify(labels)}
     data-icons={JSON.stringify(ICONS)}
     data-accents={JSON.stringify(ACCENTS)}>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="font-semibold text-slate-900">{title}</h2>
      {note && <p class="text-xs text-slate-400 mt-1 max-w-2xl">{note}</p>}
    </div>
    <button type="button" data-add
            class="shrink-0 rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">
      + Add item
    </button>
  </div>

  <div data-list class="mt-5 space-y-4"><p class="text-sm text-slate-400">Loading…</p></div>

  <div class="mt-5 flex justify-end">
    <button type="button" data-save
            class="rounded-lg bg-bridge-700 hover:bg-bridge-800 text-white text-sm font-semibold px-5 py-2.5 transition">
      Save this list
    </button>
  </div>
</div>
