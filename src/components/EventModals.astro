---
/**
 * Registration + details dialogs shared by the homepage banner and the events
 * page. Both are rendered once per page and populated from the data attributes
 * on whichever button was clicked, so adding an event anywhere on the site
 * needs no extra markup here.
 */
---
<div id="evRegModal" class="ev-modal hidden">
  <div class="ev-modal-box">
    <div class="ev-modal-head">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-sunrise-600">Event registration</p>
        <p id="evRegEventTitle" class="font-display font-bold text-bridge-900 text-lg leading-tight mt-0.5"></p>
        <p id="evRegEventMeta" class="text-sm text-ink/55 mt-0.5"></p>
      </div>
      <button type="button" class="ev-modal-close" data-ev-close aria-label="Close">&times;</button>
    </div>

    <form id="evRegForm" class="ev-modal-body grid gap-4">
      <input type="hidden" id="evRegEventId" value="">
      <div>
        <label class="ev-label">Full name <span class="text-sunrise-600">*</span></label>
        <input name="name" required placeholder="Your full name" class="ev-input">
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="ev-label">Phone (WhatsApp) <span class="text-sunrise-600">*</span></label>
          <input name="phone" required placeholder="+880 1XXXXXXXXX" class="ev-input">
        </div>
        <div>
          <label class="ev-label">Email</label>
          <input name="email" type="email" placeholder="name@email.com" class="ev-input">
        </div>
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="ev-label">City</label>
          <input name="city" placeholder="e.g. Sylhet" class="ev-input">
        </div>
        <div>
          <label class="ev-label">Which branch will you join at? <span class="text-sunrise-600">*</span></label>
          <select name="branch" required class="ev-input">
            <option value="">— Select —</option>
            <option>Dhaka</option>
            <option>Sylhet</option>
            <option>Online</option>
          </select>
        </div>
      </div>

      <p id="evRegError" class="hidden text-sm font-semibold text-sunrise-600"></p>

      <div class="flex items-center justify-end gap-3 pt-2">
        <button type="button" class="ev-btn-ghost" data-ev-close>Cancel</button>
        <button type="submit" id="evRegSubmit" class="btn-primary inline-flex">Confirm Registration</button>
      </div>
    </form>

    <div id="evRegDone" class="hidden ev-modal-body text-center py-10">
      <div class="w-14 h-14 mx-auto rounded-full bg-harbor-500/10 flex items-center justify-center text-harbor-600">
        <svg viewBox="0 0 24 24" class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 13l4 4L19 7"/></svg>
      </div>
      <p class="mt-4 font-display font-bold text-lg text-bridge-900">You're registered!</p>
      <p class="mt-2 text-ink/60 text-sm max-w-sm mx-auto">
        We've saved your seat for <span id="evRegDoneEvent" class="font-semibold text-bridge-900"></span>.
        Our team will contact you with the joining details.
      </p>
      <button type="button" class="btn-primary inline-flex mt-6" data-ev-close>Done</button>
    </div>
  </div>
</div>

<div id="evDetailsModal" class="ev-modal hidden">
  <div class="ev-modal-box">
    <div class="ev-modal-head">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-sunrise-600">Event details</p>
        <p id="evDetTitle" class="font-display font-bold text-bridge-900 text-lg leading-tight mt-0.5"></p>
      </div>
      <button type="button" class="ev-modal-close" data-ev-close aria-label="Close">&times;</button>
    </div>
    <div class="ev-modal-body">
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink/70">
        <span class="inline-flex items-center gap-2">
          <svg viewBox="0 0 24 24" class="w-4 h-4 text-sunrise-600" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
          <span id="evDetDate"></span>
        </span>
        <span id="evDetLocationWrap" class="inline-flex items-center gap-2">
          <svg viewBox="0 0 24 24" class="w-4 h-4 text-sunrise-600" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-5.2 7-10a7 7 0 1 0-14 0c0 4.8 7 10 7 10Z"/><circle cx="12" cy="11" r="2.5"/></svg>
          <span id="evDetLocation"></span>
        </span>
      </div>
      <p id="evDetDesc" class="mt-4 text-ink/70 leading-relaxed whitespace-pre-line"></p>
      <div class="flex items-center justify-end gap-3 pt-6">
        <button type="button" class="ev-btn-ghost" data-ev-close>Close</button>
        <button type="button" id="evDetRegister" class="btn-primary inline-flex">Register Now</button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .ev-modal { position:fixed; inset:0; z-index:130; display:flex; align-items:center; justify-content:center; padding:1.25rem; background:rgba(9,17,30,.72); overflow-y:auto; }
  /* Restated at id+class specificity — a bare id rule would outrank .hidden and
     leave an invisible overlay swallowing clicks on the whole page. */
  .ev-modal.hidden { display:none; }
  .ev-modal-box { background:#fff; border-radius:1rem; width:100%; max-width:34rem; max-height:90vh; overflow-y:auto; box-shadow:0 24px 60px -20px rgba(9,17,30,.5); }
  .ev-modal-head { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; padding:1.15rem 1.4rem; border-bottom:1px solid rgba(0,0,0,.07); }
  .ev-modal-close { flex:none; width:2rem; height:2rem; border-radius:9999px; border:none; background:#f1f2f6; color:#6b7280; font-size:1.25rem; line-height:1; cursor:pointer; transition:.15s; }
  .ev-modal-close:hover { background:#fbe4e4; color:#7a1c22; }
  .ev-modal-body { padding:1.4rem; }
  .ev-label { display:block; font-size:.7rem; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:#374151; margin-bottom:.35rem; }
  .ev-input { width:100%; border-radius:.75rem; border:1px solid rgba(0,0,0,.12); padding:.65rem .9rem; font-size:.875rem; background:#fff; }
  .ev-input:focus { outline:none; border-color:#2f5182; box-shadow:0 0 0 3px rgba(47,81,130,.15); }
  .ev-btn-ghost { border:none; background:#f1f2f6; color:#1c3255; font-weight:600; font-size:.875rem; padding:.6rem 1.1rem; border-radius:.75rem; cursor:pointer; transition:.15s; }
  .ev-btn-ghost:hover { background:#e4e7ee; }
</style>
