---
import logo from '../assets/logo.png';
import logoWhite from '../assets/logo-white.png';
export const prerender = false;
export interface Props {
  title: string;
  active?: string;
}
const { title, active = '' } = Astro.props;

const navItemsMain = [
  { key: 'dashboard', label: 'Dashboard', href: '/cbc-admin', icon: 'M3 3h8v8H3V3zm10 0h8v5h-8V3zM3 13h8v8H3v-8zm10 3h8v5h-8v-5z' },
  { key: 'messages', label: 'Messages', href: '/cbc-admin/messages', icon: 'M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z' },
  { key: 'leads', label: 'Leads', href: '/cbc-admin/leads', icon: 'M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75' },
  { key: 'event-registrations', label: 'Event Registration', href: '/cbc-admin/event-registrations', icon: 'M8 3v4M16 3v4M3 11h18M5 5h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2z' },
  { key: 'applications', label: 'Applications', href: '/cbc-admin/applications', icon: 'M9 12h6m-6 4h6m-7 5h8a2 2 0 002-2V7.5L14.5 3H8a2 2 0 00-2 2v14a2 2 0 002 2z' },
  { key: 'query', label: 'Query', href: '/cbc-admin/query', icon: 'M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-6l-4 4v-4z' },
  { key: 'analytics', label: 'Analytics', href: '/cbc-admin/analytics', icon: 'M3 3v18h18M7 15l4-4 3 3 5-6' },
];

const settingsSubItems = [
  { key: 'homepage', label: 'Homepage', href: '/cbc-admin/homepage', icon: 'M11 4h2a2 2 0 012 2v1H9V6a2 2 0 012-2zM4 9h16v9a2 2 0 01-2 2H6a2 2 0 01-2-2V9zM4 9V7a2 2 0 012-2h1' },
  { key: 'about', label: 'About Page', href: '/cbc-admin/about', icon: 'M12 22a10 10 0 100-20 10 10 0 000 20zm0-14h.01M11 12h1v5h1' },
  { key: 'destinations', label: 'Study Destinations', href: '/cbc-admin/destinations', icon: 'M12 21s7-6.2 7-11a7 7 0 10-14 0c0 4.8 7 11 7 11zm0-8.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5z' },
  { key: 'scholarships', label: 'Scholarships', href: '/cbc-admin/scholarships', icon: 'M12 3l9 4.5-9 4.5-9-4.5L12 3zm-5.5 6.2V15c0 1.4 2.5 3 5.5 3s5.5-1.6 5.5-3V9.2M20 8v6' },
  { key: 'universities', label: 'Featured Universities', href: '/cbc-admin/universities', icon: 'M12 3l9 4.5-9 4.5-9-4.5L12 3zm-7 6.2V15l7 3.5 7-3.5V9.2' },
  { key: 'university-directory', label: 'University & Colleges', href: '/cbc-admin/university-directory', icon: 'M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422A12.083 12.083 0 0121 12c0 3.5-4 6.5-9 6.5S3 15.5 3 12c0-.749.152-1.463.42-2.122L12 14z' },
  { key: 'courses', label: 'Courses', href: '/cbc-admin/courses', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s4.332.477 5.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
  { key: 'blogs', label: 'Blogs', href: '/cbc-admin/blogs', icon: 'M4 4h11a2 2 0 012 2v13a1 1 0 01-1.55.84L11 17l-4.45 2.84A1 1 0 015 19V6a2 2 0 012-2z' },
  { key: 'events', label: 'Events', href: '/cbc-admin/events', icon: 'M8 2v4M16 2v4M3 9h18M5 5h14a1 1 0 011 1v13a1 1 0 01-1 1H5a1 1 0 01-1-1V6a1 1 0 011-1z' },
  { key: 'faq', label: 'FAQ', href: '/cbc-admin/faq', icon: 'M9 9a3 3 0 116 0c0 2-3 2-3 4m.1 4h.01M12 22a10 10 0 100-20 10 10 0 000 20z' },
  { key: 'footer', label: 'Footer', href: '/cbc-admin/footer', icon: 'M4 6h16M4 12h16M4 18h7' },
  { key: 'users', label: 'Users', href: '/cbc-admin/users', icon: 'M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75' },
];
const settingsActive = settingsSubItems.some(i => i.key === active);

/* Editors keep Settings in the sidebar so the panel looks the same for
   everyone, but it is inert: no chevron, no panel, and nothing inside it is
   rendered — so the list of settings screens is not even readable from the
   page source. The middleware blocks the routes regardless; this only stops
   an editor being shown a door that will not open. */
const role = (Astro.locals as any).user?.role === 'editor' ? 'editor' : 'admin';
const canSettings = role === 'admin';

/* The top bar used to show the logo and the word "Admin" for everyone. Look up
   the signed-in account so it shows who is actually logged in. Best effort:
   a database hiccup should not take the whole panel down. */
let me: any = null;
try {
  const db = (Astro.locals as any).runtime?.env?.DB;
  const email = (Astro.locals as any).user?.email;
  if (db && email) {
    me = await db.prepare('SELECT name, username, avatar, role FROM admin_users WHERE email = ?')
      .bind(email).first();
  }
} catch { /* fall back to the generic label below */ }
const meLabel = me?.name || me?.username || (role === 'editor' ? 'Editor' : 'Admin');
const meInitial = String(meLabel).trim().charAt(0).toUpperCase();
import '../styles/admin.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{title} — CloudBridge Admin</title>
  
  <style is:global>
    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    /* This used to be white, which was right for the dark sidebar and invisible
       everywhere else — the content pane is white, so a long page looked like
       it had no scrollbar at all. The sidebar keeps its own rule below. */
    ::-webkit-scrollbar-thumb { background: rgba(15,28,48,0.25); border-radius: 999px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(15,28,48,0.4); }
    ::-webkit-scrollbar-track { background: transparent; }
    .content-scroll { scrollbar-width: thin; scrollbar-color: rgba(15,28,48,0.28) transparent; }
    .toast { animation: slideIn 0.25s ease; }
    @keyframes slideIn { from { transform: translateY(-8px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .app-canvas {
      height: 100vh;
      overflow: hidden;
      position: relative;
      background: #fff;
    }
    .sidebar-solid {
      background: linear-gradient(190deg, #1a2456 0%, #0f1642 55%, #050a31 100%);
    }
    /* #c90f14 is sampled from the logo itself rather than guessed - it is the
       red covering the overwhelming majority of the mark. */
    /* #c90f14 is sampled from the logo. .text-logo-red and .btn-view are plain
       CSS rather than Tailwind classes because they are written inside a JS
       template string, which the Tailwind scanner cannot see. */
    .text-logo-red { color: #c90f14; }
    .btn-view { background: #254368; }
    .btn-view:hover { background: #1c3255; }
    .logout-btn { background: #c90f14; }
    .logout-btn:hover { background: #e01319; }
    .logout-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    /* The sidebar scrollbar sat on a dark panel and read as a bright stripe. */
    .sidebar-scroll::-webkit-scrollbar { width: 6px; }
    .sidebar-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.18); }
    .sidebar-scroll { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.18) transparent; }
    .nav-active { background: #ffffff; color: #0f1642; box-shadow: 0 10px 20px -8px rgba(5,10,49,0.4); }
    .nav-idle { color: rgba(255,255,255,0.78); }
    .nav-idle:hover { background: rgba(255,255,255,0.12); color: #fff; }
    .sub-active { background: rgba(255,255,255,0.16); color: #fff; }
    .card-soft {
      background: linear-gradient(160deg, rgba(255,255,255,0.95), rgba(248,249,255,0.85));
    }
    .badge-purple { background-image: linear-gradient(135deg, #a78bfa, #7c3aed); }
    .badge-pink { background-image: linear-gradient(135deg, #f9a8d4, #db2777); }
    .badge-blue { background-image: linear-gradient(135deg, #60a5fa, #1d4ed8); }
    .badge-teal { background-image: linear-gradient(135deg, #5eead4, #0d9488); }
    .ring-track { stroke: #eef0fb; }

</style>
  <!-- Loaded in <head> so the fetch wrapper is in place before any page
       script can fire an upload. -->
  <script src="/scripts/admin-image.js" is:inline></script>
</head>
<body class="app-canvas">
  <audio id="chatNotifySound" src="/sounds/notify.wav" preload="auto"></audio>
  <div class="relative z-10 h-screen box-border">
    <div class="flex bg-white overflow-hidden h-full">

      <!-- Mobile sidebar backdrop -->
      <div id="mobileSidebarBackdrop" class="hidden fixed inset-0 bg-black/40 z-30 md:hidden"></div>

      <!-- Sidebar -->
      <aside id="sidebar" class="sidebar-solid fixed md:static inset-y-0 left-0 z-40 w-64 md:w-60 shrink-0 flex-col px-4 py-6 overflow-hidden -translate-x-full md:translate-x-0 transition-transform duration-200 flex">
        <!-- Everything above Logout scrolls; the button below sits outside this
             box so it stays put however long the menu gets. min-h-0 is what
             lets a flex child actually shrink and scroll. -->
        <div class="flex-1 min-h-0 overflow-y-auto sidebar-scroll">
        <div class="flex flex-col items-center gap-3 mb-8 pt-2">
          <div class="w-[88px] h-[88px] rounded-2xl border border-white/25 flex items-center justify-center shrink-0">
            <img src={logoWhite.src} alt="CloudBridge" class="w-[72px] h-[72px] rounded-xl object-cover">
          </div>
          <span class="font-semibold text-white/60 text-xs tracking-[0.2em] uppercase">{role === 'editor' ? 'Editor' : 'Admin'}</span>
        </div>

        <nav class="space-y-1">
          {navItemsMain.map(item => (
            <a href={item.href}
               class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition ${active === item.key ? 'nav-active' : 'nav-idle'}`}>
              <svg class="w-[18px] h-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon}/></svg>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="border-t border-white/15 my-4"></div>

        <nav class="space-y-1">
          <button id="settingsToggle" type="button"
             disabled={!canSettings}
             title={canSettings ? undefined : 'Your account does not have access to settings'}
             class={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition ${settingsActive ? 'nav-active' : 'nav-idle'} ${canSettings ? '' : 'opacity-45 cursor-not-allowed'}`}>
            <svg class="w-[18px] h-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><circle cx="12" cy="12" r="3"/></svg>
            <span class="flex-1 text-left">Settings</span>
            {canSettings ? (
              <svg id="settingsChevron" class={`w-4 h-4 transition-transform ${settingsActive ? 'rotate-180' : ''}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            ) : (
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg>
            )}
          </button>
          {canSettings && (
            <div id="settingsPanel" class={`${settingsActive ? '' : 'hidden'} pl-4 space-y-1`}>
              {settingsSubItems.map(item => (
                <a href={item.href}
                   class={`flex items-center gap-3 px-3.5 py-2 rounded-xl text-sm font-medium transition ${active === item.key ? 'sub-active' : 'nav-idle'}`}>
                  <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon}/></svg>
                  {item.label}
                </a>
              ))}
            </div>
          )}
        </nav>

        </div>

        <button id="logoutBtn" class="logout-btn shrink-0 mt-4 flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-semibold text-white transition">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
          Logout
        </button>
      </aside>

      <!-- Main -->
      <main class="flex-1 min-w-0 flex flex-col overflow-hidden bg-white">
        <div id="toastContainer" class="fixed top-4 right-4 z-50 space-y-2"></div>

        <!-- Top bar -->
        <div class="flex items-center gap-3 md:gap-4 px-4 md:px-8 py-4 md:py-5 bg-white border-b border-slate-100 shrink-0">
          <button id="mobileMenuBtn" class="md:hidden w-9 h-9 rounded-full bg-slate-50 flex items-center justify-center text-slate-500 shrink-0">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>

          <div class="relative flex-1 max-w-xs hidden sm:block">
            <input type="text" placeholder="Search"
              class="w-full bg-slate-50 border border-slate-100 rounded-full pl-4 pr-10 py-2.5 text-sm text-slate-700 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-iris-200 transition">
            <svg class="absolute right-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
          </div>

          <div class="flex-1"></div>

          <button class="hidden sm:flex items-center gap-1 px-3 py-2 rounded-full text-xs font-semibold text-slate-500 hover:bg-slate-50 transition">
            ENG
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>

          <a href="/cbc-admin/messages" id="topbarMsgBtn" class="w-9 h-9 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-500 transition relative">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z"/></svg>
            <span id="topbarMsgBadge" class="hidden absolute -top-1 -right-1 min-w-[16px] h-[16px] px-[3px] rounded-full bg-sunrise-600 ring-2 ring-white text-[9px] leading-[16px] text-white text-center font-bold"></span>
          </a>
          <button class="w-9 h-9 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-500 transition relative">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          </button>

          <div class="flex items-center gap-2.5 pl-3 md:pl-4 border-l border-slate-100">
            {me?.avatar ? (
              <img src={me.avatar} alt="" class="w-8 h-8 rounded-full object-cover ring-2 ring-iris-100">
            ) : (
              <span class="w-8 h-8 rounded-full ring-2 ring-iris-100 bg-iris-50 text-iris-700 text-xs font-bold flex items-center justify-center">{meInitial}</span>
            )}
            <span class="text-sm font-semibold text-bridge-950 hidden sm:block">{meLabel}</span>
            <svg class="w-3.5 h-3.5 text-slate-400 hidden sm:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
          </div>
        </div>

        <!-- Page content -->
        <div id="adminContent" class="content-scroll flex-1 overflow-y-auto px-5 md:px-9 py-6 md:py-8">
          <slot />
        </div>
      </main>
    </div>
  </div>

  <script is:inline>
    document.getElementById('settingsToggle')?.addEventListener('click', () => {
      document.getElementById('settingsPanel')?.classList.toggle('hidden');
      document.getElementById('settingsChevron')?.classList.toggle('rotate-180');
    });

    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      await fetch('/api/logout', { method: 'POST' });
      location.href = '/cbc-admin/login';
    });

    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('mobileSidebarBackdrop');
    function openSidebar() {
      sidebar?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('hidden');
    }
    function closeSidebar() {
      sidebar?.classList.add('-translate-x-full');
      backdrop?.classList.add('hidden');
    }
    document.getElementById('mobileMenuBtn')?.addEventListener('click', openSidebar);
    backdrop?.addEventListener('click', closeSidebar);

    function showToast(message, type) {
      type = type || 'success';
      const el = document.createElement('div');
      const colors = { success: 'bg-emerald-600', error: 'bg-red-600' };
      el.className = `toast ${colors[type] || colors.success} text-white text-sm px-4 py-3 rounded-lg shadow-lg`;
      el.textContent = message;
      document.getElementById('toastContainer').appendChild(el);
      setTimeout(() => el.remove(), 3500);
    }
    window.showToast = showToast;

    async function apiFetch(url, options) {
      options = options || {};
      options.headers = Object.assign({ 'Content-Type': 'application/json' }, options.headers || {});
      const res = await fetch(url, options);
      if (res.status === 401) { location.href = '/cbc-admin/login'; throw new Error('Unauthorized'); }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Request failed');
      return data;
    }
    window.apiFetch = apiFetch;

    // Global new-message notification (sound + badge), active on every admin page —
    // works even when this tab isn't focused, as long as the admin panel is open somewhere.
    (function () {
      let lastSeenMsgId = null;
      let audioUnlocked = false;
      const sound = document.getElementById('chatNotifySound');
      const badge = document.getElementById('topbarMsgBadge');

      // Browsers block audio.play() until this page has seen a genuine user gesture —
      // and that "unlocked" state resets on every fresh navigation/login. Prime it on
      // the first interaction of ANY kind on whichever admin page loads.
      function unlockAudio() {
        if (audioUnlocked || !sound) return;
        sound.muted = true;
        sound.play().then(() => {
          sound.pause();
          sound.currentTime = 0;
          sound.muted = false;
          audioUnlocked = true;
        }).catch(() => {
          // Some browsers reject even a muted priming play(); try again on the next gesture.
        });
      }
      ['click', 'keydown', 'mousedown', 'touchstart', 'pointerdown'].forEach(evt =>
        document.addEventListener(evt, unlockAudio, { passive: true })
      );

      function playNotifySound() {
        if (!sound) return;
        try {
          sound.currentTime = 0;
        } catch (e) {}
        sound.play().catch(() => {
          // Autoplay was rejected (no gesture registered yet on this page load).
          // It will start working from the next user interaction onward via unlockAudio().
        });
      }

      async function checkUnread() {
        try {
          const data = await apiFetch('/api/chat/unread');
          if (badge) {
            if (data.unread > 0) {
              badge.textContent = data.unread > 9 ? '9+' : String(data.unread);
              badge.classList.remove('hidden');
            } else {
              badge.classList.add('hidden');
            }
          }
          if (lastSeenMsgId === null) {
            // First check after page load: just record the baseline, don't ding for old messages
            lastSeenMsgId = data.latest_user_message_id;
            return;
          }
          if (data.latest_user_message_id > lastSeenMsgId) {
            lastSeenMsgId = data.latest_user_message_id;
            playNotifySound();
          }
        } catch (err) {
          // best-effort; ignore if not authenticated or offline
        }
      }

      checkUnread();
      setInterval(checkUnread, 6000);
      // Also re-check immediately whenever the tab regains focus/visibility,
      // so a backgrounded tab catches up right away instead of waiting for the next tick.
      document.addEventListener('visibilitychange', () => { if (!document.hidden) checkUnread(); });
    })();
  </script>
</body>
</html>
