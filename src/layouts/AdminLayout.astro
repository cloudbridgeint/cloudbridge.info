---
import logo from '../assets/logo.png';
export const prerender = false;
export interface Props {
  title: string;
  active?: string;
}
const { title, active = '' } = Astro.props;

const navItemsTop = [
  { key: 'dashboard', label: 'Dashboard', href: '/cbc-admin', icon: 'M3 3h8v8H3V3zm10 0h8v5h-8V3zM3 13h8v8H3v-8zm10 3h8v5h-8v-5z' },
  { key: 'analytics', label: 'Analytics', href: '/cbc-admin/analytics', icon: 'M3 3v18h18M7 15l4-4 3 3 5-6' },
  { key: 'homepage', label: 'Homepage', href: '/cbc-admin/homepage', icon: 'M11 4h2a2 2 0 012 2v1H9V6a2 2 0 012-2zM4 9h16v9a2 2 0 01-2 2H6a2 2 0 01-2-2V9zM4 9V7a2 2 0 012-2h1' },
  { key: 'universities', label: 'Universities', href: '/cbc-admin/universities', icon: 'M12 3l9 4.5-9 4.5-9-4.5L12 3zm-7 6.2V15l7 3.5 7-3.5V9.2' },
  { key: 'blogs', label: 'Blogs', href: '/cbc-admin/blogs', icon: 'M4 4h11a2 2 0 012 2v13a1 1 0 01-1.55.84L11 17l-4.45 2.84A1 1 0 015 19V6a2 2 0 012-2z' },
];
const navItemsBottom = [
  { key: 'events', label: 'Events', href: '/cbc-admin/events', icon: 'M8 2v4M16 2v4M3 9h18M5 5h14a1 1 0 011 1v13a1 1 0 01-1 1H5a1 1 0 01-1-1V6a1 1 0 011-1z' },
  { key: 'faq', label: 'FAQ', href: '/cbc-admin/faq', icon: 'M9 9a3 3 0 116 0c0 2-3 2-3 4m.1 4h.01M12 22a10 10 0 100-20 10 10 0 000 20z' },
  { key: 'footer', label: 'Footer', href: '/cbc-admin/footer', icon: 'M4 6h16M4 12h16M4 18h7' },
  { key: 'leads', label: 'Leads', href: '/cbc-admin/leads', icon: 'M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>{title} — CloudBridge Admin</title>
  <script src="https://cdn.tailwindcss.com" is:inline></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            bridge: { 50:'#eef2f9',100:'#dbe6f2',500:'#3d6099',600:'#2f5182',700:'#254368',800:'#1c3255',900:'#15263f',950:'#0f1c30' },
            sunrise: { 50:'#fdeceb', 100:'#ffe6d9',500:'#c0201f',600:'#aa1821',700:'#8f1519' },
          },
        },
      },
    };
  </script>
  <style is:global>
    body { font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    ::-webkit-scrollbar { width: 8px; height: 8px; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.4); border-radius: 999px; }
    .toast { animation: slideIn 0.25s ease; }
    @keyframes slideIn { from { transform: translateY(-8px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

    .app-canvas {
      height: 100vh;
      overflow: hidden;
      position: relative;
      background: linear-gradient(160deg, #1c3255 0%, #2f5182 45%, #3d6099 75%, #6f8fb8 100%);
    }
    .app-canvas::before {
      content: '';
      position: absolute; inset: 0;
      background:
        radial-gradient(45% 40% at 88% 6%, rgba(224,32,38,0.55), transparent 60%),
        radial-gradient(55% 45% at 8% 100%, rgba(15,28,48,0.55), transparent 65%);
      pointer-events: none;
    }
    .nav-active { background-image: linear-gradient(135deg, #254368, #0f1c30); color: #fff; box-shadow: 0 8px 20px -6px rgba(15,28,48,0.5); }
    .badge-navy { background-image: linear-gradient(135deg, #2f5182, #15263f); }
    .badge-red { background-image: linear-gradient(135deg, #e5302e, #8f1519); }
    .badge-slate { background-image: linear-gradient(135deg, #3d6099, #1c3255); }
    .badge-rose { background-image: linear-gradient(135deg, #f2726f, #aa1821); }
  </style>
</head>
<body class="app-canvas">
  <div class="relative z-10 max-w-[1360px] mx-auto p-4 md:p-8 h-screen box-border">
    <div class="flex bg-white/95 backdrop-blur rounded-[28px] shadow-2xl ring-1 ring-black/5 overflow-hidden h-full">

      <!-- Sidebar -->
      <aside class="hidden md:flex w-60 shrink-0 flex-col border-r border-slate-100 px-4 py-6 overflow-y-auto">
        <div class="flex items-center justify-center mb-8">
          <img src={logo.src} alt="CloudBridge" class="w-16 h-16 rounded-xl object-cover">
        </div>

        <nav class="space-y-1">
          {navItemsTop.map(item => (
            <a href={item.href}
               class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition ${active === item.key ? 'nav-active' : 'text-slate-500 hover:bg-bridge-50 hover:text-bridge-900'}`}>
              <svg class="w-[18px] h-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon}/></svg>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="border-t border-slate-100 my-4"></div>

        <nav class="space-y-1">
          {navItemsBottom.map(item => (
            <a href={item.href}
               class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium transition ${active === item.key ? 'nav-active' : 'text-slate-500 hover:bg-bridge-50 hover:text-bridge-900'}`}>
              <svg class="w-[18px] h-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={item.icon}/></svg>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="flex-1"></div>

        <button id="logoutBtn" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-sm font-medium text-slate-500 hover:bg-sunrise-50 hover:text-sunrise-700 transition">
          <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
          Logout
        </button>
      </aside>

      <!-- Main -->
      <main class="flex-1 min-w-0 px-5 md:px-9 py-6 md:py-8 overflow-y-auto">
        <div id="toastContainer" class="fixed top-4 right-4 z-50 space-y-2"></div>

        <!-- Top bar -->
        <div class="flex items-center justify-between mb-8">
          <div>
            <p class="text-bridge-600 text-sm font-medium">Welcome back, Admin!</p>
            <h1 class="text-2xl font-bold text-bridge-950 mt-0.5">{title}</h1>
          </div>
          <div class="flex items-center gap-3">
            <button class="w-9 h-9 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-500 transition">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.35-4.35"/></svg>
            </button>
            <button class="w-9 h-9 rounded-full bg-slate-50 hover:bg-slate-100 flex items-center justify-center text-slate-500 transition relative">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 10-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
            </button>
            <div class="flex items-center gap-2.5 pl-2 border-l border-slate-100">
              <img src={logo.src} alt="" class="w-8 h-8 rounded-full object-cover ring-2 ring-bridge-50">
              <span class="text-sm font-semibold text-bridge-950 hidden sm:block">Admin</span>
            </div>
          </div>
        </div>

        <slot />
      </main>
    </div>
  </div>

  <script is:inline>
    document.getElementById('logoutBtn')?.addEventListener('click', async () => {
      await fetch('/api/logout', { method: 'POST' });
      location.href = '/cbc-admin/login';
    });

    function showToast(message, type) {
      type = type || 'success';
      const el = document.createElement('div');
      const colors = { success: 'bg-emerald-600', error: 'bg-red-600' };
      el.className = `toast ${colors[type] || colors.success} text-white text-sm px-4 py-3 rounded-lg shadow-lg`;
      el.textContent = message;
      document.getElementById('toastContainer').appendChild(el);
      setTimeout(() => el.remove(), 3500);
    }
    window.showToast = showToast;

    async function apiFetch(url, options) {
      options = options || {};
      options.headers = Object.assign({ 'Content-Type': 'application/json' }, options.headers || {});
      const res = await fetch(url, options);
      if (res.status === 401) { location.href = '/cbc-admin/login'; throw new Error('Unauthorized'); }
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Request failed');
      return data;
    }
    window.apiFetch = apiFetch;
  </script>
</body>
</html>
