---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import logoWhite from '../assets/logo-white.png';
import { getAllContent, c } from '../lib/content';

export interface Props {
  title: string;
  description: string;
  /* Extra schema.org nodes for this page, merged into the site-wide @graph. */
  schema?: Record<string, any>[];
  /* Share image for this page. Falls back to the logo when a page has no
     picture of its own. */
  image?: string;
  /* 'article' for anything with an author and a publish date. */
  ogType?: 'website' | 'article';
  /* Trail shown at the top of the page; also emitted as BreadcrumbList so the
     same path can appear under the result in search. Home is added here, so
     pages only pass what comes after it. */
  breadcrumbs?: Array<{ name: string; url: string }>;
  /* Article timestamps, already ISO 8601. */
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
}
const {
  title, description, schema = [], image, ogType = 'website',
  breadcrumbs = [], publishedTime, modifiedTime, section,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

/* Imported as URLs so the build fingerprints them. These were served with a
   four-hour cache, so a change could reach a visitor's markup while their
   browser still held the previous script — which is exactly why the course
   filters kept behaving like the old version after auto-apply shipped. A
   hashed filename cannot go stale. */
import mainScriptUrl from '../scripts/main.js?url';
import applyFormScriptUrl from '../scripts/apply-form.js?url';
import eventsScriptUrl from '../scripts/events.js?url';

/* Which menu entry the page belongs to, so the header can show where you are.
   Matched by prefix, because a country guide, an article and an event all live
   under a menu entry rather than being one: /destinations/study-in-uk belongs
   under Study Destination. Home is an exact match — every path starts with a
   slash. */
const NAV_SECTIONS: Array<{ key: string; paths: string[] }> = [
  { key: 'about', paths: ['/about', '/our-team'] },
  { key: 'university-college', paths: ['/university-college'] },
  { key: 'destinations', paths: ['/destinations'] },
  { key: 'programs', paths: ['/programs'] },
  { key: 'scholarship', paths: ['/scholarship'] },
  { key: 'events', paths: ['/events'] },
  { key: 'apply-now', paths: ['/apply-now'] },
  { key: 'blogs', paths: ['/blogs'] },
  { key: 'contact', paths: ['/contact'] },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navKey = currentPath === '/'
  ? 'home'
  : (NAV_SECTIONS.find(s => s.paths.some(pth => currentPath === pth || currentPath.startsWith(pth + '/')))?.key || '');
const isNav = (key: string) => navKey === key;

const SITE = 'https://cloudbridge.info';
const toAbs = (u: string) => (u.startsWith('http') ? u : new URL(u, SITE).href);
const shareImage = image ? toAbs(image) : `${SITE}/assets/logo.png`;
/* A page with a real picture deserves the large card; the bare logo looks
   better in the small one. */
const twitterCard = image ? 'summary_large_image' : 'summary';

export const prerender = false;
const db = (Astro.locals as any).runtime?.env?.DB;
const cm = db ? await getAllContent(db) : {};

// Log a page view for analytics (best-effort, never blocks or breaks the page)
if (db) {
  try {
    const cf = (Astro.request as any).cf || {};
    const referrer = Astro.request.headers.get('referer') || '';
    const path = Astro.url.pathname;
    (Astro.locals as any).runtime.ctx.waitUntil(
      db.prepare('INSERT INTO visits (path, country, city, referrer) VALUES (?, ?, ?, ?)')
        .bind(path, cf.country || '', cf.city || '', referrer)
        .run()
    );
  } catch {
    // never let analytics logging break the page
  }
}
