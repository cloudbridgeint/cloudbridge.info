     JS only ever changes --x, so the transition is a plain GPU transform. */
  #heroSlider .slider-track { display:grid; }
  #heroSlider .slider-slide {
    grid-area: 1 / 1;
    transform: translateX(var(--x, 100%));
    transition: transform 650ms cubic-bezier(.45,.05,.25,1);
    will-change: transform;
    backface-visibility: hidden;
  }
  /* Set while a slide is repositioned behind the scenes, so the jump back to
