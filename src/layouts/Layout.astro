    <div class="mt-16 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/50">
      <p>© 2026 CloudBridge. All rights reserved.</p>
      <div class="flex flex-wrap gap-3">
        {SOCIALS.map(sn => (
          <a href={sn.url} target="_blank" rel="noopener noreferrer"
             class={`social-chip ${sn.darkMark ? 'social-chip-light' : ''} ${sn.gradient ? 'social-chip-grad' : ''}`}
             style={`--brand:${sn.colour}${sn.gradient ? `;--brand-grad:${sn.gradient}` : ''}`}
             aria-label={`CloudBridge on ${sn.name}`} title={sn.name}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={sn.path} /></svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

