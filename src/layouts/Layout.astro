        <button type="button" class="fab-quick-btn" data-quick="course">🎓 Find a Course/University</button>
        <button type="button" class="fab-quick-btn" data-quick="eligibility">✅ Check My Eligibility</button>
        <button type="button" class="fab-quick-btn" data-quick="scholarship">🏆 Scholarship Information</button>
        <button type="button" class="fab-quick-btn" data-quick="counselor">🧑‍💼 Talk to a Counselor</button>
      </div>
    </div>

    <form id="chatForm" class="flex items-center gap-1.5 px-3 py-3 border-t border-black/5 shrink-0 bg-white">
      <input id="chatFileInput" type="file" class="hidden" accept="image/*,audio/*,.pdf,.doc,.docx">
      <button type="button" id="chatAttachBtn" class="w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:text-bridge-800 hover:bg-slate-100 transition shrink-0" aria-label="Attach a file">
        <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
      </button>
      <button type="button" id="chatMicBtn" class="w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:text-bridge-800 hover:bg-slate-100 transition shrink-0" aria-label="Record a voice message">
        <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8"/></svg>
      </button>
      <input id="chatInput" type="text" placeholder="Write a message…" required
        class="flex-1 min-w-0 rounded-full bg-slate-100 border border-transparent px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-sunrise-300 focus:bg-white transition">
      <button type="submit" class="w-9 h-9 rounded-full flex items-center justify-center text-white shrink-0 transition hover:brightness-110" style="background-image:linear-gradient(90deg,#1c3255 0%,#e12d38 100%)" aria-label="Send">
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"><path d="M3 20l18-8L3 4v6l12 2-12 2z"/></svg>
      </button>
    </form>
  </div>

  <!-- Toggle buttons -->
  <button id="fabCallBtn" type="button" aria-label="Contact options"
    class="w-14 h-14 rounded-full flex items-center justify-center text-white shadow-xl transition hover:scale-105"
    style="background-image:linear-gradient(145deg,#2f5182 0%,#7a1c22 60%,#e12d38 100%)">
    <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
  </button>
  <button id="fabChatBtn" type="button" aria-label="Chat with us"
    class="w-14 h-14 rounded-full flex items-center justify-center text-white shadow-xl transition hover:scale-105"
    style="background-image:linear-gradient(145deg,#1c3255 0%,#0f1c30 100%)">
    <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z"/></svg>
