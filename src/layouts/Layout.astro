/* ---- Structured data ----------------------------------------------------
   Organization + WebSite on every page, so search engines can tie the brand,
   the two offices and the contact details together. Values come from the same
   content keys the footer renders, so editing them in the admin updates both.
   Nothing here is asserted that is not already visible on the site. */
const ORG_ID = 'https://cloudbridge.info/#organization';
const SITE_ID = 'https://cloudbridge.info/#website';

const office = (name: string, street: string, locality: string, postal: string, phone: string) => ({
  '@type': 'Place',
  name,
  address: {
    '@type': 'PostalAddress',
    streetAddress: street,
    addressLocality: locality,
    postalCode: postal,
    addressCountry: 'BD',
  },
  telephone: phone,
});

const dhakaAddr = c(cm, 'footer.address_dhaka', 'Lift 3, House 27, Road 21, Nikunjo-2, Dhaka 1229');
const sylhetAddr = c(cm, 'footer.address_sylhet', '405-406 Manru Shopping City, 4th Floor, Chowhatta, Sylhet 3100');
const dhakaPhone = c(cm, 'footer.phone_dhaka', '+880 1686 007004');
const sylhetPhone = c(cm, 'footer.phone_sylhet', '+880 1619 130469');

const graph: Record<string, any>[] = [
  {
    '@type': ['Organization', 'EducationalOrganization'],
    '@id': ORG_ID,
    name: 'CloudBridge',
    legalName: 'Cloud Bridge — International Student Consultancy',
    alternateName: 'CBC',
    url: 'https://cloudbridge.info/',
    logo: {
      '@type': 'ImageObject',
      url: 'https://cloudbridge.info/assets/logo.png',
    },
    description: c(cm, 'footer.description', 'Your trusted partner for studying abroad — from university shortlisting to visa approval.'),
    email: c(cm, 'footer.email_info', 'info@cloudbridge.info'),
    telephone: dhakaPhone,
    sameAs: SOCIALS.map(x => x.url),
    areaServed: { '@type': 'Country', name: 'Bangladesh' },
    address: {
      '@type': 'PostalAddress',
      streetAddress: dhakaAddr,
      addressLocality: 'Dhaka',
      addressCountry: 'BD',
    },
    location: [
      office('CloudBridge Dhaka', dhakaAddr, 'Dhaka', '1229', dhakaPhone),
      office('CloudBridge Sylhet', sylhetAddr, 'Sylhet', '3100', sylhetPhone),
    ],
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'admissions',
        email: c(cm, 'footer.email_apply', 'apply@cloudbridge.info'),
        telephone: dhakaPhone,
        areaServed: 'BD',
        availableLanguage: ['en', 'bn'],
      },
      {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: c(cm, 'footer.email_info', 'info@cloudbridge.info'),
        telephone: sylhetPhone,
        areaServed: 'BD',
        availableLanguage: ['en', 'bn'],
      },
    ],
  },
  {
    '@type': 'WebSite',
    '@id': SITE_ID,
    url: 'https://cloudbridge.info/',
    name: 'CloudBridge',
    inLanguage: 'en',
    publisher: { '@id': ORG_ID },
  },
  ...(breadcrumbs.length ? [{
    '@type': 'BreadcrumbList',
    '@id': canonicalURL.href + '#breadcrumbs',
    itemListElement: [{ name: 'Home', url: SITE + '/' }, ...breadcrumbs].map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      item: toAbs(b.url),
    })),
  }] : []),
  ...schema,
];

/* set:html does not escape, so close off any "</script>" that could appear in
   admin-entered text. */
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph })
  .replace(/</g, '\\u003c');

import '../styles/site.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="p:domain_verify" content="3697364d62678911807d90d291d235d9"/>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonicalURL}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="CloudBridge">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content={shareImage}>
<meta property="og:image:alt" content={title}>
{ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{ogType === 'article' && section && <meta property="article:section" content={section} />}
<meta name="twitter:card" content={twitterCard}>
<meta name="twitter:image" content={shareImage}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<script type="application/ld+json" is:inline set:html={jsonLd}></script>
<link rel="icon" type="image/png" href="/assets/logo.png">
<link rel="shortcut icon" type="image/png" href="/assets/logo.png">
<link rel="apple-touch-icon" href="/assets/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Lato:wght@400;700;900&display=swap" rel="stylesheet">

<style is:global>
  html { scroll-behavior: smooth; }
  body { font-family: 'Lato', sans-serif; }
  h1,h2,h3,h4,h5,h6,.font-display { font-family: 'Inter', sans-serif; }
  .btn-primary { display:inline-flex; align-items:center; justify-content:center; border-radius:9999px; background:#e12d38; padding:0.75rem 1.5rem; font-weight:600; color:#fff; transition:.15s; cursor:pointer; border:none; }
  .btn-primary:hover { background:#eb7077; }
  .btn-secondary { display:inline-flex; align-items:center; justify-content:center; border-radius:9999px; border:1px solid rgba(255,255,255,.3); padding:0.75rem 1.5rem; font-weight:600; color:#fff; transition:.15s; cursor:pointer; background:transparent; }
  .btn-secondary:hover { background:rgba(255,255,255,.1); }
  .btn-outline { display:inline-flex; align-items:center; justify-content:center; border-radius:9999px; border:1px solid #0f1c30; padding:0.65rem 1.3rem; font-weight:600; color:#0f1c30; transition:.15s; cursor:pointer; background:transparent; font-size:.875rem; }
  .btn-outline:hover { background:#0f1c30; color:#fff; }
  .see-more-btn { -webkit-tap-highlight-color: transparent; }
  .see-more-btn:active, .see-more-btn:focus, .see-more-btn:hover { background-image: linear-gradient(90deg, #1c3255 0%, #1c3255 35%, #e12d38 100%); background-color: transparent; border-color: transparent; color: #fff; }
  .footer-btn-red { display:inline-flex; align-items:center; justify-content:center; background:#c0201f; transition:.15s; cursor:pointer; border:none; }
  .footer-btn-red:hover { background:#a11d1d; }
  .section-heading { font-family:'Times New Roman', Times, serif; font-size:2rem; font-weight:800; letter-spacing:-0.01em; background:linear-gradient(90deg, #050a31 0%, #c90f14 35%, #c90f14 100%); -webkit-background-clip:text; background-clip:text; color:transparent; -webkit-text-fill-color:transparent; width:fit-content; max-width:100%; }
  .section-heading.text-center { margin-left:auto; margin-right:auto; }
  @media (min-width:768px){ .section-heading{ font-size:2.5rem; } }
  .path-line { stroke-dasharray:1000; stroke-dashoffset:1000; animation: draw 2.2s ease-out forwards; }
  @keyframes draw { to { stroke-dashoffset:0; } }
  @keyframes floaty { 0%,100%{ transform:translateY(0);} 50%{ transform:translateY(-8px);} }
  .float-slow { animation: floaty 6s ease-in-out infinite; }
  .card-photo { background-size:cover; background-position:center; }
  :focus-visible { outline: 2px solid #e12d38; outline-offset: 2px; }
  .nav-link { cursor:pointer; }
  header nav.font-display { font-family:'Times New Roman', Times, serif; }
  .nav-link.active { color:#ce1d27 !important; }
  /* The entry for the page you are on. A tint stronger than the hover state,
     so the two are not mistaken for each other, plus the brand red. */
  .nav-current { background:#d7e0ef; color:#ce1d27 !important; font-weight:700; }
  .nav-current:hover { background:#c6d3e8; }
  .mobile-menu-item.nav-current { background:#f9d2d5; color:#ce1d27; }
  .nav-drop-panel .nav-current { background:#eef2f9; }
  .nav-drop { position:relative; }
  .nav-drop-panel { display:none; position:absolute; left:0; top:100%; min-width:190px; background:#fff; border:1px solid rgba(0,0,0,.06); border-radius:.6rem; box-shadow:0 10px 30px rgba(0,0,0,.08); padding:.4rem 0; }
  .nav-drop:hover .nav-drop-panel { display:block; }
  .university-card { transition:.2s; }
  .university-card:hover { transform:translateY(-3px); box-shadow:0 12px 28px rgba(15,28,48,.1); }
  .uni-filter-check { accent-color:#e12d38; width:1rem; height:1rem; cursor:pointer; }
  .uni-filter-check-label { display:flex; align-items:center; gap:.5rem; font-size:.8rem; color:#3d4451; cursor:pointer; }
  .uni-intake-badge { font-size:.65rem; font-weight:600; padding:.2rem .55rem; border-radius:9999px; background:#eef2f9; color:#233f68; }
  .uni-card-btn { border-radius:0.5rem; }
  .uni-card-btn:hover { background:#e12d38 !important; border-color:#e12d38 !important; color:#fff !important; }
  .uni-filter-chip { display:inline-flex; align-items:center; gap:.4rem; background:#0f1c30; color:#fff; font-size:.78rem; font-weight:600; padding:.4rem .5rem .4rem .85rem; border-radius:9999px; }
  .uni-filter-chip button { display:flex; align-items:center; justify-content:center; width:1.1rem; height:1.1rem; border-radius:9999px; background:rgba(255,255,255,.15); cursor:pointer; border:none; color:#fff; flex-shrink:0; }
  .uni-filter-chip button:hover { background:rgba(255,255,255,.3); }
  .course-badge { display:inline-flex; align-items:center; gap:.3rem; font-size:.75rem; font-weight:600; padding:.3rem .65rem; border-radius:9999px; background:#eef2f9; color:#162743; }
