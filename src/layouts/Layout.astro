        <a href="/about" class="nav-link footer-btn-red inline-flex items-center justify-center rounded-full px-6 py-2.5 text-sm font-semibold text-white mt-6">Read More</a>
      </div>

      <div class="text-sm">
        <p class="font-display font-semibold text-white mb-6">Study Destinations</p>
        <p class="mt-4"><a href="/destinations/study-in-uk" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Study in UK</a></p>
