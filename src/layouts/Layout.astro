        <p class="mt-4"><a href="/spouse-visa" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Spouse Visa</a></p>
      </div>

      <div class="text-sm">
        <p class="font-display font-semibold text-white mb-6">Useful Links</p>
        <p class="mt-4"><a href="/" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Home</a></p>
        <p class="mt-4"><a href="/about" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> About Us</a></p>
        <p class="mt-4"><a href="/programs" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Programs</a></p>
        <p class="mt-4"><a href="/blogs" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Blogs</a></p>
        <p class="mt-4"><a href="/contact" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Contact Us</a></p>
      </div>

      <div class="text-sm">
        <p class="font-display font-semibold text-white mb-6">Newsletter</p>
        <p class="text-white/60 mb-5">Sign up for alerts, our latest blogs, thoughts, and insights.</p>
        <form class="demo-form flex flex-col gap-3" data-source="newsletter">
          <input name="email" type="email" required placeholder="Your email address" class="rounded-lg px-4 py-2.5 text-sm text-ink w-full border-none">
