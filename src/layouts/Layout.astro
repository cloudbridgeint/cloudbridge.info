<footer class="text-white/70" style="background-image:radial-gradient(130% 70% at 18% -15%, rgba(255,255,255,0.14), transparent 55%), radial-gradient(90% 60% at 100% 0%, rgba(255,255,255,0.06), transparent 60%), linear-gradient(165deg, #060d1e 0%, #0d1f45 45%, #14316b 100%)">

