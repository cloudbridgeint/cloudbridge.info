      </div>
      <div class="flex items-start gap-4">
        <span class="w-12 h-12 rounded-xl bg-white flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="#a11d1d" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.58 7-12.5A7 7 0 0 0 5 9.5C5 14.42 12 22 12 22Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
        </span>
        <div>
          <p class="font-display font-semibold text-white">Our Address</p>
          <p class="text-sm text-white/90 mt-1"><span class="font-semibold">Dhaka —</span> {c(cm, 'footer.address_dhaka', 'Lift 3, House 27, Road 21, Nikunjo-2, Dhaka 1229')}</p>
          <p class="text-sm text-white/90"><span class="font-semibold">Sylhet —</span> {c(cm, 'footer.address_sylhet', '405-406 Manru Shopping City, 4th Floor, Chowhatta, Sylhet 3100')}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-container mx-auto px-4 md:px-8 pt-20 md:pt-24 pb-16">
    <div class="grid md:grid-cols-4 gap-10 lg:gap-16">
      <div>
        <a href="/" onclick="return spaNav(event,'home')" class="nav-link inline-flex items-center">
          <Image src={logoWhite} alt="CloudBridge — Study Abroad Consultants" class="h-20 md:h-24 w-auto object-contain" widths={[128, 256, 384]} sizes="(min-width: 768px) 96px, 80px" />
        </a>
        <p class="mt-4 max-w-xs text-sm text-white/60">{c(cm, 'footer.description', 'Your trusted partner for studying abroad — from university shortlisting to visa approval.')}</p>
        <a href="/about" onclick="return spaNav(event,'about')" class="nav-link footer-btn-red inline-flex items-center justify-center rounded-full px-6 py-2.5 text-sm font-semibold text-white mt-6">Read More</a>
      </div>

      <div class="text-sm">
        <p class="font-display font-semibold text-white mb-6">Study Destinations</p>
        <p class="mt-4"><a href="/dest-uk" onclick="return spaNav(event,'dest-uk')" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Study in UK</a></p>
        <p class="mt-4"><a href="/dest-usa" onclick="return spaNav(event,'dest-usa')" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Study in USA</a></p>
        <p class="mt-4"><a href="/dest-malaysia" onclick="return spaNav(event,'dest-malaysia')" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Study in Malaysia</a></p>
        <p class="mt-4"><a href="/student-visa" onclick="return spaNav(event,'student-visa')" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Student Visa</a></p>
        <p class="mt-4"><a href="/spouse-visa" onclick="return spaNav(event,'spouse-visa')" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Spouse Visa</a></p>
      </div>

      <div class="text-sm">
        <p class="font-display font-semibold text-white mb-6">Useful Links</p>
        <p class="mt-4"><a href="/" onclick="return spaNav(event,'home')" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Home</a></p>
        <p class="mt-4"><a href="/about" onclick="return spaNav(event,'about')" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> About Us</a></p>
        <p class="mt-4"><a href="/programs" onclick="return spaNav(event,'programs')" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Programs</a></p>
        <p class="mt-4"><a href="/blogs" onclick="return spaNav(event,'blogs')" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Blogs</a></p>
        <p class="mt-4"><a href="/contact" onclick="return spaNav(event,'contact')" class="nav-link hover:text-red-300"><span class="text-red-500">»</span> Contact Us</a></p>
      </div>

      <div class="text-sm">
        <p class="font-display font-semibold text-white mb-6">Newsletter</p>
        <p class="text-white/60 mb-5">Sign up for alerts, our latest blogs, thoughts, and insights.</p>
        <form class="demo-form flex flex-col gap-3" data-source="newsletter">
          <input name="email" type="email" required placeholder="Your email address" class="rounded-lg px-4 py-2.5 text-sm text-ink w-full border-none">
          <button type="submit" class="footer-btn-red w-full !py-2.5 text-sm rounded-full font-semibold">Subscribe Now</button>
        </form>
        <p class="demo-form-thanks hidden text-sm text-harbor-500 mt-2 font-medium">Thanks! You're subscribed. <span class="block text-xs text-white/40 font-normal">(demo only)</span></p>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-white/50">
      <p>© 2026 CloudBridge. All rights reserved.</p>
      <div class="flex gap-3">
        <a href="#" class="w-9 h-9 rounded-full bg-white/10 hover:bg-red-600 hover:text-white flex items-center justify-center transition font-display font-bold text-sm" aria-label="Facebook">f</a>
        <a href="#" class="w-9 h-9 rounded-full bg-white/10 hover:bg-red-600 hover:text-white flex items-center justify-center transition font-display font-bold text-[11px]" aria-label="Instagram">IG</a>
        <a href="#" class="w-9 h-9 rounded-full bg-white/10 hover:bg-red-600 hover:text-white flex items-center justify-center transition font-display font-bold text-[11px]" aria-label="TikTok">TT</a>
      </div>
    </div>
  </div>
</footer>

<!-- Floating contact + chat assistant widget -->
<div id="fabWidget" class="fixed bottom-5 right-5 z-[60] flex flex-col items-end gap-3">

  <!-- Contact options popup (Call / WhatsApp / Email) -->
  <div id="contactPanel" class="hidden w-60 rounded-2xl overflow-hidden shadow-2xl" style="background-image:linear-gradient(160deg,#1c3255 0%,#3a1620 60%,#7a1c22 100%)">
    <div class="p-3 space-y-2">
      <a href="tel:+8801686007004" class="flex items-center gap-3 bg-white/10 hover:bg-white/20 transition rounded-xl px-3 py-2.5">
        <span class="w-9 h-9 rounded-full bg-sky-500 flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        </span>
        <span class="text-white font-semibold text-sm">Call</span>
      </a>
      <a href="https://wa.me/8801686007004" target="_blank" rel="noopener" class="flex items-center gap-3 bg-white/10 hover:bg-white/20 transition rounded-xl px-3 py-2.5">
        <span class="w-9 h-9 rounded-full bg-emerald-500 flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" class="w-4 h-4 text-white" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12.001 2c-5.523 0-10 4.477-10 10 0 1.77.462 3.51 1.34 5.036L2 22l5.11-1.315A9.96 9.96 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a7.95 7.95 0 01-4.06-1.115l-.29-.173-3.03.78.81-2.955-.19-.303A7.95 7.95 0 014 12c0-4.411 3.589-8 8-8s8 3.589 8 8-3.589 8-8 8z"/></svg>
        </span>
        <span class="text-white font-semibold text-sm">WhatsApp</span>
      </a>
      <a href="mailto:support@cloudbridge.info" class="flex items-center gap-3 bg-white/10 hover:bg-white/20 transition rounded-xl px-3 py-2.5">
        <span class="w-9 h-9 rounded-full bg-amber-500 flex items-center justify-center shrink-0">
          <svg viewBox="0 0 24 24" class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 6 8 6 8-6"/></svg>
        </span>
        <span class="text-white font-semibold text-sm">Email</span>
      </a>
    </div>
  </div>

  <!-- Chat assistant popup -->
  <div id="chatPanel" class="hidden w-[360px] sm:w-[400px] h-[540px] max-h-[80vh] rounded-2xl overflow-hidden shadow-2xl bg-white flex flex-col">
    <div class="flex items-center justify-between px-4 py-3.5 border-b border-black/5 shrink-0" style="background-image:linear-gradient(90deg,#1c3255 0%,#1c3255 35%,#e12d38 100%)">
      <div class="flex items-center gap-2.5">
        <Image src={logoWhite} alt="" class="w-7 h-7 object-contain" />
        <p class="font-display font-bold text-white text-sm leading-tight">CloudBridge<br/><span class="font-normal text-white/70 text-[11px]">Virtual Assistant</span></p>
      </div>
      <button id="chatCloseBtn" type="button" class="w-7 h-7 rounded-full bg-white/15 hover:bg-white/25 flex items-center justify-center text-white transition shrink-0" aria-label="Close chat">
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div id="chatMessages" class="flex-1 overflow-y-auto px-4 py-4 space-y-3 bg-slate-50">
      <div class="bg-white rounded-2xl rounded-tl-sm shadow-sm px-4 py-3 text-sm text-bridge-900 max-w-[90%] leading-relaxed">
        Hello, and a warm welcome to CloudBridge! 👋<br><br>
        Think of us as your personal guide on the journey to studying abroad. What's the first question on your mind?
      </div>
      <div class="grid gap-2">
        <button type="button" class="fab-quick-btn" data-quick="course">🎓 Find a Course/University</button>
        <button type="button" class="fab-quick-btn" data-quick="eligibility">✅ Check My Eligibility</button>
        <button type="button" class="fab-quick-btn" data-quick="scholarship">🏆 Scholarship Information</button>
        <button type="button" class="fab-quick-btn" data-quick="counselor">🧑‍💼 Talk to a Counselor</button>
      </div>
    </div>

    <form id="chatForm" class="flex items-center gap-1.5 px-3 py-3 border-t border-black/5 shrink-0 bg-white">
      <input id="chatFileInput" type="file" class="hidden" accept="image/*,audio/*,.pdf,.doc,.docx">
      <button type="button" id="chatAttachBtn" class="w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:text-bridge-800 hover:bg-slate-100 transition shrink-0" aria-label="Attach a file">
        <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
      </button>
      <button type="button" id="chatMicBtn" class="w-8 h-8 rounded-full flex items-center justify-center text-slate-400 hover:text-bridge-800 hover:bg-slate-100 transition shrink-0" aria-label="Record a voice message">
        <svg class="w-[17px] h-[17px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8"/></svg>
      </button>
      <input id="chatInput" type="text" placeholder="Write a message…" required
        class="flex-1 min-w-0 rounded-full bg-slate-100 border border-transparent px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-sunrise-300 focus:bg-white transition">
      <button type="submit" class="w-9 h-9 rounded-full flex items-center justify-center text-white shrink-0 transition hover:brightness-110" style="background-image:linear-gradient(90deg,#1c3255 0%,#e12d38 100%)" aria-label="Send">
        <svg viewBox="0 0 24 24" class="w-4 h-4" fill="currentColor"><path d="M3 20l18-8L3 4v6l12 2-12 2z"/></svg>
      </button>
    </form>
  </div>

  <!-- Toggle buttons -->
  <button id="fabCallBtn" type="button" aria-label="Contact options"
    class="w-14 h-14 rounded-full flex items-center justify-center text-white shadow-xl transition hover:scale-105"
    style="background-image:linear-gradient(145deg,#2f5182 0%,#7a1c22 60%,#e12d38 100%)">
    <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.362 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
  </button>
  <button id="fabChatBtn" type="button" aria-label="Chat with us"
    class="w-14 h-14 rounded-full flex items-center justify-center text-white shadow-xl transition hover:scale-105"
    style="background-image:linear-gradient(145deg,#1c3255 0%,#0f1c30 100%)">
    <svg viewBox="0 0 24 24" class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2v10z"/></svg>
  </button>
</div>

<script src="/scripts/main.js" is:inline></script>
</body>
</html>
