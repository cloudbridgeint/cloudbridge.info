          <p class="text-sm text-white/90"><span class="font-semibold">Sylhet —</span> {c(cm, 'footer.address_sylhet', '405-406 Manru Shopping City, 4th Floor, Chowhatta, Sylhet 3100')}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="max-w-container mx-auto px-4 md:px-8 pt-20 md:pt-24 pb-16">
